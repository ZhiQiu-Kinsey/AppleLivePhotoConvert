  <!-- Core 库现在是 100% 纯托管、零外部包依赖的高性能原生库 -->

  <ItemGroup>
    <InternalsVisibleTo Include="LivePhotoConvert.Core.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Magick.NET-Q8-x64" Version="14.16.0" />
  </ItemGroup>

</Project>
