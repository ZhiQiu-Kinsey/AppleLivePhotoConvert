<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>LivePhotoConvert</AssemblyName>
    <RootNamespace>LivePhotoConvert.Cli</RootNamespace>
    <PublishAot>true</PublishAot>
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>full</TrimMode>
    <ApplicationIcon>LivePhotoConvert.ico</ApplicationIcon>
    <PlatformTarget>x64</PlatformTarget>
    <ProduceReferenceAssembly>False</ProduceReferenceAssembly>
    <Description>动态照片工具箱，支持动态照片的合成与拆分</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\LivePhotoConvert.Core\LivePhotoConvert.Core.csproj" />
    <PackageReference Include="Spectre.Console" Version="0.49.1" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="LivePhotoConvert.ico" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="LivePhotoConvert.Core.Tests" />
  </ItemGroup>

</Project>
