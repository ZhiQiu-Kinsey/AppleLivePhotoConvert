<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dialogs="using:LivePhotoConvert.Desktop.Features.Dialogs"
             x:Class="LivePhotoConvert.Desktop.Controls.CurtainCompareControl"
             x:CompileBindings="True"
             x:DataType="dialogs:StripCompareDialogViewModel"
             xmlns:ic="using:FluentIcons.Avalonia">

  <Border CornerRadius="16" ClipToBounds="True" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1">
    <Grid ClipToBounds="True" MinHeight="300" MaxHeight="520" x:Name="RootGrid" Cursor="SizeWestEast">
      <!-- 生成对比图期间或失败时的说明 -->
      <Border Background="{DynamicResource SurfaceBrush}"
              IsVisible="{CompiledBinding OriginalCompareBitmap, Converter={x:Static ObjectConverters.IsNull}}">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="14">
          <Border Width="56" Height="56" CornerRadius="28" Background="{DynamicResource AccentSoftBrush}" HorizontalAlignment="Center">
            <ic:SymbolIcon Symbol="ArrowBidirectionalLeftRight" FontSize="26" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <TextBlock Text="{CompiledBinding StatusText}" FontSize="12" Foreground="{DynamicResource TextTertiaryBrush}" HorizontalAlignment="Center" TextAlignment="Center" MaxWidth="460" TextWrapping="Wrap"/>
        </StackPanel>
      </Border>

      <!-- 真实覆盖对比图层：底层为瘦身后 HEIC，顶层为原片（Clip 矩形裁切实现精准覆盖对比） -->
      <Panel IsVisible="{CompiledBinding OriginalCompareBitmap, Converter={x:Static ObjectConverters.IsNotNull}}">
        <Panel>
          <!-- 底层：瘦身后图片（Uniform 居中，1:1 像素对齐） -->
          <Image Source="{CompiledBinding StrippedCompareBitmap}" Stretch="Uniform"
                 HorizontalAlignment="Center" VerticalAlignment="Center"
                 IsVisible="{CompiledBinding StrippedCompareBitmap, Converter={x:Static ObjectConverters.IsNotNull}}"/>

          <!-- 底层备用占位 -->
          <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6"
                      IsVisible="{CompiledBinding StrippedCompareBitmap, Converter={x:Static ObjectConverters.IsNull}}">
            <ic:SymbolIcon Symbol="Archive" FontSize="48" Foreground="#6EE7B7"/>
            <TextBlock Text="{DynamicResource CurtainAfterTitle}" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource SuccessBorderBrush}" HorizontalAlignment="Center"/>
            <TextBlock Text="{CompiledBinding AfterSizeText}" Foreground="#D1FAE5" FontSize="11" HorizontalAlignment="Center"/>
          </StackPanel>

          <!-- 右下角角标 -->
          <Border Background="#10B981" CornerRadius="8" Padding="8,4" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="16"
                  IsHitTestVisible="False" BoxShadow="0 2 8 0 #40000000">
            <StackPanel Orientation="Horizontal" Spacing="4">
              <ic:SymbolIcon Symbol="Checkmark" FontSize="12" Foreground="White"/>
              <TextBlock Text="{DynamicResource CurtainAfterBadge}" Foreground="White" FontSize="11" FontWeight="Bold"/>
            </StackPanel>
          </Border>

          <!-- 顶层：原动态照片封面，通过精确 RectangleGeometry Clip 实现覆盖擦除 -->
          <Panel Clip="{CompiledBinding OverlayClipGeometry}">
            <Image Source="{CompiledBinding OriginalCompareBitmap}" Stretch="Uniform"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   IsVisible="{CompiledBinding OriginalCompareBitmap, Converter={x:Static ObjectConverters.IsNotNull}}"/>

            <!-- 左下角角标 -->
            <Border Background="{DynamicResource AccentBrush}" CornerRadius="8" Padding="8,4" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="16"
                    IsHitTestVisible="False" BoxShadow="0 2 8 0 #40000000">
              <TextBlock Text="{DynamicResource CurtainBeforeBadge}" Foreground="White" FontSize="11" FontWeight="Bold"/>
            </Border>
          </Panel>
        </Panel>

      <!-- 拖拽中轴线（高度紧贴照片有效渲染高度） -->
      <Rectangle Width="2" Fill="White" HorizontalAlignment="Left" VerticalAlignment="Top"
                 Height="{CompiledBinding DividerHeight}"
                 Margin="{CompiledBinding DividerMargin}" IsHitTestVisible="False"/>

      <!-- 拖拽手柄（垂直居中于照片） -->
      <Border Width="34" Height="34" CornerRadius="17" Background="White"
              BoxShadow="0 4 14 0 #60000000"
              HorizontalAlignment="Left" VerticalAlignment="Top"
              Margin="{CompiledBinding ThumbMargin}"
              IsHitTestVisible="False">
        <ic:SymbolIcon Symbol="ArrowBidirectionalLeftRight" FontSize="16" Foreground="#1E293B" HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Border>
    </Panel>
  </Grid>
</Border>
</UserControl>
