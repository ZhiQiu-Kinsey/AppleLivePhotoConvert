<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:library="using:LivePhotoConvert.Desktop.Features.Library"
             x:Class="LivePhotoConvert.Desktop.Controls.CompactToolbar"
             x:CompileBindings="True"
             x:DataType="library:LibraryViewModel"
        xmlns:conv="using:LivePhotoConvert.Desktop.Converters"
        xmlns:ic="using:FluentIcons.Avalonia">

  <Border x:Name="RootBar" Height="32" Padding="4,0">
    <Grid ColumnDefinitions="Auto,*,Auto">
      <!-- 左侧相册标题与选中状态 -->
      <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Spacing="8"
                  IsVisible="{Binding #RootBar.Bounds.Width, Converter={x:Static conv:MinWidthToBoolConverter.Instance}, ConverterParameter=680}">
        <TextBlock Text="{DynamicResource ToolbarAlbumTitle}" FontWeight="Bold" FontSize="13" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}" />
        <Border Width="1" Height="12" Background="{DynamicResource LineStrongBrush}" VerticalAlignment="Center" />
        <TextBlock Text="{Binding Selection.SelectedSummaryText}" FontSize="12" Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center" />
      </StackPanel>

      <!-- 右侧精简工具栏 -->
      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">

        <!-- 0. [Folder] Direct 1-click select album folder button -->
        <Button Classes="toolbar-btn"
                Command="{Binding SelectAlbumFolderCommand}"
                ToolTip.Tip="{Binding SelectAlbumFolderBtnText}">
          <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
            <ic:SymbolIcon Symbol="FolderOpen" FontSize="14" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,1,0,0"/>
            <TextBlock Text="{Binding SelectAlbumFolderBtnText}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"
                       IsVisible="{Binding #RootBar.Bounds.Width, Converter={x:Static conv:MinWidthToBoolConverter.Instance}, ConverterParameter=460}" />
          </StackPanel>
        </Button>

        <!-- Action button -->
        <Button Classes="toolbar-btn" ToolTip.Tip="{DynamicResource ToolbarSortTip}">
          <Button.Flyout>
            <Flyout Placement="BottomEdgeAlignedRight">
              <StackPanel Spacing="2" MinWidth="170">
                <!-- Button: SetSortModeCommand -->
                <Button Classes="nav-btn" Command="{Binding Layout.SetSortModeCommand}" CommandParameter="DateTaken" HorizontalAlignment="Stretch">
                  <Grid ColumnDefinitions="20,20,*">
                    <TextBlock Grid.Column="0" Text="•" FontSize="12" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"
                               IsVisible="{Binding Layout.SortMode, Converter={x:Static conv:EqualityConverter.Instance}, ConverterParameter=DateTaken}"/>
                    <ic:SymbolIcon Symbol="Calendar" FontSize="12" Grid.Column="1" Foreground="{DynamicResource TextTertiaryBrush}"/>
                    <TextBlock Grid.Column="2" Text="{DynamicResource SortDateTaken}" FontSize="12" Margin="6,0,0,0" VerticalAlignment="Center" />
                  </Grid>
                </Button>
                <Button Classes="nav-btn" Command="{Binding Layout.SetSortModeCommand}" CommandParameter="DateCreated" HorizontalAlignment="Stretch">
                  <Grid ColumnDefinitions="20,20,*">
                    <TextBlock Grid.Column="0" Text="•" FontSize="12" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"
                               IsVisible="{Binding Layout.SortMode, Converter={x:Static conv:EqualityConverter.Instance}, ConverterParameter=DateCreated}"/>
                    <ic:SymbolIcon Symbol="Clock" FontSize="12" Grid.Column="1" Foreground="{DynamicResource TextTertiaryBrush}"/>
                    <TextBlock Grid.Column="2" Text="{DynamicResource SortDateCreated}" FontSize="12" Margin="6,0,0,0" VerticalAlignment="Center" />
                  </Grid>
                </Button>
                <Button Classes="nav-btn" Command="{Binding Layout.SetSortModeCommand}" CommandParameter="DateModified" HorizontalAlignment="Stretch">
                  <Grid ColumnDefinitions="20,20,*">
                    <TextBlock Grid.Column="0" Text="•" FontSize="12" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"
                               IsVisible="{Binding Layout.SortMode, Converter={x:Static conv:EqualityConverter.Instance}, ConverterParameter=DateModified}"/>
                    <ic:SymbolIcon Symbol="Calendar" FontSize="12" Grid.Column="1" Foreground="{DynamicResource TextTertiaryBrush}"/>
                    <TextBlock Grid.Column="2" Text="{DynamicResource SortDateModified}" FontSize="12" Margin="6,0,0,0" VerticalAlignment="Center" />
                  </Grid>
                </Button>
                <Button Classes="nav-btn" Command="{Binding Layout.SetSortModeCommand}" CommandParameter="Name" HorizontalAlignment="Stretch">
                  <Grid ColumnDefinitions="20,20,*">
                    <TextBlock Grid.Column="0" Text="•" FontSize="12" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"
                               IsVisible="{Binding Layout.SortMode, Converter={x:Static conv:EqualityConverter.Instance}, ConverterParameter=Name}"/>
                    <ic:SymbolIcon Symbol="Document" FontSize="12" Grid.Column="1" Foreground="{DynamicResource TextTertiaryBrush}"/>
                    <TextBlock Grid.Column="2" Text="{DynamicResource SortName}" FontSize="12" Margin="6,0,0,0" VerticalAlignment="Center" />
                  </Grid>
                </Button>

                <Border Height="1" Background="{DynamicResource LineBrush}" Margin="4,3" />

                <!-- 排序方向 -->
                <Button Classes="nav-btn" Command="{Binding Layout.SetSortDirectionCommand}" CommandParameter="{x:True}" HorizontalAlignment="Stretch">
                  <Grid ColumnDefinitions="20,20,*">
                    <TextBlock Grid.Column="0" Text="•" FontSize="12" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" IsVisible="{Binding Layout.IsSortAscending}"/>
                    <ic:SymbolIcon Symbol="ArrowSortUp" FontSize="12" Grid.Column="1" Foreground="{DynamicResource TextTertiaryBrush}"/>
                    <TextBlock Grid.Column="2" Text="{DynamicResource SortAsc}" FontSize="12" Margin="6,0,0,0" VerticalAlignment="Center" />
                  </Grid>
                </Button>
                <Button Classes="nav-btn" Command="{Binding Layout.SetSortDirectionCommand}" CommandParameter="{x:False}" HorizontalAlignment="Stretch">
                  <Grid ColumnDefinitions="20,20,*">
                    <TextBlock Grid.Column="0" Text="•" FontSize="12" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" IsVisible="{Binding !Layout.IsSortAscending}"/>
                    <ic:SymbolIcon Symbol="ArrowSortDown" FontSize="12" Grid.Column="1" Foreground="{DynamicResource TextTertiaryBrush}"/>
                    <TextBlock Grid.Column="2" Text="{DynamicResource SortDesc}" FontSize="12" Margin="6,0,0,0" VerticalAlignment="Center" />
                  </Grid>
                </Button>
              </StackPanel>
            </Flyout>
          </Button.Flyout>
          <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
            <ic:SymbolIcon Symbol="ArrowSortUp" FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,1,0,0"/>
            <ic:SymbolIcon Symbol="ChevronDown" FontSize="10" Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>

        <!-- Action button -->
        <Button Classes="toolbar-btn" ToolTip.Tip="{DynamicResource ToolbarFilterTip}">
          <Button.Flyout>
            <Flyout Placement="BottomEdgeAlignedRight">
              <StackPanel Spacing="2" MinWidth="170">
                <Button Classes="nav-btn" Command="{Binding SetFilterModeCommand}" CommandParameter="All" HorizontalAlignment="Stretch">
                  <Grid ColumnDefinitions="20,*">
                    <ic:SymbolIcon Symbol="Checkmark" FontSize="12" Grid.Column="0" Foreground="{DynamicResource AccentBrush}"/>
                    <TextBlock Grid.Column="1" Text="{Binding Selection.FilterAllText}" FontSize="12" Margin="4,0,0,0" VerticalAlignment="Center" />
                  </Grid>
                </Button>
                <Button Classes="nav-btn" Command="{Binding SetFilterModeCommand}" CommandParameter="SuspiciousOnly" HorizontalAlignment="Stretch">
                  <Grid ColumnDefinitions="20,*">
                    <ic:SymbolIcon Symbol="Warning" FontSize="12" Grid.Column="0" Foreground="{DynamicResource WarningBrush}"/>
                    <TextBlock Grid.Column="1" Text="{Binding Selection.FilterSuspiciousText}" FontSize="12" Margin="4,0,0,0" VerticalAlignment="Center" />
                  </Grid>
                </Button>
                <Button Classes="nav-btn" Command="{Binding SetFilterModeCommand}" CommandParameter="SelectedOnly" HorizontalAlignment="Stretch">
                  <Grid ColumnDefinitions="20,*">
                    <ic:SymbolIcon Symbol="CheckmarkCircle" FontSize="12" Grid.Column="0" Foreground="{DynamicResource SuccessBrush}"/>
                    <TextBlock Grid.Column="1" Text="{DynamicResource FilterSelected}" FontSize="12" Margin="4,0,0,0" VerticalAlignment="Center" />
                  </Grid>
                </Button>
              </StackPanel>
            </Flyout>
          </Button.Flyout>
          <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
            <ic:SymbolIcon Symbol="Filter" FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,1,0,0"/>
            <ic:SymbolIcon Symbol="ChevronDown" FontSize="10" Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>

        <!-- 5. 视图与分组配置 -->
        <Button Classes="toolbar-btn" ToolTip.Tip="{DynamicResource ToolbarViewTip}">
          <Button.Flyout>
            <Flyout Placement="BottomEdgeAlignedRight">
              <StackPanel Spacing="2" MinWidth="220">
                <!-- Section 1: Crop (dot indicates current selection per prototype) -->
                <Button Classes="nav-btn" Command="{Binding Layout.SetCropModeCommand}" CommandParameter="Natural" HorizontalAlignment="Stretch">
                  <Grid ColumnDefinitions="12,20,*">
                    <TextBlock Grid.Column="0" Text="•" FontSize="12" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"
                               IsVisible="{Binding Layout.CropMode, Converter={x:Static conv:EqualityConverter.Instance}, ConverterParameter=Natural}"/>
                    <ic:SymbolIcon Symbol="Apps" FontSize="12" Grid.Column="1" Foreground="{DynamicResource TextTertiaryBrush}"/>
                    <TextBlock Grid.Column="2" Text="{DynamicResource CropNatural}" FontSize="12" Margin="6,0,0,0" VerticalAlignment="Center" />
                  </Grid>
                </Button>
                <Button Classes="nav-btn" Command="{Binding Layout.SetCropModeCommand}" CommandParameter="Square" HorizontalAlignment="Stretch">
                  <Grid ColumnDefinitions="12,20,*">
                    <TextBlock Grid.Column="0" Text="•" FontSize="12" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"
                               IsVisible="{Binding Layout.CropMode, Converter={x:Static conv:EqualityConverter.Instance}, ConverterParameter=Square}"/>
                    <ic:SymbolIcon Symbol="Resize" FontSize="12" Grid.Column="1" Foreground="{DynamicResource TextTertiaryBrush}"/>
                    <TextBlock Grid.Column="2" Text="{DynamicResource CropSquare}" FontSize="12" Margin="6,0,0,0" VerticalAlignment="Center" />
                  </Grid>
                </Button>

                <Border Height="1" Background="{DynamicResource LineBrush}" Margin="4,3" />

                <!-- Section 2: Scale -->
                <Button Classes="nav-btn" Command="{Binding Layout.SetScaleModeCommand}" CommandParameter="Small" HorizontalAlignment="Stretch">
                  <Grid ColumnDefinitions="12,20,*">
                    <TextBlock Grid.Column="0" Text="•" FontSize="12" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"
                               IsVisible="{Binding Layout.ScaleMode, Converter={x:Static conv:EqualityConverter.Instance}, ConverterParameter=Small}"/>
                    <ic:SymbolIcon Symbol="ResizeSmall" FontSize="12" Grid.Column="1" Foreground="{DynamicResource TextTertiaryBrush}"/>
                    <TextBlock Grid.Column="2" Text="{DynamicResource ScaleSmall}" FontSize="12" Margin="6,0,0,0" VerticalAlignment="Center" />
                  </Grid>
                </Button>
                <Button Classes="nav-btn" Command="{Binding Layout.SetScaleModeCommand}" CommandParameter="Medium" HorizontalAlignment="Stretch">
                  <Grid ColumnDefinitions="12,20,*">
                    <TextBlock Grid.Column="0" Text="•" FontSize="12" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"
                               IsVisible="{Binding Layout.ScaleMode, Converter={x:Static conv:EqualityConverter.Instance}, ConverterParameter=Medium}"/>
                    <ic:SymbolIcon Symbol="Resize" FontSize="12" Grid.Column="1" Foreground="{DynamicResource TextTertiaryBrush}"/>
                    <TextBlock Grid.Column="2" Text="{DynamicResource ScaleMedium}" FontSize="12" Margin="6,0,0,0" VerticalAlignment="Center" />
                  </Grid>
                </Button>
                <Button Classes="nav-btn" Command="{Binding Layout.SetScaleModeCommand}" CommandParameter="Large" HorizontalAlignment="Stretch">
                  <Grid ColumnDefinitions="12,20,*">
                    <TextBlock Grid.Column="0" Text="•" FontSize="12" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"
                               IsVisible="{Binding Layout.ScaleMode, Converter={x:Static conv:EqualityConverter.Instance}, ConverterParameter=Large}"/>
                    <ic:SymbolIcon Symbol="ResizeLarge" FontSize="12" Grid.Column="1" Foreground="{DynamicResource TextTertiaryBrush}"/>
                    <TextBlock Grid.Column="2" Text="{DynamicResource ScaleLarge}" FontSize="12" Margin="6,0,0,0" VerticalAlignment="Center" />
                  </Grid>
                </Button>

                <Border Height="1" Background="{DynamicResource LineBrush}" Margin="4,3" />

                <!-- Section 3: Grouping -->
                <Button Classes="nav-btn" Command="{Binding Layout.SetGroupingModeCommand}" CommandParameter="Date" HorizontalAlignment="Stretch">
                  <Grid ColumnDefinitions="12,20,*">
                    <TextBlock Grid.Column="0" Text="•" FontSize="12" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"
                               IsVisible="{Binding Layout.GroupingMode, Converter={x:Static conv:EqualityConverter.Instance}, ConverterParameter=Date}"/>
                    <ic:SymbolIcon Symbol="Calendar" FontSize="12" Grid.Column="1" Foreground="{DynamicResource TextTertiaryBrush}"/>
                    <TextBlock Grid.Column="2" Text="{DynamicResource GroupDate}" FontSize="12" Margin="6,0,0,0" VerticalAlignment="Center" />
                  </Grid>
                </Button>
                <Button Classes="nav-btn" Command="{Binding Layout.SetGroupingModeCommand}" CommandParameter="Month" HorizontalAlignment="Stretch">
                  <Grid ColumnDefinitions="12,20,*">
                    <TextBlock Grid.Column="0" Text="•" FontSize="12" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"
                               IsVisible="{Binding Layout.GroupingMode, Converter={x:Static conv:EqualityConverter.Instance}, ConverterParameter=Month}"/>
                    <ic:SymbolIcon Symbol="CalendarMonth" FontSize="12" Grid.Column="1" Foreground="{DynamicResource TextTertiaryBrush}"/>
                    <TextBlock Grid.Column="2" Text="{DynamicResource GroupMonth}" FontSize="12" Margin="6,0,0,0" VerticalAlignment="Center" />
                  </Grid>
                </Button>
                <Button Classes="nav-btn" Command="{Binding Layout.SetGroupingModeCommand}" CommandParameter="Year" HorizontalAlignment="Stretch">
                  <Grid ColumnDefinitions="12,20,*">
                    <TextBlock Grid.Column="0" Text="•" FontSize="12" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"
                               IsVisible="{Binding Layout.GroupingMode, Converter={x:Static conv:EqualityConverter.Instance}, ConverterParameter=Year}"/>
                    <ic:SymbolIcon Symbol="CalendarAgenda" FontSize="12" Grid.Column="1" Foreground="{DynamicResource TextTertiaryBrush}"/>
                    <TextBlock Grid.Column="2" Text="{DynamicResource GroupYear}" FontSize="12" Margin="6,0,0,0" VerticalAlignment="Center" />
                  </Grid>
                </Button>
                <Button Classes="nav-btn" Command="{Binding Layout.SetGroupingModeCommand}" CommandParameter="None" HorizontalAlignment="Stretch">
                  <Grid ColumnDefinitions="12,20,*">
                    <TextBlock Grid.Column="0" Text="•" FontSize="12" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"
                               IsVisible="{Binding Layout.GroupingMode, Converter={x:Static conv:EqualityConverter.Instance}, ConverterParameter=None}"/>
                    <ic:SymbolIcon Symbol="List" FontSize="12" Grid.Column="1" Foreground="{DynamicResource TextTertiaryBrush}"/>
                    <TextBlock Grid.Column="2" Text="{DynamicResource GroupNone}" FontSize="12" Margin="6,0,0,0" VerticalAlignment="Center" />
                  </Grid>
                </Button>
              </StackPanel>
            </Flyout>
          </Button.Flyout>
          <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
            <ic:SymbolIcon Symbol="Apps" FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,1,0,0"/>
            <ic:SymbolIcon Symbol="ChevronDown" FontSize="10" Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>

        <!-- Action button -->
        <Button Classes="toolbar-btn" Width="32" Height="32" Padding="0" ToolTip.Tip="{DynamicResource ToolbarMoreTip}">
          <Button.Flyout>
            <Flyout Placement="BottomEdgeAlignedRight">
              <StackPanel Spacing="2" MinWidth="180">
                <Button Classes="nav-btn" Command="{Binding SelectAllVisibleCommand}" CommandParameter="{x:True}" HorizontalAlignment="Stretch">
                  <Grid ColumnDefinitions="20,*">
                    <ic:SymbolIcon Symbol="SelectAllOn" FontSize="12" Grid.Column="0" Foreground="{DynamicResource TextTertiaryBrush}"/>
                    <TextBlock Grid.Column="1" Text="{DynamicResource SelectAll}" FontSize="12" Margin="6,0,0,0" VerticalAlignment="Center" />
                  </Grid>
                </Button>
                <Button Classes="nav-btn" Command="{Binding SelectAllVisibleCommand}" CommandParameter="{x:False}" HorizontalAlignment="Stretch">
                  <Grid ColumnDefinitions="20,*">
                    <ic:SymbolIcon Symbol="CheckboxUnchecked" FontSize="12" Grid.Column="0" Foreground="{DynamicResource TextTertiaryBrush}"/>
                    <TextBlock Grid.Column="1" Text="{DynamicResource DeselectAll}" FontSize="12" Margin="6,0,0,0" VerticalAlignment="Center" />
                  </Grid>
                </Button>

                <Border Height="1" Background="{DynamicResource LineBrush}" Margin="4,3" />

                <Button Classes="nav-btn" Command="{Binding ToggleAllCollapseCommand}" HorizontalAlignment="Stretch">
                  <Grid ColumnDefinitions="20,*">
                    <ic:SymbolIcon Symbol="ChevronDown" FontSize="12" Grid.Column="0" Foreground="{DynamicResource TextTertiaryBrush}"/>
                    <TextBlock Grid.Column="1" Text="{DynamicResource ToggleAllCollapse}" FontSize="12" Margin="6,0,0,0" VerticalAlignment="Center" />
                  </Grid>
                </Button>
                <Button Classes="nav-btn" Command="{Binding RescanAlbumCommand}" HorizontalAlignment="Stretch">
                  <Grid ColumnDefinitions="20,*">
                    <ic:SymbolIcon Symbol="ArrowSync" FontSize="12" Grid.Column="0" Foreground="{DynamicResource TextTertiaryBrush}"/>
                    <TextBlock Grid.Column="1" Text="{DynamicResource RefreshAlbum}" FontSize="12" Margin="6,0,0,0" VerticalAlignment="Center" />
                  </Grid>
                </Button>
              </StackPanel>
            </Flyout>
          </Button.Flyout>
          <ic:SymbolIcon Symbol="MoreHorizontal" FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Button>

      </StackPanel>
    </Grid>
  </Border>
</UserControl>
