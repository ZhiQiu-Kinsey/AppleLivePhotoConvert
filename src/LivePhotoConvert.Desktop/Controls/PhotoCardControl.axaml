<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="using:LivePhotoConvert.Desktop.Models"
             xmlns:thumbs="using:LivePhotoConvert.Desktop.Features.Library.Thumbnails"
             x:Class="LivePhotoConvert.Desktop.Controls.PhotoCardControl"
             x:CompileBindings="True"
             x:DataType="models:PhotoCardItemViewModel"
        xmlns:ic="using:FluentIcons.Avalonia">

  <Border Background="{DynamicResource SurfaceBrush}"
          CornerRadius="16"
          ClipToBounds="True"
          Margin="{x:Static thumbs:GalleryMetrics.CardMarginThickness}"
          BoxShadow="0 2 8 0 #10000000">

    <Grid RowDefinitions="Auto,Auto">
      <!-- 使用行布局预先算出的统一高度，缩略图异步到达时不会改变当前测量 -->
      <Panel Grid.Row="0" Height="{CompiledBinding PreviewHeight}" ClipToBounds="True">
        <!-- 圆角裁剪容器 -->
        <Border CornerRadius="16,16,0,0" ClipToBounds="True">
          <Panel>
            <!-- 自适应等高模式下容器保持原图比例；方形模式下同一视口负责居中裁切 -->
            <Image Source="{CompiledBinding DisplayImage}"
                   RenderOptions.BitmapInterpolationMode="HighQuality"
                   Stretch="UniformToFill"
                   HorizontalAlignment="Stretch"
                   VerticalAlignment="Center" />

            <!-- 缩略图未就绪时的占位底色 -->
            <Border Background="{DynamicResource CanvasBrush}"
                    IsVisible="{CompiledBinding DisplayImage, Converter={x:Static ObjectConverters.IsNull}}">
              <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6" Margin="0,30">
                <ic:SymbolIcon Symbol="Camera" FontSize="32" Foreground="{DynamicResource TextTertiaryBrush}"/>
                <TextBlock Text="{CompiledBinding FileName}" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="160" />
              </StackPanel>
            </Border>
          </Panel>
        </Border>

        <!-- 实况徽章 -->
        <Border Background="#80000000" CornerRadius="12" Padding="8,4"
                HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8"
                IsVisible="{CompiledBinding !HasSuspiciousWarning}">
          <StackPanel Orientation="Horizontal" Spacing="4">
            <ic:SymbolIcon Symbol="Live" FontSize="12" Foreground="#38BDF8"/>
            <TextBlock Text="{DynamicResource CardLiveBadge}" Foreground="{DynamicResource OnAccentBrush}" FontSize="10" FontWeight="Bold" />
          </StackPanel>
        </Border>

        <!-- 警示徽章 -->
        <Border Background="{DynamicResource WarningBrush}" CornerRadius="12" Padding="8,4"
                HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8"
                IsVisible="{CompiledBinding HasSuspiciousWarning}">
          <StackPanel Orientation="Horizontal" Spacing="4">
            <ic:SymbolIcon Symbol="Warning" FontSize="12" Foreground="{DynamicResource OnAccentBrush}"/>
            <TextBlock Text="{DynamicResource CardTimeMismatch}" Foreground="{DynamicResource OnAccentBrush}" FontSize="10" FontWeight="Bold" />
          </StackPanel>
        </Border>

        <!-- 时长角标 -->
        <Border Background="#99000000" CornerRadius="6" Padding="6,2"
                HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="8">
          <TextBlock Text="{DynamicResource CardDurationLive}" Foreground="{DynamicResource OnAccentBrush}" FontSize="10" FontWeight="SemiBold" />
        </Border>

      </Panel>

      <!-- 信息面板固定高度，保证同一行的卡片底部对齐 -->
      <Border Grid.Row="1" Height="{x:Static thumbs:GalleryMetrics.InfoBarHeight}" Padding="12,10" Background="{DynamicResource SurfaceBrush}">
        <StackPanel Spacing="6">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Grid.Column="0" Spacing="2">
              <TextBlock Text="{CompiledBinding FileName}" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
              <TextBlock Text="{CompiledBinding SizeSummary}" FontSize="10" Foreground="{DynamicResource TextTertiaryBrush}" TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <Panel Grid.Column="1">
              <Border Background="{DynamicResource SuccessSoftBrush}" BorderBrush="{DynamicResource SuccessBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="6,2"
                      VerticalAlignment="Top"
                      IsVisible="{CompiledBinding !HasSuspiciousWarning}">
                <TextBlock Text="{DynamicResource PairStatusLocked}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}" />
              </Border>

              <Button Command="{CompiledBinding RequestArbitrateCommand}"
                      Background="{DynamicResource WarningSoftBrush}" BorderBrush="{DynamicResource WarningBorderBrush}" BorderThickness="1"
                      CornerRadius="6" Padding="6,2"
                      VerticalAlignment="Top"
                      IsVisible="{CompiledBinding HasSuspiciousWarning}"
                      Cursor="Hand">
                <TextBlock Text="{DynamicResource CardArbitrateBtn}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource WarningBrush}" />
              </Button>
            </Panel>
          </Grid>

          <!-- 分隔线 -->
          <Border Height="1" Background="{DynamicResource HoverBrush}" Margin="0,2" />

          <Grid ColumnDefinitions="Auto,*,Auto">
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4">
              <ic:SymbolIcon Symbol="Clock" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
              <TextBlock Text="{CompiledBinding FormattedTime}" FontSize="10" Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center" />
            </StackPanel>

            <TextBlock Grid.Column="1" Text="{CompiledBinding DeviceInfo}" FontSize="10" Foreground="{DynamicResource TextMutedBrush}"
                       TextAlignment="Center" TextTrimming="CharacterEllipsis" Margin="4,0" VerticalAlignment="Center" />

            <TextBlock Grid.Column="2" Text="{CompiledBinding ResolutionText}" FontSize="10" FontWeight="SemiBold"
                       Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
          </Grid>
        </StackPanel>
      </Border>
    </Grid>
  </Border>
</UserControl>
