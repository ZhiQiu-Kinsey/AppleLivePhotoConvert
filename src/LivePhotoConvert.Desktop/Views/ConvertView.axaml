<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:LivePhotoConvert.Desktop.ViewModels"
             xmlns:models="using:LivePhotoConvert.Desktop.Models"
             xmlns:controls="using:LivePhotoConvert.Desktop.Controls"
             xmlns:conv="using:LivePhotoConvert.Desktop.Converters"
             x:Class="LivePhotoConvert.Desktop.Views.ConvertView"
             x:CompileBindings="True"
             x:DataType="vm:ConvertViewModel"
        xmlns:ic="using:FluentIcons.Avalonia">

  <Grid ColumnDefinitions="*,320" HorizontalAlignment="Stretch">
    <!-- Grid layout -->
    <Grid Grid.Column="0" RowDefinitions="Auto,*,Auto" Background="{DynamicResource CanvasBrush}">

      <!-- 顶部控制栏与转换方向分段器 -->
      <Border x:Name="HeaderRow" Grid.Row="0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="14,10">
        <Grid ColumnDefinitions="Auto,*,Auto">
          <!-- 左侧：转换方向分段器 -->
          <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <TextBlock Text="{DynamicResource ConvertDirectionLabel}" FontSize="12" Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center"
                       IsVisible="{Binding #HeaderRow.Bounds.Width, Converter={x:Static conv:MinWidthToBoolConverter.Instance}, ConverterParameter=560}" />
            <Border Classes="segmented-group" VerticalAlignment="Center">
              <StackPanel Orientation="Horizontal" Spacing="2">
                <Button Classes="segmented-item"
                        Classes.active="{Binding ConversionDirection, Converter={x:Static conv:EqualityConverter.Instance}, ConverterParameter=0}"
                        Command="{Binding SetDirectionCommand}" CommandParameter="0">
                  <TextBlock Text="{DynamicResource DirAppleToAndroid}" FontSize="11" />
                </Button>
                <Button Classes="segmented-item"
                        Classes.active="{Binding ConversionDirection, Converter={x:Static conv:EqualityConverter.Instance}, ConverterParameter=1}"
                        Command="{Binding SetDirectionCommand}" CommandParameter="1">
                  <TextBlock Text="{DynamicResource DirAndroidToApple}" FontSize="11" />
                </Button>
                <Button Classes="segmented-item"
                        Classes.active="{Binding ConversionDirection, Converter={x:Static conv:EqualityConverter.Instance}, ConverterParameter=2}"
                        Command="{Binding SetDirectionCommand}" CommandParameter="2">
                  <TextBlock Text="{DynamicResource DirExtract}" FontSize="11" />
                </Button>
              </StackPanel>
            </Border>
          </StackPanel>

          <!-- 右侧：精简呼吸感状态指示徽章（单行自适应排版，永不截断） -->
          <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Spacing="6"
                      IsVisible="{Binding HasScannedFiles}">
            <!-- 实况就绪徽章 (绿) -->
            <Border Background="{DynamicResource SuccessSoftBrush}" BorderBrush="{DynamicResource SuccessBorderBrush}" BorderThickness="1"
                    CornerRadius="10" Padding="8,3" VerticalAlignment="Center"
                    IsVisible="{Binding HasReadyItems}" ToolTip.Tip="{Binding FunnelReadyText}">
              <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                <ic:SymbolIcon Symbol="CheckmarkCircle" FontSize="12" Foreground="{DynamicResource SuccessBrush}" VerticalAlignment="Center" Margin="0,1,0,0"/>
                <TextBlock Text="{Binding FunnelReadyText}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource SuccessBrush}" VerticalAlignment="Center"
                           IsVisible="{Binding #HeaderRow.Bounds.Width, Converter={x:Static conv:MinWidthToBoolConverter.Instance}, ConverterParameter=520}"/>
                <TextBlock Text="{Binding ReadyCount}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource SuccessBrush}" VerticalAlignment="Center"
                           IsVisible="{Binding #HeaderRow.Bounds.Width, Converter={x:Static conv:MinWidthToBoolConverter.Instance}, ConverterParameter=&lt;520}"/>
              </StackPanel>
            </Border>

            <!-- 待裁决徽章 (橙黄，仅在 >0 时展示) -->
            <Border Background="{DynamicResource WarningSoftBrush}" BorderBrush="{DynamicResource WarningBorderBrush}" BorderThickness="1"
                    CornerRadius="10" Padding="8,3" VerticalAlignment="Center"
                    IsVisible="{Binding HasSuspiciousItems}" ToolTip.Tip="{Binding FunnelSuspiciousText}">
              <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                <ic:SymbolIcon Symbol="Warning" FontSize="12" Foreground="{DynamicResource WarningBrush}" VerticalAlignment="Center" Margin="0,1,0,0"/>
                <TextBlock Text="{Binding FunnelSuspiciousText}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource WarningBrush}" VerticalAlignment="Center"
                           IsVisible="{Binding #HeaderRow.Bounds.Width, Converter={x:Static conv:MinWidthToBoolConverter.Instance}, ConverterParameter=520}"/>
                <TextBlock Text="{Binding SuspiciousCount}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource WarningBrush}" VerticalAlignment="Center"
                           IsVisible="{Binding #HeaderRow.Bounds.Width, Converter={x:Static conv:MinWidthToBoolConverter.Instance}, ConverterParameter=&lt;520}"/>
              </StackPanel>
            </Border>

            <!-- 扫描与过滤统计胶囊 -->
            <Border Background="{DynamicResource HoverBrush}" CornerRadius="10" Padding="8,3" VerticalAlignment="Center"
                    IsVisible="{Binding #HeaderRow.Bounds.Width, Converter={x:Static conv:MinWidthToBoolConverter.Instance}, ConverterParameter=560}">
              <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                <ic:SymbolIcon Symbol="DocumentSearch" FontSize="12" Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center" Margin="0,1,0,0"/>
                <TextBlock Text="{Binding FunnelTotalText}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                <TextBlock Text="·" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center" IsVisible="{Binding HasFilteredItems}"/>
                <TextBlock Text="{Binding FunnelFilteredText}" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center" IsVisible="{Binding HasFilteredItems}"/>
              </StackPanel>
            </Border>
          </StackPanel>
        </Grid>
      </Border>

      <!-- 画廊主体容器 -->
      <Grid Grid.Row="1" RowDefinitions="Auto,Auto,*" Margin="16,12">
        <!-- 紧凑工具栏 -->
        <controls:CompactToolbar Grid.Row="0" Margin="0,0,0,8" />

        <!-- 筛选指示条 -->
        <Border Grid.Row="1" Background="{DynamicResource AccentSoftBrush}" BorderBrush="{DynamicResource AccentBorderBrush}" BorderThickness="1"
                CornerRadius="12" Padding="12,8" Margin="0,0,0,10"
                IsVisible="{Binding IsFilterBannerVisible}">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
              <ic:SymbolIcon Symbol="Filter" FontSize="12" Foreground="{DynamicResource AccentBrush}"/>
              <TextBlock Text="{DynamicResource FilterBannerPrefix}" FontSize="11" Foreground="{DynamicResource AccentTextBrush}" />
              <TextBlock Text="{Binding FilterBannerDesc}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentTextBrush}" />
            </StackPanel>
            <Button Grid.Column="1" Command="{Binding SetFilterModeCommand}" CommandParameter="All"
                    Classes="toolbar-btn" Padding="8,2">
              <StackPanel Orientation="Horizontal" Spacing="4">
                <ic:SymbolIcon Symbol="Dismiss" FontSize="10" Foreground="{DynamicResource AccentBrush}"/>
                <TextBlock Text="{DynamicResource FilterClear}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" />
              </StackPanel>
            </Button>
          </Grid>
        </Border>

        <!-- 画廊滚动视口：虚拟化单流排版，仅为可视区域生成视觉元素 -->
        <ListBox Grid.Row="2"
                 x:Name="GalleryListBox"
                 ItemsSource="{Binding FlattenedDisplayItems}"
                 Background="Transparent"
                 BorderThickness="0"
                 Padding="0">
          <ListBox.Styles>
            <Style Selector="ListBoxItem">
              <Setter Property="Padding" Value="0" />
              <Setter Property="Margin" Value="0,0,0,12" />
              <Setter Property="Background" Value="Transparent" />
            </Style>
            <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
              <Setter Property="Background" Value="Transparent" />
            </Style>
            <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
              <Setter Property="Background" Value="Transparent" />
            </Style>
          </ListBox.Styles>
          <ListBox.DataTemplates>
            <!-- 1. 组头项：独占 100% 满宽 -->
            <DataTemplate DataType="models:TimelineHeaderItemViewModel">
              <Border Background="{DynamicResource HoverBrush}" CornerRadius="12" Padding="12,8"
                      IsVisible="{Binding IsVisible}">
                <Grid ColumnDefinitions="Auto,*,Auto">
                  <Button Grid.Column="0" Background="Transparent" BorderThickness="0" Padding="0"
                          Command="{Binding ToggleCollapseCommand}" Cursor="Hand">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <Panel Width="16" Height="16">
                        <ic:SymbolIcon Symbol="ChevronDown" FontSize="10" Foreground="{DynamicResource TextTertiaryBrush}" IsVisible="{Binding !IsCollapsed}"/>
                        <ic:SymbolIcon Symbol="ChevronRight" FontSize="10" Foreground="{DynamicResource TextTertiaryBrush}" IsVisible="{Binding IsCollapsed}"/>
                      </Panel>
                      <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                      <Border Width="1" Height="10" Background="{DynamicResource LineStrongBrush}" VerticalAlignment="Center" />
                      <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <ic:SymbolIcon Symbol="Location" FontSize="10" Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding LocationSummary}" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center" />
                      </StackPanel>
                    </StackPanel>
                  </Button>

                  <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                      <TextBlock Text="{Binding PhotoCount}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                      <TextBlock Text="{DynamicResource UnitLivePhotos}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                  </StackPanel>
                </Grid>
              </Border>
            </DataTemplate>

            <!-- 2. 等高自适应行：按原图比例分配宽度，行高在目标值附近调整并预先测量 -->
            <DataTemplate DataType="models:PhotoGridRowViewModel">
              <ItemsControl ItemsSource="{Binding Cards}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" Spacing="8" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="models:PhotoCardItemViewModel">
                    <controls:PhotoCardControl Width="{CompiledBinding DisplayWidth}"
                                               IsVisible="{CompiledBinding IsVisible}" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </DataTemplate>
          </ListBox.DataTemplates>
        </ListBox>

        <!-- Layout panel -->
        <Panel Grid.Row="2" IsVisible="{Binding !HasPhotos}">
          <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="14">
            <ic:SymbolIcon Symbol="Camera" FontSize="56" Foreground="{DynamicResource LineStrongBrush}" HorizontalAlignment="Center"/>
            <TextBlock Text="{Binding EmptyStateTitle}" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"
                       HorizontalAlignment="Center" TextAlignment="Center" />
            <TextBlock Text="{Binding EmptyStateSubtitle}" FontSize="12" Foreground="{DynamicResource TextTertiaryBrush}"
                       HorizontalAlignment="Center" TextAlignment="Center" MaxWidth="380" TextWrapping="Wrap" />
            <Button Classes="primary-btn" Command="{Binding SelectAlbumFolderCommand}"
                    HorizontalAlignment="Center" Padding="18,9" Margin="0,6,0,0">
              <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <ic:SymbolIcon Symbol="Folder" FontSize="15" Foreground="{DynamicResource OnAccentBrush}" VerticalAlignment="Center" Margin="0,1,0,0"/>
                <TextBlock Text="{Binding SelectAlbumFolderBtnText}" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
          </StackPanel>
        </Panel>
      </Grid>

      <!-- Card container -->
      <Border x:Name="BottomBar" Grid.Row="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="14,10">
        <StackPanel Spacing="8">
          <!-- Card container -->
          <Border Background="{DynamicResource AccentSoftBrush}" BorderBrush="{DynamicResource AccentBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="12"
                  IsVisible="{Binding IsRunning}">
            <StackPanel Spacing="6">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                  <ic:SymbolIcon Symbol="ArrowSync" FontSize="12" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,1,0,0"/>
                  <TextBlock Text="{DynamicResource ConvertRunningPrefix}" FontSize="11" Foreground="{DynamicResource AccentTextBrush}" VerticalAlignment="Center" />
                  <TextBlock Text="{Binding CurrentFileName}" FontSize="11" FontWeight="Bold" FontFamily="Consolas" Foreground="{DynamicResource AccentTextBrush}" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                  <TextBlock Text="{Binding ProgressRatioText}" FontSize="11" FontWeight="Bold" FontFamily="Consolas" Foreground="{DynamicResource AccentTextBrush}" VerticalAlignment="Center" />
                  <Button Classes="danger-btn" Command="{Binding CancelBatchCommand}" Padding="8,2">
                    <TextBlock Text="{DynamicResource CancelTaskBtn}" FontSize="10" FontWeight="Bold" />
                  </Button>
                </StackPanel>
              </Grid>

              <ProgressBar Value="{Binding CurrentProgressPercent}" Minimum="0" Maximum="100" Height="6" CornerRadius="3" Foreground="{DynamicResource AccentBrush}" />

              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" Text="{Binding WritingThroughputText}" FontSize="10" Foreground="{DynamicResource AccentBrush}" FontFamily="Consolas" />
                <TextBlock Grid.Column="1" Text="{Binding RemainingTimeText}" FontSize="10" Foreground="{DynamicResource AccentBrush}" FontFamily="Consolas" />
              </Grid>
            </StackPanel>
          </Border>

          <!-- 底部参数与输出目录状态栏 -->
          <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
            <!-- 左侧：输出目录与层级设置（自适应弹性收缩，防止小窗遮挡） -->
            <Grid Grid.Column="0" ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
              <TextBlock Grid.Column="0" Text="{DynamicResource OutputDirLabel}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0"
                         IsVisible="{Binding #BottomBar.Bounds.Width, Converter={x:Static conv:MinWidthToBoolConverter.Instance}, ConverterParameter=520}" />

              <!-- 输出目录交互胶囊盒 -->
              <Border Grid.Column="1" Height="28" Background="{DynamicResource HoverBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                      CornerRadius="6" Padding="8,0" VerticalAlignment="Center" Margin="0,0,8,0">
                <Grid ColumnDefinitions="Auto,*,Auto,Auto" VerticalAlignment="Center">
                  <ic:SymbolIcon Grid.Column="0" Symbol="Folder" FontSize="13" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,1,6,0"/>
                  <TextBlock Grid.Column="1" Text="{Binding OutputDirectory}" FontSize="11" FontFamily="Consolas" Foreground="{DynamicResource TextPrimaryBrush}"
                             MinWidth="40" MaxWidth="220" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                             ToolTip.Tip="{Binding OutputDirectory}" Margin="0,0,8,0" />

                  <!-- 更改输出目录按钮 -->
                  <Button Grid.Column="2" Classes="capsule-btn" Command="{Binding SelectOutputFolderCommand}"
                          ToolTip.Tip="{DynamicResource ChangeOutputDirBtn}" VerticalAlignment="Center" Margin="0,0,4,0">
                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                      <ic:SymbolIcon Symbol="FolderOpen" FontSize="11" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,1,0,0"/>
                      <TextBlock Text="{DynamicResource ChangeOutputDirBtn}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                  </Button>

                  <!-- 在资源管理器中打开按钮 -->
                  <Button Grid.Column="3" Classes="capsule-icon-btn" Command="{Binding OpenOutputFolderCommand}"
                          ToolTip.Tip="{DynamicResource OpenOutputDirTip}" VerticalAlignment="Center">
                    <ic:SymbolIcon Symbol="Open" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  </Button>
                </Grid>
              </Border>

              <!-- 子目录层级开关（消除 On/Off 文本，紧凑单行水平对齐） -->
              <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"
                          ToolTip.Tip="{DynamicResource KeepSubfoldersTip}">
                <Border Width="1" Height="16" Background="{DynamicResource LineBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ToggleSwitch IsChecked="{Binding KeepSubfolderHierarchy}"
                              OnContent="" OffContent="" MinWidth="0" Padding="0" Margin="0"
                              VerticalAlignment="Center" />
                <TextBlock Text="{DynamicResource KeepSubfoldersLabel}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"
                           IsVisible="{Binding #BottomBar.Bounds.Width, Converter={x:Static conv:MinWidthToBoolConverter.Instance}, ConverterParameter=560}" />
              </StackPanel>
            </Grid>

            <!-- 右侧：选中与处理项概括 -->
            <TextBlock Grid.Column="1" Text="{Binding SelectedSummaryText}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" MaxWidth="200" Margin="12,0,0,0" />
          </Grid>
        </StackPanel>
      </Border>

    </Grid>

    <!-- 右侧任务转换控制台 (320px) -->
    <Border Grid.Column="1" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1,0,0,0" Padding="18,16">
      <Grid RowDefinitions="Auto,*,Auto">
        <!-- 控制台头部 -->
        <Border Grid.Row="0" BorderBrush="{DynamicResource HoverBrush}" BorderThickness="0,0,0,1" Padding="0,0,0,12">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Grid.Column="0" Text="{DynamicResource ConsoleTitle}" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}" />
            <Border Grid.Column="1" Background="{DynamicResource HoverBrush}" CornerRadius="6" Padding="6,2">
              <TextBlock Text="{DynamicResource ConsoleConfig}" FontSize="10" Foreground="{DynamicResource TextTertiaryBrush}" FontFamily="Consolas" />
            </Border>
          </Grid>
        </Border>

        <!-- Scrollable content area -->
        <ScrollViewer Grid.Row="1" Margin="0,12" VerticalScrollBarVisibility="Auto">
          <StackPanel Spacing="16">
            <!-- Layout panel -->
            <StackPanel Spacing="6">
              <TextBlock Text="{DynamicResource NamingFormatTitle}" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
              <ComboBox Classes="engine-select" SelectedIndex="{Binding NamingFormat, Mode=TwoWay}" HorizontalAlignment="Stretch">
                <ComboBoxItem Content="{DynamicResource NamingFormatOriginalShort}" />
                <ComboBoxItem Content="{DynamicResource NamingFormatDateNameShort}" />
                <ComboBoxItem Content="{DynamicResource NamingFormatCleanShort}" />
              </ComboBox>
              <Border Background="{DynamicResource CanvasBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="8" Padding="8">
                <TextBlock Text="{Binding LiveFilenameDemo}" FontSize="11" FontWeight="Bold" FontFamily="Consolas" Foreground="{DynamicResource AccentBrush}" />
              </Border>
            </StackPanel>

            <!-- Source action: keep, move, recycle, or delete originals -->
            <StackPanel Spacing="6">
              <TextBlock Text="{DynamicResource SourceActionTitle}" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
              <ComboBox Classes="engine-select" SelectedIndex="{Binding SourceAction, Mode=TwoWay}" HorizontalAlignment="Stretch">
                <ComboBoxItem Content="{DynamicResource SourceActionKeepShort}" />
                <ComboBoxItem Content="{DynamicResource SourceActionSubfolderShort}" />
                <ComboBoxItem Content="{DynamicResource SourceActionRecycleShort}" />
                <ComboBoxItem Content="{DynamicResource SourceActionDeleteShort}" Foreground="{DynamicResource DangerBrush}" />
              </ComboBox>

              <!-- 危险操作警示 -->
              <Border Background="{DynamicResource DangerSoftBrush}" BorderBrush="{DynamicResource DangerBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="8"
                      IsVisible="{Binding IsDeleteWarningVisible}">
                <StackPanel Spacing="2">
                  <StackPanel Orientation="Horizontal" Spacing="4">
                    <ic:SymbolIcon Symbol="ShieldError" FontSize="10" Foreground="{DynamicResource DangerBrush}"/>
                    <TextBlock Text="{DynamicResource DeleteWarningTitle}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource DangerPressedBrush}" />
                  </StackPanel>
                  <TextBlock Text="{DynamicResource DeleteWarningDesc}"
                             FontSize="10" Foreground="{DynamicResource DangerPressedBrush}" TextWrapping="Wrap" />
                </StackPanel>
              </Border>
            </StackPanel>

            <!-- Card container -->
            <Border Background="{DynamicResource CanvasBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="12" Padding="12">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Spacing="2">
                  <TextBlock Text="{DynamicResource AutoAppendIndexTitle}" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                  <TextBlock Text="{DynamicResource AutoAppendIndexDesc}" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" />
                </StackPanel>
                <ToggleSwitch Grid.Column="1" IsChecked="{Binding AutoAppendIndex, Mode=TwoWay}"
                              OnContent="" OffContent="" MinWidth="0" Padding="0" Margin="0"
                              VerticalAlignment="Center" />
              </Grid>
            </Border>

            <!-- Layout panel -->
            <StackPanel Spacing="6">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" Text="{DynamicResource HeicQualityTitle}" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2">
                  <TextBlock Text="{Binding HeicQuality, StringFormat='{}{0}% '}" FontSize="11" FontWeight="Bold" FontFamily="Consolas" Foreground="{DynamicResource AccentBrush}" />
                  <TextBlock Text="{DynamicResource UnitQuality}" FontSize="11" FontWeight="Bold" FontFamily="Consolas" Foreground="{DynamicResource AccentBrush}" />
                </StackPanel>
              </Grid>
              <Slider Value="{Binding HeicQuality, Mode=TwoWay}" Minimum="50" Maximum="100" />
              <TextBlock Text="{DynamicResource HeicQualityDesc}" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" />
            </StackPanel>
          </StackPanel>
        </ScrollViewer>

        <!-- 底部主操作转换按钮 -->
        <Button Grid.Row="2" Classes="primary-btn" Command="{Binding TriggerBatchConvertCommand}" HorizontalAlignment="Stretch">
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
            <ic:SymbolIcon Symbol="ArrowSwap" FontSize="14" Foreground="{DynamicResource OnAccentBrush}"/>
            <TextBlock Text="{Binding PrimaryButtonText}" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
      </Grid>
    </Border>
  </Grid>
</UserControl>
