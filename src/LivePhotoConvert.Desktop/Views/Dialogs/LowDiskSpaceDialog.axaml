<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dialogs="using:LivePhotoConvert.Desktop.ViewModels.Dialogs"
             x:Class="LivePhotoConvert.Desktop.Views.Dialogs.LowDiskSpaceDialog"
             x:CompileBindings="True"
             x:DataType="dialogs:LowDiskSpaceDialogViewModel"
        xmlns:ic="using:FluentIcons.Avalonia">

  <Border Background="#CC0F172A" Padding="16">
    <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="24" Padding="24" MaxWidth="440" HorizontalAlignment="Center" VerticalAlignment="Center"
            BorderBrush="{DynamicResource WarningBorderBrush}" BorderThickness="1" BoxShadow="0 20 40 0 #40000000">
      <StackPanel Spacing="16">
        <Grid ColumnDefinitions="Auto,*">
          <Border Grid.Column="0" Width="40" Height="40" CornerRadius="12" Background="#FEF3C7" VerticalAlignment="Center">
            <ic:SymbolIcon Symbol="HardDrive" FontSize="20" Foreground="{DynamicResource WarningBrush}"/>
          </Border>
          <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" Spacing="2">
            <TextBlock Text="{DynamicResource LowDiskDialogTitle}" FontWeight="Black" FontSize="14" Foreground="#92400E" />
            <TextBlock Text="{DynamicResource LowDiskDialogDesc}" FontSize="11" Foreground="{DynamicResource WarningBrush}" />
          </StackPanel>
        </Grid>

        <Border Background="{DynamicResource WarningSoftBrush}" CornerRadius="12" Padding="12" BorderBrush="{DynamicResource WarningBorderBrush}" BorderThickness="1">
          <StackPanel Spacing="6">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Grid.Column="0" Text="{DynamicResource LowDiskRequiredLabel}" FontSize="11" Foreground="#78350F" />
              <TextBlock Grid.Column="1" Text="{CompiledBinding RequiredSpaceText}" FontWeight="Bold" FontSize="11" Foreground="#92400E" />
            </Grid>
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Grid.Column="0" Text="{DynamicResource LowDiskAvailableLabel}" FontSize="11" Foreground="#78350F" />
              <TextBlock Grid.Column="1" Text="{CompiledBinding AvailableSpaceText}" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource DangerBrush}" />
            </Grid>
          </StackPanel>
        </Border>

        <TextBlock Text="{DynamicResource LowDiskSolutionDesc}" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" />

        <Button Classes="primary-btn" Command="{CompiledBinding DismissCommand}" HorizontalAlignment="Right">
          <TextBlock Text="{DynamicResource LowDiskDialogDismiss}" FontSize="12" FontWeight="Bold" />
        </Button>
      </StackPanel>
    </Border>
  </Border>
</UserControl>
