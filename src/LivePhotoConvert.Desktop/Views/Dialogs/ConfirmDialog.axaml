<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dialogs="using:LivePhotoConvert.Desktop.ViewModels.Dialogs"
             xmlns:ic="using:FluentIcons.Avalonia"
             x:Class="LivePhotoConvert.Desktop.Views.Dialogs.ConfirmDialog"
             x:CompileBindings="True"
             x:DataType="dialogs:ConfirmDialogViewModel">

  <Border Classes="dialog-card" MinWidth="360" MaxWidth="480">
    <StackPanel Spacing="16">
      <Grid ColumnDefinitions="Auto,*">
        <Panel Grid.Column="0">
          <Border Classes="dialog-icon-badge danger" IsVisible="{CompiledBinding IsDanger}">
            <ic:SymbolIcon Symbol="Warning" FontSize="20" Foreground="{DynamicResource DangerBrush}" />
          </Border>
          <Border Classes="dialog-icon-badge info" IsVisible="{CompiledBinding !IsDanger}">
            <ic:SymbolIcon Symbol="Info" FontSize="20" Foreground="{DynamicResource AccentBrush}" />
          </Border>
        </Panel>
        <TextBlock Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap"
                   Text="{CompiledBinding Title}" FontWeight="Black" FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}" />
      </Grid>

      <TextBlock Text="{CompiledBinding Message}" IsVisible="{CompiledBinding HasMessage}"
                 FontSize="12" LineHeight="18" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" />

      <Grid ColumnDefinitions="*,Auto" Margin="0,8,0,0">
        <Button Grid.Column="0" Classes="nav-btn" Command="{CompiledBinding CancelCommand}" HorizontalAlignment="Left"
                IsVisible="{CompiledBinding ShowCancelButton}">
          <TextBlock Text="{CompiledBinding CancelText}" FontSize="12" FontWeight="SemiBold" />
        </Button>
        <StackPanel Grid.Column="1" Orientation="Horizontal">
          <Button Classes="danger-btn" Command="{CompiledBinding ConfirmCommand}" IsVisible="{CompiledBinding IsDanger}">
            <TextBlock Text="{CompiledBinding ConfirmText}" FontSize="12" FontWeight="Bold" />
          </Button>
          <Button Classes="primary-btn" Command="{CompiledBinding ConfirmCommand}" IsVisible="{CompiledBinding !IsDanger}">
            <TextBlock Text="{CompiledBinding ConfirmText}" FontSize="12" FontWeight="Bold" />
          </Button>
        </StackPanel>
      </Grid>
    </StackPanel>
  </Border>
</UserControl>
