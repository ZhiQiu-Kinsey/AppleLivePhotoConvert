<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dialogs="using:LivePhotoConvert.Desktop.ViewModels.Dialogs"
             xmlns:ic="using:FluentIcons.Avalonia"
             x:Class="LivePhotoConvert.Desktop.Views.Dialogs.QuickLookDialog"
             x:CompileBindings="True"
             x:DataType="dialogs:QuickLookDialogViewModel"
             Focusable="True">

  <!-- 遮罩由主窗口弹窗宿主提供 -->
  <Border Background="{DynamicResource SurfaceBrush}"
          CornerRadius="20"
          BorderBrush="{DynamicResource LineBrush}"
          BorderThickness="1"
          MaxWidth="1100"
          MaxHeight="820"
          Margin="32"
          HorizontalAlignment="Center"
          VerticalAlignment="Center"
          BoxShadow="0 25 60 0 #60000000"
          ClipToBounds="True">
    <Grid RowDefinitions="Auto,*,Auto,Auto">
      <!-- 1. 顶部标题栏 -->
      <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="20,16" VerticalAlignment="Center">
        <Border Grid.Column="0" CornerRadius="8" Background="{DynamicResource AccentSoftBrush}" Padding="8,6" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <ic:SymbolIcon Symbol="Live" FontSize="14" Foreground="{DynamicResource AccentBrush}"/>
            <TextBlock Text="{DynamicResource QuickLookLiveBadge}" FontSize="12" Foreground="{DynamicResource AccentBrush}" FontWeight="Bold" VerticalAlignment="Center"/>
          </StackPanel>
        </Border>

        <StackPanel Grid.Column="1" Margin="16,0,16,0" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
            <TextBlock Text="{CompiledBinding Card.FileName}" FontWeight="Bold" FontSize="15" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" MaxWidth="500" />
            <Border Background="{DynamicResource LineBrush}" CornerRadius="4" Padding="6,2" VerticalAlignment="Center"
                    IsVisible="{CompiledBinding NavigationIndexText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
              <TextBlock Text="{CompiledBinding NavigationIndexText}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" FontWeight="SemiBold" />
            </Border>
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,4,0,0">
            <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{CompiledBinding Card.LocationSummary, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
              <ic:SymbolIcon Symbol="Location" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
              <TextBlock Text="{CompiledBinding Card.LocationSummary}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{CompiledBinding Card.FormattedDate, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
              <ic:SymbolIcon Symbol="Calendar" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
              <TextBlock Text="{CompiledBinding Card.FormattedDate}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
            </StackPanel>
          </StackPanel>
        </StackPanel>

        <Button Grid.Column="2" Classes="nav-btn" Command="{CompiledBinding CancelCommand}" Width="36" Height="36" Padding="0"
                ToolTip.Tip="{DynamicResource QuickLookCloseTip}">
          <ic:SymbolIcon Symbol="Dismiss" FontSize="16" Foreground="{DynamicResource TextSecondaryBrush}"/>
        </Button>
      </Grid>

      <!-- 2. 核心媒体画布区 -->
      <Panel Grid.Row="1" MinHeight="480" Background="{DynamicResource MediaCanvasBrush}" ClipToBounds="True">
        <!-- 实况画面渲染画布（高清封面底图 + 流式动态帧平滑推进，统一原生 Image 渲染） -->
        <Image Source="{CompiledBinding CurrentDisplayImage}"
               RenderOptions.BitmapInterpolationMode="HighQuality"
               Stretch="Uniform"
               HorizontalAlignment="Center"
               VerticalAlignment="Center" />

        <!-- 左侧切换上一张悬浮圆钮 -->
        <Button Command="{CompiledBinding PrevItemCommand}"
                HorizontalAlignment="Left" VerticalAlignment="Center" Margin="20,0"
                Width="44" Height="44" CornerRadius="22"
                Background="{DynamicResource MediaControlBrush}" BorderBrush="{DynamicResource MediaControlBorderBrush}" BorderThickness="1"
                Padding="0" Cursor="Hand" ToolTip.Tip="{DynamicResource QuickLookPrevTip}">
          <ic:SymbolIcon Symbol="ArrowLeft" FontSize="18" Foreground="{DynamicResource OnMediaBrush}"/>
        </Button>

        <!-- 右侧切换下一张悬浮圆钮 -->
        <Button Command="{CompiledBinding NextItemCommand}"
                HorizontalAlignment="Right" VerticalAlignment="Center" Margin="20,0"
                Width="44" Height="44" CornerRadius="22"
                Background="{DynamicResource MediaControlBrush}" BorderBrush="{DynamicResource MediaControlBorderBrush}" BorderThickness="1"
                Padding="0" Cursor="Hand" ToolTip.Tip="{DynamicResource QuickLookNextTip}">
          <ic:SymbolIcon Symbol="ArrowRight" FontSize="18" Foreground="{DynamicResource OnMediaBrush}"/>
        </Button>

        <!-- 播放状态左上角悬浮胶囊 -->
        <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="16"
                Background="{DynamicResource MediaBadgeBrush}" CornerRadius="14" Padding="10,5"
                IsVisible="{CompiledBinding HasVideo}">
          <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
            <ic:SymbolIcon Symbol="Live" FontSize="13" Foreground="{DynamicResource MediaAccentBrush}"/>
            <TextBlock Text="{CompiledBinding PlaybackStatusText}" Foreground="{DynamicResource OnMediaBrush}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
          </StackPanel>
        </Border>
      </Panel>

      <!-- 3. 元数据信息条 -->
      <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}" Padding="24,14" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1">
        <Grid ColumnDefinitions="*,*,*,*">
          <StackPanel Grid.Column="0" Spacing="3">
            <TextBlock Text="{DynamicResource QuickLookDevice}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
            <TextBlock Text="{CompiledBinding Card.DeviceInfo}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
          </StackPanel>
          <StackPanel Grid.Column="1" Spacing="3">
            <TextBlock Text="{DynamicResource QuickLookResolution}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
            <TextBlock Text="{CompiledBinding Card.ResolutionText}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
          </StackPanel>
          <StackPanel Grid.Column="2" Spacing="3">
            <TextBlock Text="{DynamicResource QuickLookPairing}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
            <TextBlock Text="{CompiledBinding Card.PairingStatusText}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource SuccessBrush}" TextTrimming="CharacterEllipsis" />
          </StackPanel>
          <StackPanel Grid.Column="3" Spacing="3">
            <TextBlock Text="{DynamicResource QuickLookSize}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
            <TextBlock Text="{CompiledBinding Card.SizeSummary}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
          </StackPanel>
        </Grid>
      </Border>

      <!-- 4. 底部播放控制与快捷键说明栏 -->
      <Border Grid.Row="3" Background="{DynamicResource HoverBrush}" Padding="20,12" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0">
        <Grid ColumnDefinitions="Auto,*,Auto">
          <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
            <Button Classes="primary-btn" Command="{CompiledBinding TogglePlayCommand}" Padding="16,8"
                    IsVisible="{CompiledBinding HasVideo}" Cursor="Hand">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <ic:SymbolIcon Symbol="Pause" FontSize="13" Foreground="{DynamicResource OnAccentBrush}"
                               IsVisible="{CompiledBinding IsPlaying}"/>
                <ic:SymbolIcon Symbol="Play" FontSize="13" Foreground="{DynamicResource OnAccentBrush}"
                               IsVisible="{CompiledBinding !IsPlaying}"/>
                <TextBlock Text="{CompiledBinding PlayButtonText}" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
          </StackPanel>

          <TextBlock Grid.Column="2" Text="{DynamicResource QuickLookShortcuts}" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center" />
        </Grid>
      </Border>
    </Grid>
  </Border>
</UserControl>
