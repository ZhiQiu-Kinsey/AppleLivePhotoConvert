<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dialogs="using:LivePhotoConvert.Desktop.ViewModels.Dialogs"
             x:Class="LivePhotoConvert.Desktop.Views.Dialogs.ArbitrateDialog"
             x:CompileBindings="True"
             x:DataType="dialogs:ArbitrateDialogViewModel"
        xmlns:ic="using:FluentIcons.Avalonia">

  <Border Background="#CC0F172A" Padding="16">
    <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="24" Padding="24" MaxWidth="600" HorizontalAlignment="Center" VerticalAlignment="Center"
            BorderBrush="{DynamicResource WarningBorderBrush}" BorderThickness="1" BoxShadow="0 20 40 0 #40000000">
      <StackPanel Spacing="16">
        <!-- Grid layout -->
        <Grid ColumnDefinitions="Auto,*,Auto">
          <Border Grid.Column="0" Width="36" Height="36" CornerRadius="10" Background="#FEF3C7" VerticalAlignment="Center">
            <ic:SymbolIcon Symbol="Scales" FontSize="18" Foreground="{DynamicResource WarningBrush}"/>
          </Border>
          <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
            <TextBlock Text="{DynamicResource ArbitrateDialogTitle}" FontWeight="Black" FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}" />
            <TextBlock Text="{DynamicResource ArbitrateDialogDesc}" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" />
          </StackPanel>
          <Button Grid.Column="2" Classes="nav-btn" Command="{CompiledBinding CloseCommand}" Width="28" Height="28" Padding="0">
            <ic:SymbolIcon Symbol="Dismiss" FontSize="12" Foreground="{DynamicResource TextMutedBrush}"/>
          </Button>
        </Grid>

        <!-- Grid layout -->
        <Grid ColumnDefinitions="*,*">
          <!-- 宸︿晶锛氶潤鎬佺収鐗?-->
          <Border Grid.Column="0" Background="{DynamicResource CanvasBrush}" CornerRadius="16" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" Padding="12" Margin="0,0,6,0">
            <StackPanel Spacing="8">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" Text="{DynamicResource ArbitratePhotoTitle}" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                <TextBlock Grid.Column="1" Text="{CompiledBinding PhotoTimeText}" FontSize="10" Foreground="{DynamicResource AccentBrush}" FontFamily="Consolas" />
              </Grid>
              <Border Background="{DynamicResource TextPrimaryBrush}" CornerRadius="12" Height="140">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="4">
                  <ic:SymbolIcon Symbol="Camera" FontSize="28" Foreground="#60A5FA"/>
                  <TextBlock Text="{DynamicResource ArbitratePhotoDesc}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource OnAccentBrush}" HorizontalAlignment="Center" />
                  <TextBlock Text="{CompiledBinding TargetCard.FileName}" TextTrimming="CharacterEllipsis" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" />
                </StackPanel>
              </Border>
            </StackPanel>
          </Border>

          <!-- Card container -->
          <Border Grid.Column="1" Background="{DynamicResource CanvasBrush}" CornerRadius="16" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" Padding="12" Margin="6,0,0,0">
            <StackPanel Spacing="8">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" Text="{DynamicResource ArbitrateVideoTitle}" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                <TextBlock Grid.Column="1" Text="{CompiledBinding VideoTimeText}" FontSize="10" Foreground="{DynamicResource WarningBrush}" FontFamily="Consolas" />
              </Grid>
              <Border Background="{DynamicResource TextPrimaryBrush}" CornerRadius="12" Height="140">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="4">
                  <ic:SymbolIcon Symbol="Video" FontSize="28" Foreground="#FBBF24"/>
                  <TextBlock Text="{DynamicResource ArbitrateVideoDesc}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource OnAccentBrush}" HorizontalAlignment="Center" />
                  <TextBlock Text="{CompiledBinding TargetCard.VideoSizeText}" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" />
                </StackPanel>
              </Border>
            </StackPanel>
          </Border>
        </Grid>

        <!-- Card container -->
        <Border Background="{DynamicResource WarningSoftBrush}" CornerRadius="12" Padding="12" BorderBrush="{DynamicResource WarningBorderBrush}" BorderThickness="1">
          <StackPanel Spacing="4" TextElement.FontSize="11">
            <TextBlock Text="{DynamicResource ArbitrateConclusionLabel}" FontWeight="Bold" Foreground="#92400E" />
            <TextBlock Text="{CompiledBinding VerdictConclusion}" Foreground="#78350F" TextWrapping="Wrap" />
          </StackPanel>
        </Border>

        <!-- 搴曢儴鍐崇瓥鎸夐挳 -->
        <Grid ColumnDefinitions="*,Auto" Margin="0,8,0,0">
          <Button Grid.Column="0" Classes="nav-btn" Command="{CompiledBinding RejectSplitCommand}" HorizontalAlignment="Left">
            <TextBlock Text="{DynamicResource ArbitrateReject}" FontSize="11" FontWeight="SemiBold" />
          </Button>
          <Button Grid.Column="1" Classes="primary-btn" Background="{DynamicResource SuccessBrush}" Command="{CompiledBinding ConfirmWhitelistCommand}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <ic:SymbolIcon Symbol="Checkmark" FontSize="12" Foreground="{DynamicResource OnAccentBrush}"/>
              <TextBlock Text="{DynamicResource ArbitrateConfirm}" FontSize="11" FontWeight="Bold" />
            </StackPanel>
          </Button>
        </Grid>
      </StackPanel>
    </Border>
  </Border>
</UserControl>
