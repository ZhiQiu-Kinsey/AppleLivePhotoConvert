<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dialogs="using:LivePhotoConvert.Desktop.ViewModels.Dialogs"
             x:Class="LivePhotoConvert.Desktop.Views.Dialogs.DeleteConfirmDialog"
             x:CompileBindings="True"
             x:DataType="dialogs:DeleteConfirmDialogViewModel"
        xmlns:ic="using:FluentIcons.Avalonia">

  <Border Background="#CC0F172A" Padding="16">
    <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="24" Padding="24" MaxWidth="440" HorizontalAlignment="Center" VerticalAlignment="Center"
            BorderBrush="#FCA5A5" BorderThickness="1" BoxShadow="0 20 40 0 #40000000">
      <StackPanel Spacing="16">
        <!-- 澶撮儴璀︽姤 -->
        <Grid ColumnDefinitions="Auto,*">
          <Border Grid.Column="0" Width="40" Height="40" CornerRadius="12" Background="#FEE2E2" VerticalAlignment="Center">
            <ic:SymbolIcon Symbol="ShieldError" FontSize="20" Foreground="{DynamicResource DangerBrush}"/>
          </Border>
          <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" Spacing="2">
            <TextBlock Text="{DynamicResource DeleteDialogTitle}" FontWeight="Black" FontSize="14" Foreground="{DynamicResource DangerPressedBrush}" />
            <TextBlock Text="{DynamicResource DeleteDialogDesc}" FontSize="11" Foreground="{DynamicResource DangerBrush}" />
          </StackPanel>
        </Grid>

        <!-- 褰卞搷鑼冨洿 -->
        <Border Background="{DynamicResource DangerSoftBrush}" CornerRadius="12" Padding="12" BorderBrush="{DynamicResource DangerBorderBrush}" BorderThickness="1">
          <StackPanel Spacing="4">
            <TextBlock Text="{CompiledBinding AffectedSummaryText}" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource DangerPressedBrush}" />
            <TextBlock Text="{DynamicResource DeleteIrreversibleDesc}" FontSize="11" Foreground="#7F1D1D" />
          </StackPanel>
        </Border>

        <!-- 瑙ｉ攣杈撳叆妗?-->
        <StackPanel Spacing="6">
          <TextBlock Text="{DynamicResource DeleteDialogInputLabel}" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
          <TextBox Text="{CompiledBinding PasswordInput, Mode=TwoWay}"
                   PlaceholderText="{DynamicResource DeleteInputPlaceholder}"
                   FontSize="13" FontWeight="Bold" FontFamily="Consolas"
                   HorizontalContentAlignment="Center"
                   CornerRadius="10" Padding="10" />
        </StackPanel>

        <!-- 鎿嶄綔鎸夐挳 -->
        <Grid ColumnDefinitions="*,Auto" Margin="0,8,0,0">
          <Button Grid.Column="0" Classes="nav-btn" Command="{CompiledBinding CancelCommand}" HorizontalAlignment="Left">
            <TextBlock Text="{DynamicResource DeleteDialogCancel}" FontSize="12" FontWeight="SemiBold" />
          </Button>
          <Button Grid.Column="1" Classes="danger-btn" Command="{CompiledBinding ConfirmCommand}" IsEnabled="{CompiledBinding CanConfirm}">
            <TextBlock Text="{DynamicResource DeleteDialogConfirm}" FontSize="12" FontWeight="Bold" />
          </Button>
        </Grid>
      </StackPanel>
    </Border>
  </Border>
</UserControl>
