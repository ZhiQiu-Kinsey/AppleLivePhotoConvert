<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:LivePhotoConvert.Desktop.ViewModels"
             xmlns:models="using:LivePhotoConvert.Desktop.Models"
             x:Class="LivePhotoConvert.Desktop.Views.SettingsView"
             x:CompileBindings="True"
             x:DataType="vm:SettingsViewModel"
        xmlns:ic="using:FluentIcons.Avalonia">

  <UserControl.Resources>
    <!-- “关于”页鸣谢行：点击即跳转对应项目主页，命令由页面视图模型统一提供 -->
    <DataTemplate x:Key="AboutCreditRowTemplate" x:DataType="models:AboutCredit">
      <Button Classes="credit-row"
              Command="{CompiledBinding $parent[ItemsControl].((vm:SettingsViewModel)DataContext).OpenUrlCommand}"
              CommandParameter="{CompiledBinding Url}">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Grid.Column="0" Spacing="1" VerticalAlignment="Center">
            <TextBlock Text="{CompiledBinding Name}" FontSize="11.5" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}" />
            <TextBlock Text="{CompiledBinding Description}" FontSize="10" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextMutedBrush}" />
          </StackPanel>
          <Border Grid.Column="1" Background="{DynamicResource HoverBrush}" CornerRadius="5" Padding="6,2"
                  VerticalAlignment="Center" Margin="8,0,0,0">
            <TextBlock Text="{CompiledBinding Badge}" FontSize="9" Foreground="{DynamicResource TextTertiaryBrush}" />
          </Border>
        </Grid>
      </Button>
    </DataTemplate>
  </UserControl.Resources>

  <Grid>
  <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
    <StackPanel Spacing="20" Margin="24" Width="1000" HorizontalAlignment="Center">

      <!-- 页头：标题 / 说明 / 保存 -->
      <Grid ColumnDefinitions="*,Auto,Auto">
        <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
          <TextBlock Text="{DynamicResource SettingsPageTitle}" FontWeight="Bold" FontSize="16"
                     Foreground="{DynamicResource TextPrimaryBrush}" />
          <TextBlock Text="{DynamicResource SettingsPageDesc}" FontSize="11"
                     Foreground="{DynamicResource TextTertiaryBrush}" TextWrapping="Wrap" />
        </StackPanel>
        <Border Grid.Column="1" Background="{DynamicResource SuccessSoftBrush}" BorderBrush="{DynamicResource SuccessBorderBrush}"
                BorderThickness="1" CornerRadius="8" Padding="10,4" Margin="0,0,10,0" VerticalAlignment="Center"
                IsVisible="{CompiledBinding IsSettingsSaved}">
          <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
            <ic:SymbolIcon Symbol="Checkmark" FontSize="11" Foreground="{DynamicResource SuccessBrush}" VerticalAlignment="Center" Margin="0,1,0,0"/>
            <TextBlock Text="{DynamicResource SettingsSavedHint}" FontSize="11" FontWeight="SemiBold"
                       Foreground="{DynamicResource SuccessBrush}" VerticalAlignment="Center" />
          </StackPanel>
        </Border>
        <Button Grid.Column="2" Classes="primary-btn" Height="34" Padding="16,0" VerticalAlignment="Center"
                Command="{CompiledBinding SaveCommand}">
          <TextBlock Text="{DynamicResource SaveSettingsBtn}" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" />
        </Button>
      </Grid>

      <!-- 页内导航：将编辑偏好与项目说明分离，避免单页信息过长。 -->
      <Border Classes="segmented-group" HorizontalAlignment="Left">
        <StackPanel Orientation="Horizontal">
          <Button Classes="segmented-item" Classes.active="{CompiledBinding IsSettingsSelected}"
                  Command="{CompiledBinding ShowSettingsCommand}">
            <TextBlock Text="{DynamicResource SettingsTabTitle}" />
          </Button>
          <Button Classes="segmented-item" Classes.active="{CompiledBinding IsAboutSelected}"
                  Command="{CompiledBinding ShowAboutCommand}">
            <TextBlock Text="{DynamicResource AboutTabTitle}" />
          </Button>
        </StackPanel>
      </Border>

      <!-- ===== 偏好设置：按外观、性能与行为归组 ===== -->
      <Grid IsVisible="{CompiledBinding IsSettingsSelected}" ColumnDefinitions="*,*" RowDefinitions="Auto,Auto"
            ColumnSpacing="16" RowSpacing="16">
        <Border Grid.Row="0" Grid.Column="0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                CornerRadius="16" Padding="18" BoxShadow="0 2 8 0 #0D000000">
          <StackPanel Spacing="16">
            <Grid ColumnDefinitions="Auto,*">
              <ic:SymbolIcon Symbol="WeatherSunny" FontSize="16" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
              <TextBlock Grid.Column="1" Text="{DynamicResource ThemeTitle}" FontWeight="Bold" FontSize="13" Margin="9,0,0,0"
                         Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
            </Grid>
            <Border Classes="segmented-group" HorizontalAlignment="Left">
              <StackPanel Orientation="Horizontal">
                <Button Classes="segmented-item" Classes.active="{CompiledBinding IsLightTheme}" Command="{CompiledBinding SetThemeCommand}" CommandParameter="Light">
                  <TextBlock Text="{DynamicResource ThemeLightOption}" />
                </Button>
                <Button Classes="segmented-item" Classes.active="{CompiledBinding IsDarkTheme}" Command="{CompiledBinding SetThemeCommand}" CommandParameter="Dark">
                  <TextBlock Text="{DynamicResource ThemeDarkOption}" />
                </Button>
                <Button Classes="segmented-item" Classes.active="{CompiledBinding IsAutoTheme}" Command="{CompiledBinding SetThemeCommand}" CommandParameter="Auto">
                  <TextBlock Text="{DynamicResource ThemeAutoOption}" />
                </Button>
              </StackPanel>
            </Border>
            <Border Height="1" Background="{DynamicResource LineBrush}" />
            <Grid ColumnDefinitions="Auto,*">
              <ic:SymbolIcon Symbol="Globe" FontSize="16" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
              <TextBlock Grid.Column="1" Text="{DynamicResource LangTitle}" FontWeight="Bold" FontSize="13" Margin="9,0,0,0"
                         Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
            </Grid>
            <Border Classes="segmented-group" HorizontalAlignment="Left">
              <StackPanel Orientation="Horizontal">
                <Button Classes="segmented-item" Classes.active="{CompiledBinding IsChineseLanguage}" Command="{CompiledBinding SetLanguageCommand}" CommandParameter="zh">
                  <TextBlock Text="{DynamicResource LangZhOption}" />
                </Button>
                <Button Classes="segmented-item" Classes.active="{CompiledBinding IsEnglishLanguage}" Command="{CompiledBinding SetLanguageCommand}" CommandParameter="en">
                  <TextBlock Text="{DynamicResource LangEnOption}" />
                </Button>
              </StackPanel>
            </Border>
          </StackPanel>
        </Border>

        <Border Grid.Row="0" Grid.Column="1" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                CornerRadius="16" Padding="18" BoxShadow="0 2 8 0 #0D000000">
          <StackPanel Spacing="14">
            <Grid ColumnDefinitions="Auto,*,Auto">
              <ic:SymbolIcon Symbol="Timer" FontSize="16" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
              <TextBlock Grid.Column="1" Text="{DynamicResource ConcurrencyTitle}" FontWeight="Bold" FontSize="13" Margin="9,0,0,0"
                         Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
              <NumericUpDown Grid.Column="2" Value="{CompiledBinding Concurrency, Mode=TwoWay}" Minimum="1" Maximum="16" Increment="1"
                             Width="112" Height="34" Padding="8,0" TextAlignment="Center" />
            </Grid>
            <TextBlock Text="{DynamicResource SettingsConcurrencyDesc}" FontSize="10" TextWrapping="Wrap" Foreground="{DynamicResource TextMutedBrush}" />
            <Border Height="1" Background="{DynamicResource LineBrush}" />
            <Grid ColumnDefinitions="Auto,*,Auto">
              <ic:SymbolIcon Symbol="Color" FontSize="16" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
              <TextBlock Grid.Column="1" Text="{DynamicResource SettingsHeicQualityTitle}" FontWeight="Bold" FontSize="13" Margin="9,0,0,0"
                         Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
              <TextBlock Grid.Column="2" Text="{CompiledBinding HeicQuality, StringFormat='{}{0}%'}" FontSize="12" FontWeight="Bold"
                         FontFamily="Consolas" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
            </Grid>
            <Slider Value="{CompiledBinding HeicQuality, Mode=TwoWay}" Minimum="50" Maximum="100" />
            <TextBlock Text="{DynamicResource SettingsHeicQualityDesc}" FontSize="10" TextWrapping="Wrap" Foreground="{DynamicResource TextMutedBrush}" />
          </StackPanel>
        </Border>

        <Border Grid.Row="1" Grid.ColumnSpan="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                CornerRadius="16" Padding="18" BoxShadow="0 2 8 0 #0D000000">
          <StackPanel Spacing="14">
            <Grid ColumnDefinitions="Auto,*,Auto">
              <ic:SymbolIcon Symbol="Alert" FontSize="16" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
              <StackPanel Grid.Column="1" Margin="9,0,0,0">
                <TextBlock Text="{DynamicResource NotifyOnCompleteTitle}" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBlock Text="{DynamicResource NotifyOnCompleteDesc}" FontSize="10" TextWrapping="Wrap" Foreground="{DynamicResource TextMutedBrush}" />
              </StackPanel>
              <ToggleSwitch Grid.Column="2" IsChecked="{CompiledBinding NotifyOnComplete, Mode=TwoWay}" OnContent="" OffContent="" MinWidth="0" Padding="0" VerticalAlignment="Center" />
            </Grid>
            <Border Height="1" Background="{DynamicResource LineBrush}" />
            <Grid ColumnDefinitions="Auto,*,Auto">
              <ic:SymbolIcon Symbol="FolderOpen" FontSize="16" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
              <StackPanel Grid.Column="1" Margin="9,0,0,0">
                <TextBlock Text="{DynamicResource AutoOpenOutputTitle}" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBlock Text="{DynamicResource AutoOpenOutputDesc}" FontSize="10" TextWrapping="Wrap" Foreground="{DynamicResource TextMutedBrush}" />
              </StackPanel>
              <ToggleSwitch Grid.Column="2" IsChecked="{CompiledBinding AutoOpenOutput, Mode=TwoWay}" OnContent="" OffContent="" MinWidth="0" Padding="0" VerticalAlignment="Center" />
            </Grid>
            <Border Height="1" Background="{DynamicResource LineBrush}" />
            <Grid ColumnDefinitions="Auto,*,Auto">
              <ic:SymbolIcon Symbol="Broom" FontSize="16" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
              <StackPanel Grid.Column="1" Margin="9,0,0,0">
                <TextBlock Text="{DynamicResource AutoCleanTempTitle}" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBlock Text="{DynamicResource AutoCleanTempDesc}" FontSize="10" TextWrapping="Wrap" Foreground="{DynamicResource TextMutedBrush}" />
              </StackPanel>
              <ToggleSwitch Grid.Column="2" IsChecked="{CompiledBinding AutoCleanTemp, Mode=TwoWay}" OnContent="" OffContent="" MinWidth="0" Padding="0" VerticalAlignment="Center" />
            </Grid>
          </StackPanel>
        </Border>
      </Grid>

      <!-- ===== 关于 ===== -->
      <StackPanel IsVisible="{CompiledBinding IsAboutSelected}" Spacing="14" Margin="0,8,0,0">

        <!-- 项目标识 -->
        <StackPanel Spacing="8" HorizontalAlignment="Center">
          <Border Width="54" Height="54" CornerRadius="16" Background="{DynamicResource AccentSoftBrush}"
                  BorderBrush="{DynamicResource AccentBorderBrush}" BorderThickness="1">
            <ic:SymbolIcon Symbol="Camera" FontSize="26" Foreground="{DynamicResource AccentBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <TextBlock Text="LivePhotoConvert" FontSize="17" FontWeight="Bold"
                     Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center" />
          <TextBlock Text="{DynamicResource AppSubtitle}" FontSize="11"
                     Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" />
          <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
            <Border Background="{DynamicResource HoverBrush}" CornerRadius="6" Padding="8,3">
              <TextBlock FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}">
                <Run Text="{DynamicResource AboutVersionLabel}" />
                <Run Text=" " />
                <Run Text="{CompiledBinding AppVersion}" />
              </TextBlock>
            </Border>
            <Border Background="{DynamicResource SuccessSoftBrush}" BorderBrush="{DynamicResource SuccessBorderBrush}"
                    BorderThickness="1" CornerRadius="6" Padding="8,3">
              <TextBlock Text="{CompiledBinding LicenseName}" FontSize="10" FontWeight="SemiBold"
                         Foreground="{DynamicResource SuccessBrush}" />
            </Border>
          </StackPanel>
        </StackPanel>

        <!-- 作者 -->
        <Border Background="{DynamicResource HoverBrush}" CornerRadius="12" Padding="12,10" MaxWidth="1000" HorizontalAlignment="Stretch">
          <Grid ColumnDefinitions="Auto,*,Auto">
            <ic:SymbolIcon Grid.Column="0" Symbol="Person" FontSize="16" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
            <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
              <TextBlock Text="{DynamicResource AboutAuthorLabel}" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" />
              <TextBlock Text="{CompiledBinding AuthorName}" FontSize="12" FontWeight="SemiBold"
                         Foreground="{DynamicResource TextPrimaryBrush}" />
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
              <Button Classes="sponsor-btn" Command="{CompiledBinding OpenSponsorDialogCommand}">
                <StackPanel Orientation="Horizontal" Spacing="5" HorizontalAlignment="Center" VerticalAlignment="Center">
                  <ic:SymbolIcon Symbol="Heart" FontSize="12" VerticalAlignment="Center" />
                  <TextBlock Text="{DynamicResource AboutSponsorTitle}" FontSize="10.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
              <Button Classes="toolbar-btn" Height="28" Padding="10,0"
                      Command="{CompiledBinding OpenUrlCommand}" CommandParameter="{x:Static models:AboutInfo.AuthorUrl}">
                <TextBlock Text="{DynamicResource AboutAuthorHomeBtn}" FontSize="11" FontWeight="SemiBold" />
              </Button>
              <Button Classes="toolbar-btn" Height="28" Padding="9,0"
                      Command="{CompiledBinding OpenUrlCommand}" CommandParameter="{x:Static models:AboutInfo.RepositoryUrl}">
                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                  <ic:SymbolIcon Symbol="BranchFork" FontSize="11" VerticalAlignment="Center" />
                  <TextBlock Text="{DynamicResource AboutRepoBtn}" FontSize="10.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
              <Button Classes="toolbar-btn" Height="28" Padding="9,0"
                      Command="{CompiledBinding OpenUrlCommand}" CommandParameter="{x:Static models:AboutInfo.IssuesUrl}">
                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                  <ic:SymbolIcon Symbol="Info" FontSize="11" VerticalAlignment="Center" />
                  <TextBlock Text="{DynamicResource AboutIssuesBtn}" FontSize="10.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
              <Button Classes="toolbar-btn" Height="28" Padding="9,0"
                      Command="{CompiledBinding OpenUrlCommand}" CommandParameter="{x:Static models:AboutInfo.ReleasesUrl}">
                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                  <ic:SymbolIcon Symbol="Open" FontSize="11" VerticalAlignment="Center" />
                  <TextBlock Text="{DynamicResource AboutReleasesBtn}" FontSize="10.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
            </StackPanel>
          </Grid>
        </Border>

        <!-- 开源协议 -->
        <StackPanel Spacing="6">
          <TextBlock Text="{DynamicResource AboutLicenseTitle}" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
          <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="12" Padding="12" MaxWidth="1000" HorizontalAlignment="Stretch">
            <StackPanel Spacing="6">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" Text="{CompiledBinding LicenseName}" FontSize="12" FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                <Button Grid.Column="1" Classes="toolbar-btn" Height="26" Padding="10,0"
                        Command="{CompiledBinding OpenUrlCommand}" CommandParameter="{x:Static models:AboutInfo.LicenseUrl}">
                  <TextBlock Text="{DynamicResource AboutViewLicenseBtn}" FontSize="10.5" FontWeight="SemiBold" />
                </Button>
              </Grid>
              <TextBlock Text="{DynamicResource AboutLicenseDesc}" FontSize="10.5" LineHeight="16" TextWrapping="Wrap"
                         Foreground="{DynamicResource TextTertiaryBrush}" />
              <TextBlock Text="{DynamicResource AboutCopyrightLine}" FontSize="10"
                         Foreground="{DynamicResource TextMutedBrush}" />
            </StackPanel>
          </Border>
        </StackPanel>

        <!-- 贡献者 -->
        <StackPanel Spacing="6">
          <TextBlock Text="{DynamicResource AboutContributorsTitle}" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
          <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="12" Padding="6" MaxWidth="1000" HorizontalAlignment="Stretch">
            <ItemsControl ItemsSource="{CompiledBinding Contributors}" ItemTemplate="{StaticResource AboutCreditRowTemplate}" />
          </Border>
          <TextBlock Text="{DynamicResource AboutContributorsHint}" FontSize="10" TextWrapping="Wrap"
                     Foreground="{DynamicResource TextMutedBrush}" />
        </StackPanel>

        <!-- 引用的开源项目：运行时引擎 -->
        <StackPanel Spacing="6">
          <TextBlock Text="{DynamicResource AboutCreditsRuntimeTitle}" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
          <TextBlock Text="{DynamicResource AboutCreditsRuntimeDesc}" FontSize="10" TextWrapping="Wrap"
                     Foreground="{DynamicResource TextMutedBrush}" />
          <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="12" Padding="6" MaxWidth="1000" HorizontalAlignment="Stretch">
            <ItemsControl ItemsSource="{CompiledBinding RuntimeCredits}" ItemTemplate="{StaticResource AboutCreditRowTemplate}" />
          </Border>
        </StackPanel>

        <!-- 引用的开源项目：构建框架 -->
        <StackPanel Spacing="6">
          <TextBlock Text="{DynamicResource AboutCreditsBuildTitle}" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
          <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="12" Padding="6" MaxWidth="1000" HorizontalAlignment="Stretch">
            <ItemsControl ItemsSource="{CompiledBinding BuildCredits}" ItemTemplate="{StaticResource AboutCreditRowTemplate}" />
          </Border>
        </StackPanel>

      </StackPanel>

    </StackPanel>
  </ScrollViewer>

  <!-- 居中赞赏弹窗：遮罩区域独立承接点击，点击二维码卡片不会意外关闭。 -->
  <Grid IsVisible="{CompiledBinding IsSponsorDialogOpen}">
    <Button Classes="sponsor-dialog-backdrop" Command="{CompiledBinding CloseSponsorDialogCommand}" />
    <Border Classes="sponsor-dialog" HorizontalAlignment="Center" VerticalAlignment="Center">
      <StackPanel Spacing="14" HorizontalAlignment="Center">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Spacing="3">
            <TextBlock Text="{DynamicResource AboutSponsorTitle}" FontSize="16" FontWeight="Bold"
                       Foreground="{DynamicResource TextPrimaryBrush}" />
            <TextBlock Text="{DynamicResource AboutSponsorDesc}" FontSize="11" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextTertiaryBrush}" />
          </StackPanel>
          <Button Grid.Column="1" Classes="sponsor-dialog-close" Command="{CompiledBinding CloseSponsorDialogCommand}">
            <ic:SymbolIcon Symbol="Dismiss" FontSize="16" />
          </Button>
        </Grid>
        <Border Background="White" CornerRadius="10" Padding="8" HorizontalAlignment="Center">
          <Image Source="avares://LivePhotoConvert.Desktop/Assets/sponsor-qrcode.png" Width="340" Height="340" Stretch="Uniform" />
        </Border>
      </StackPanel>
    </Border>
  </Grid>
  </Grid>
</UserControl>
