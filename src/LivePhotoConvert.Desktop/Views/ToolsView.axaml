<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:LivePhotoConvert.Desktop.ViewModels"
             xmlns:ic="using:FluentIcons.Avalonia"
             x:Class="LivePhotoConvert.Desktop.Views.ToolsView"
             x:CompileBindings="True"
             x:DataType="vm:ToolsViewModel">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="24" Spacing="16">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Spacing="4">
          <TextBlock Text="{DynamicResource ToolsTitle}" FontWeight="Bold" FontSize="18" Foreground="{DynamicResource TextPrimaryBrush}" />
          <TextBlock Text="{DynamicResource ToolsDesc}" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" />
        </StackPanel>
        <Button Grid.Column="1" Classes="primary-btn" Command="{Binding RescanToolsCommand}" Padding="14,8">
          <StackPanel Orientation="Horizontal" Spacing="6"><ic:SymbolIcon Symbol="ArrowSync" FontSize="13" Foreground="{DynamicResource OnAccentBrush}" /><TextBlock Text="{DynamicResource RescanToolsBtn}" FontSize="11" FontWeight="Bold" /></StackPanel>
        </Button>
      </Grid>

      <Border Background="{DynamicResource AccentSoftBrush}" BorderBrush="{DynamicResource AccentBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="12,9">
        <Grid ColumnDefinitions="Auto,*,Auto">
          <ic:SymbolIcon Symbol="ShieldCheckmark" Grid.Column="0" FontSize="16" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
          <StackPanel Grid.Column="1" Margin="10,0,0,0" Spacing="2"><TextBlock Text="{DynamicResource ToolsTitle}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentTextBrush}" /><TextBlock Text="{DynamicResource ToolsDesc}" FontSize="10" Foreground="{DynamicResource AccentTextBrush}" Opacity="0.8" /></StackPanel>
          <TextBlock Grid.Column="2" Text="{Binding InstallProgressText}" FontSize="10" FontFamily="Consolas" Foreground="{DynamicResource AccentTextBrush}" VerticalAlignment="Center" IsVisible="{Binding IsInstallingAny}" />
        </Grid>
      </Border>

      <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">
        <Border Grid.Column="0" Classes="engine-card"><StackPanel Spacing="10">
          <Grid ColumnDefinitions="*,Auto"><TextBlock Text="ExifTool" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" /><Border Grid.Column="1" Classes="status-pill success" IsVisible="{Binding IsExifToolReady}"><TextBlock Text="{Binding ExifToolVersion}" FontSize="10" FontWeight="Bold" /></Border><Border Grid.Column="1" Classes="status-pill danger" IsVisible="{Binding !IsExifToolReady}"><TextBlock Text="{DynamicResource ToolNotInstalled}" FontSize="10" FontWeight="Bold" /></Border></Grid>
          <TextBlock Text="{DynamicResource ExifToolDesc}" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" TextWrapping="Wrap" />
          <Border Classes="engine-path"><TextBlock Text="{Binding ExifToolPath}" FontSize="10" FontFamily="Consolas" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding ExifToolPath}" /></Border>
          <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding !IsExifToolReady}"><Button Grid.Column="0" Classes="engine-install-btn" Command="{Binding InstallExifToolCommand}" IsEnabled="{Binding !IsInstallingAny}" IsVisible="{Binding !IsInstallingExifTool}"><TextBlock Text="{DynamicResource InstallToolBtn}" /></Button><Button Grid.Column="0" Classes="engine-install-btn" IsEnabled="False" Opacity="0.6" IsVisible="{Binding IsInstallingExifTool}"><TextBlock Text="{DynamicResource InstallingStatus}" /></Button><Button Grid.Column="1" Classes="toolbar-btn" Command="{Binding CancelInstallCommand}" Margin="8,0,0,0" IsVisible="{Binding IsInstallingExifTool}"><TextBlock Text="{DynamicResource CancelBtn}" /></Button></Grid>
          <Button Classes="engine-path-btn" Command="{Binding PickExifToolPathCommand}"><TextBlock Text="{DynamicResource CustomPathBtn}" /></Button>
        </StackPanel></Border>

        <Border Grid.Column="1" Classes="engine-card"><StackPanel Spacing="10">
          <Grid ColumnDefinitions="*,Auto"><TextBlock Text="FFmpeg" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" /><Border Grid.Column="1" Classes="status-pill success" IsVisible="{Binding IsFfmpegReady}"><TextBlock Text="{Binding FfmpegVersion}" FontSize="10" FontWeight="Bold" TextTrimming="CharacterEllipsis" MaxWidth="125" /></Border><Border Grid.Column="1" Classes="status-pill danger" IsVisible="{Binding !IsFfmpegReady}"><TextBlock Text="{DynamicResource ToolNotInstalled}" FontSize="10" FontWeight="Bold" /></Border></Grid>
          <TextBlock Text="{DynamicResource FfmpegDesc}" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" TextWrapping="Wrap" />
          <Border Classes="engine-path"><TextBlock Text="{Binding FfmpegPath}" FontSize="10" FontFamily="Consolas" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding FfmpegPath}" /></Border>
          <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding !IsFfmpegReady}"><Button Grid.Column="0" Classes="engine-install-btn" Command="{Binding InstallFfmpegCommand}" IsEnabled="{Binding !IsInstallingAny}" IsVisible="{Binding !IsInstallingFfmpeg}"><TextBlock Text="{DynamicResource InstallToolBtn}" /></Button><Button Grid.Column="0" Classes="engine-install-btn" IsEnabled="False" Opacity="0.6" IsVisible="{Binding IsInstallingFfmpeg}"><TextBlock Text="{DynamicResource InstallingStatus}" /></Button><Button Grid.Column="1" Classes="toolbar-btn" Command="{Binding CancelInstallCommand}" Margin="8,0,0,0" IsVisible="{Binding IsInstallingFfmpeg}"><TextBlock Text="{DynamicResource CancelBtn}" /></Button></Grid>
          <Button Classes="engine-path-btn" Command="{Binding PickFfmpegPathCommand}"><TextBlock Text="{DynamicResource CustomPathBtn}" /></Button>
        </StackPanel></Border>

        <Border Grid.Column="2" Classes="engine-card"><StackPanel Spacing="10">
          <Grid ColumnDefinitions="*,Auto"><TextBlock Text="heif-enc" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" /><Border Grid.Column="1" Classes="status-pill success" IsVisible="{Binding IsHeifEncReady}"><TextBlock Text="{Binding HeifEncVersion}" FontSize="10" FontWeight="Bold" /></Border><Border Grid.Column="1" Classes="status-pill danger" IsVisible="{Binding !IsHeifEncReady}"><TextBlock Text="{DynamicResource ToolNotInstalled}" FontSize="10" FontWeight="Bold" /></Border></Grid>
          <TextBlock Text="{DynamicResource HeifEncDesc}" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" TextWrapping="Wrap" />
          <Border Classes="engine-path"><TextBlock Text="{Binding HeifEncPath}" FontSize="10" FontFamily="Consolas" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding HeifEncPath}" /></Border>
          <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding !IsHeifEncReady}"><Button Grid.Column="0" Classes="engine-install-btn" Command="{Binding InstallHeifEncCommand}" IsEnabled="{Binding !IsInstallingAny}" IsVisible="{Binding !IsInstallingHeifEnc}"><TextBlock Text="{DynamicResource InstallToolBtn}" /></Button><Button Grid.Column="0" Classes="engine-install-btn" IsEnabled="False" Opacity="0.6" IsVisible="{Binding IsInstallingHeifEnc}"><TextBlock Text="{DynamicResource InstallingStatus}" /></Button><Button Grid.Column="1" Classes="toolbar-btn" Command="{Binding CancelInstallCommand}" Margin="8,0,0,0" IsVisible="{Binding IsInstallingHeifEnc}"><TextBlock Text="{DynamicResource CancelBtn}" /></Button></Grid>
          <Button Classes="engine-path-btn" Command="{Binding PickHeifEncPathCommand}"><TextBlock Text="{DynamicResource CustomPathBtn}" /></Button>
        </StackPanel></Border>
      </Grid>

      <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="14" Padding="16"><StackPanel Spacing="12">
        <StackPanel Spacing="2"><TextBlock Text="{DynamicResource MirrorTitle}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" /><TextBlock Text="{DynamicResource MirrorDesc}" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" /></StackPanel>
        <Grid ColumnDefinitions="240,*,Auto" ColumnSpacing="10"><ComboBox Grid.Column="0" Classes="engine-select" ItemsSource="{Binding MirrorPresets}" SelectedItem="{Binding SelectedMirrorPreset, Mode=TwoWay}"><ComboBox.ItemTemplate><DataTemplate x:DataType="vm:MirrorPreset"><TextBlock Text="{Binding Name}" FontSize="12" /></DataTemplate></ComboBox.ItemTemplate></ComboBox><TextBox Grid.Column="1" Text="{Binding CustomMirrorUrl, Mode=TwoWay}" FontSize="11" FontFamily="Consolas" Padding="10,8" /><Button Grid.Column="2" Classes="toolbar-btn" Command="{Binding TestMirrorSpeedCommand}" Padding="12,0"><TextBlock Text="{DynamicResource TestPingBtn}" FontSize="11" FontWeight="Bold" /></Button></Grid>
        <StackPanel Orientation="Horizontal" Spacing="4"><TextBlock Text="{DynamicResource PingLatencyLabel}" FontSize="11" Foreground="{DynamicResource SuccessBrush}" FontWeight="Bold" /><TextBlock Text="{Binding PingLatencyText}" FontSize="11" Foreground="{DynamicResource SuccessBrush}" FontFamily="Consolas" /></StackPanel>
      </StackPanel></Border>

      <Border Background="{DynamicResource CanvasBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="10" Padding="12,9" IsVisible="{Binding HasActionMessage}"><TextBlock Text="{Binding ActionMessageText}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" /></Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
