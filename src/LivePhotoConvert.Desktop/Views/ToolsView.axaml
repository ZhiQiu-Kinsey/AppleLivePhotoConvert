<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:LivePhotoConvert.Desktop.ViewModels"
             x:Class="LivePhotoConvert.Desktop.Views.ToolsView"
             x:CompileBindings="True"
             x:DataType="vm:ToolsViewModel"
        xmlns:ic="using:FluentIcons.Avalonia">

  <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
    <StackPanel Spacing="20" Margin="24" HorizontalAlignment="Stretch">
      <!-- 头部 -->
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Grid.Column="0" Spacing="4">
          <TextBlock Text="{DynamicResource ToolsTitle}" FontWeight="Bold" FontSize="16" Foreground="{DynamicResource TextPrimaryBrush}" />
          <TextBlock Text="{DynamicResource ToolsDesc}" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" />
        </StackPanel>
        <Button Grid.Column="1" Classes="primary-btn" Command="{Binding RescanToolsCommand}">
          <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
            <ic:SymbolIcon Symbol="ArrowSync" FontSize="12" Foreground="{DynamicResource OnAccentBrush}" VerticalAlignment="Center" Margin="0,1,0,0"/>
            <TextBlock Text="{DynamicResource RescanToolsBtn}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
      </Grid>

      <!-- 依赖引擎卡片 3 列网格 -->
      <Grid ColumnDefinitions="*,*,*">
        <!-- ExifTool -->
        <Border Grid.Column="0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="16" Padding="16" Margin="0,0,6,0"
                BoxShadow="0 2 8 0 #0D000000">
          <StackPanel Spacing="10">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Grid.Column="0" Text="ExifTool" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}" />
              <Panel Grid.Column="1" HorizontalAlignment="Right">
                <Border Background="{DynamicResource SuccessSoftBrush}" BorderBrush="{DynamicResource SuccessBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="6,2"
                        IsVisible="{Binding IsExifToolReady}">
                  <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                    <ic:SymbolIcon Symbol="Checkmark" FontSize="10" Foreground="{DynamicResource SuccessBrush}" VerticalAlignment="Center" Margin="0,1,0,0"/>
                    <TextBlock Text="{Binding ExifToolVersion}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}" MaxWidth="120" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding ExifToolVersion}" VerticalAlignment="Center"/>
                  </StackPanel>
                </Border>
                <Border Background="{DynamicResource DangerSoftBrush}" BorderBrush="{DynamicResource DangerBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="6,2"
                        IsVisible="{Binding !IsExifToolReady}">
                  <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                    <ic:SymbolIcon Symbol="Warning" FontSize="10" Foreground="{DynamicResource DangerBrush}" VerticalAlignment="Center" Margin="0,1,0,0"/>
                    <TextBlock Text="{Binding ExifToolVersion}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource DangerBrush}" VerticalAlignment="Center"/>
                  </StackPanel>
                </Border>
              </Panel>
            </Grid>
            <TextBlock Text="{DynamicResource ExifToolDesc}" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" TextWrapping="Wrap" />
            <Border Background="{DynamicResource CanvasBrush}" CornerRadius="8" Padding="8">
              <TextBlock Text="{Binding ExifToolPath}" FontSize="10" FontFamily="Consolas" Foreground="{DynamicResource TextTertiaryBrush}" TextTrimming="CharacterEllipsis" />
            </Border>

            <!-- 未就绪时一键安装；下载期间按钮禁用并展示实时进度 -->
            <StackPanel Spacing="6" IsVisible="{Binding !IsExifToolReady}">
              <Grid ColumnDefinitions="*,Auto">
                <Button Grid.Column="0" Classes="primary-btn" Height="32" Padding="0"
                        Command="{Binding InstallExifToolCommand}" IsEnabled="{Binding !IsInstallingAny}"
                        IsVisible="{Binding !IsInstallingExifTool}">
                  <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ic:SymbolIcon Symbol="ArrowDownload" FontSize="13" Foreground="{DynamicResource OnAccentBrush}" VerticalAlignment="Center" Margin="0,1,0,0"/>
                    <TextBlock Text="{DynamicResource InstallToolBtn}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>
                <Button Grid.Column="0" Classes="primary-btn" Height="32" Padding="0" IsEnabled="False" Opacity="0.6"
                        IsVisible="{Binding IsInstallingExifTool}">
                  <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ic:SymbolIcon Symbol="ArrowDownload" FontSize="13" Foreground="{DynamicResource OnAccentBrush}" VerticalAlignment="Center" Margin="0,1,0,0"/>
                    <TextBlock Text="{DynamicResource InstallingStatus}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>
                <Button Grid.Column="1" Classes="toolbar-btn" Height="32" Padding="10,0" Margin="6,0,0,0"
                        Command="{Binding CancelInstallCommand}" IsVisible="{Binding IsInstallingExifTool}">
                  <TextBlock Text="{DynamicResource CancelBtn}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                </Button>
              </Grid>
              <TextBlock Text="{Binding InstallProgressText}" FontSize="10" FontFamily="Consolas"
                         Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center"
                         IsVisible="{Binding IsInstallingExifTool}" />
            </StackPanel>

            <Button Classes="nav-btn" Padding="0" Height="28" Command="{Binding PickExifToolPathCommand}">
              <TextBlock Text="{DynamicResource CustomPathBtn}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />
            </Button>
          </StackPanel>
        </Border>

        <!-- FFmpeg -->
        <Border Grid.Column="1" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="16" Padding="16" Margin="3,0,3,0"
                BoxShadow="0 2 8 0 #0D000000">
          <StackPanel Spacing="10">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Grid.Column="0" Text="FFmpeg" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}" />
              <Panel Grid.Column="1" HorizontalAlignment="Right">
                <Border Background="{DynamicResource SuccessSoftBrush}" BorderBrush="{DynamicResource SuccessBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="6,2"
                        IsVisible="{Binding IsFfmpegReady}">
                  <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                    <ic:SymbolIcon Symbol="Checkmark" FontSize="10" Foreground="{DynamicResource SuccessBrush}" VerticalAlignment="Center" Margin="0,1,0,0"/>
                    <TextBlock Text="{Binding FfmpegVersion}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}" MaxWidth="120" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding FfmpegVersion}" VerticalAlignment="Center"/>
                  </StackPanel>
                </Border>
                <Border Background="{DynamicResource DangerSoftBrush}" BorderBrush="{DynamicResource DangerBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="6,2"
                        IsVisible="{Binding !IsFfmpegReady}">
                  <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                    <ic:SymbolIcon Symbol="Warning" FontSize="10" Foreground="{DynamicResource DangerBrush}" VerticalAlignment="Center" Margin="0,1,0,0"/>
                    <TextBlock Text="{Binding FfmpegVersion}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource DangerBrush}" VerticalAlignment="Center"/>
                  </StackPanel>
                </Border>
              </Panel>
            </Grid>
            <TextBlock Text="{DynamicResource FfmpegDesc}" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" TextWrapping="Wrap" />
            <Border Background="{DynamicResource CanvasBrush}" CornerRadius="8" Padding="8">
              <TextBlock Text="{Binding FfmpegPath}" FontSize="10" FontFamily="Consolas" Foreground="{DynamicResource TextTertiaryBrush}" TextTrimming="CharacterEllipsis" />
            </Border>

            <!-- 未就绪时一键安装；下载期间按钮禁用并展示实时进度 -->
            <StackPanel Spacing="6" IsVisible="{Binding !IsFfmpegReady}">
              <Grid ColumnDefinitions="*,Auto">
                <Button Grid.Column="0" Classes="primary-btn" Height="32" Padding="0"
                        Command="{Binding InstallFfmpegCommand}" IsEnabled="{Binding !IsInstallingAny}"
                        IsVisible="{Binding !IsInstallingFfmpeg}">
                  <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ic:SymbolIcon Symbol="ArrowDownload" FontSize="13" Foreground="{DynamicResource OnAccentBrush}" VerticalAlignment="Center" Margin="0,1,0,0"/>
                    <TextBlock Text="{DynamicResource InstallToolBtn}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>
                <Button Grid.Column="0" Classes="primary-btn" Height="32" Padding="0" IsEnabled="False" Opacity="0.6"
                        IsVisible="{Binding IsInstallingFfmpeg}">
                  <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ic:SymbolIcon Symbol="ArrowDownload" FontSize="13" Foreground="{DynamicResource OnAccentBrush}" VerticalAlignment="Center" Margin="0,1,0,0"/>
                    <TextBlock Text="{DynamicResource InstallingStatus}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>
                <Button Grid.Column="1" Classes="toolbar-btn" Height="32" Padding="10,0" Margin="6,0,0,0"
                        Command="{Binding CancelInstallCommand}" IsVisible="{Binding IsInstallingFfmpeg}">
                  <TextBlock Text="{DynamicResource CancelBtn}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                </Button>
              </Grid>
              <TextBlock Text="{Binding InstallProgressText}" FontSize="10" FontFamily="Consolas"
                         Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center"
                         IsVisible="{Binding IsInstallingFfmpeg}" />
            </StackPanel>

            <Button Classes="nav-btn" Padding="0" Height="28" Command="{Binding PickFfmpegPathCommand}">
              <TextBlock Text="{DynamicResource CustomPathBtn}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />
            </Button>
          </StackPanel>
        </Border>

        <!-- heif-enc -->
        <Border Grid.Column="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="16" Padding="16" Margin="6,0,0,0"
                BoxShadow="0 2 8 0 #0D000000">
          <StackPanel Spacing="10">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Grid.Column="0" Text="heif-enc" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}" />
              <Panel Grid.Column="1" HorizontalAlignment="Right">
                <Border Background="{DynamicResource SuccessSoftBrush}" BorderBrush="{DynamicResource SuccessBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="6,2"
                        IsVisible="{Binding IsHeifEncReady}">
                  <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                    <ic:SymbolIcon Symbol="Checkmark" FontSize="10" Foreground="{DynamicResource SuccessBrush}" VerticalAlignment="Center" Margin="0,1,0,0"/>
                    <TextBlock Text="{Binding HeifEncVersion}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}" MaxWidth="120" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding HeifEncVersion}" VerticalAlignment="Center"/>
                  </StackPanel>
                </Border>
                <Border Background="{DynamicResource DangerSoftBrush}" BorderBrush="{DynamicResource DangerBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="6,2"
                        IsVisible="{Binding !IsHeifEncReady}">
                  <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                    <ic:SymbolIcon Symbol="Warning" FontSize="10" Foreground="{DynamicResource DangerBrush}" VerticalAlignment="Center" Margin="0,1,0,0"/>
                    <TextBlock Text="{Binding HeifEncVersion}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource DangerBrush}" VerticalAlignment="Center"/>
                  </StackPanel>
                </Border>
              </Panel>
            </Grid>
            <TextBlock Text="{DynamicResource HeifEncDesc}" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" TextWrapping="Wrap" />
            <Border Background="{DynamicResource CanvasBrush}" CornerRadius="8" Padding="8">
              <TextBlock Text="{Binding HeifEncPath}" FontSize="10" FontFamily="Consolas" Foreground="{DynamicResource TextTertiaryBrush}" TextTrimming="CharacterEllipsis" />
            </Border>

            <!-- 未就绪时一键安装；下载期间按钮禁用并展示实时进度 -->
            <StackPanel Spacing="6" IsVisible="{Binding !IsHeifEncReady}">
              <Grid ColumnDefinitions="*,Auto">
                <Button Grid.Column="0" Classes="primary-btn" Height="32" Padding="0"
                        Command="{Binding InstallHeifEncCommand}" IsEnabled="{Binding !IsInstallingAny}"
                        IsVisible="{Binding !IsInstallingHeifEnc}">
                  <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ic:SymbolIcon Symbol="ArrowDownload" FontSize="13" Foreground="{DynamicResource OnAccentBrush}" VerticalAlignment="Center" Margin="0,1,0,0"/>
                    <TextBlock Text="{DynamicResource InstallToolBtn}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>
                <Button Grid.Column="0" Classes="primary-btn" Height="32" Padding="0" IsEnabled="False" Opacity="0.6"
                        IsVisible="{Binding IsInstallingHeifEnc}">
                  <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ic:SymbolIcon Symbol="ArrowDownload" FontSize="13" Foreground="{DynamicResource OnAccentBrush}" VerticalAlignment="Center" Margin="0,1,0,0"/>
                    <TextBlock Text="{DynamicResource InstallingStatus}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>
                <Button Grid.Column="1" Classes="toolbar-btn" Height="32" Padding="10,0" Margin="6,0,0,0"
                        Command="{Binding CancelInstallCommand}" IsVisible="{Binding IsInstallingHeifEnc}">
                  <TextBlock Text="{DynamicResource CancelBtn}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                </Button>
              </Grid>
              <TextBlock Text="{Binding InstallProgressText}" FontSize="10" FontFamily="Consolas"
                         Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center"
                         IsVisible="{Binding IsInstallingHeifEnc}" />
            </StackPanel>

            <Button Classes="nav-btn" Padding="0" Height="28" Command="{Binding PickHeifEncPathCommand}">
              <TextBlock Text="{DynamicResource CustomPathBtn}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />
            </Button>
          </StackPanel>
        </Border>
      </Grid>

      <!-- 引擎操作结果提示（安装完成 / 失败原因 / 自定义路径结果） -->
      <Border Background="{DynamicResource CanvasBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
              CornerRadius="10" Padding="12,8" IsVisible="{Binding HasActionMessage}">
        <Grid ColumnDefinitions="Auto,*">
          <ic:SymbolIcon Grid.Column="0" Symbol="CheckmarkCircle" FontSize="13" Foreground="{DynamicResource SuccessBrush}"
                         VerticalAlignment="Center" Margin="0,1,0,0" IsVisible="{Binding !IsActionMessageError}" />
          <ic:SymbolIcon Grid.Column="0" Symbol="ErrorCircle" FontSize="13" Foreground="{DynamicResource DangerBrush}"
                         VerticalAlignment="Center" Margin="0,1,0,0" IsVisible="{Binding IsActionMessageError}" />
          <TextBlock Grid.Column="1" Text="{Binding ActionMessageText}" FontSize="11" TextWrapping="Wrap"
                     Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="8,0,0,0" />
        </Grid>
      </Border>

      <!-- GitHub 加速镜像设置 -->
      <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="20" Padding="20"
              BoxShadow="0 2 8 0 #0D000000">
        <StackPanel Spacing="14">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Grid.Column="0" Spacing="2">
              <TextBlock Text="{DynamicResource MirrorTitle}" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}" />
              <TextBlock Text="{DynamicResource MirrorDesc}" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" />
            </StackPanel>
            <ToggleSwitch Grid.Column="1" IsChecked="{Binding AutoDownload, Mode=TwoWay}"
                          Content="{DynamicResource AutoDownloadLabel}" FontSize="11" />
          </Grid>

          <!-- 镜像预设选择与自定义 URL 输入 -->
          <Grid ColumnDefinitions="260,*,Auto">
            <!-- 预设镜像下拉框 -->
            <ComboBox Grid.Column="0" ItemsSource="{Binding MirrorPresets}"
                      SelectedItem="{Binding SelectedMirrorPreset, Mode=TwoWay}"
                      HorizontalAlignment="Stretch">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="vm:MirrorPreset">
                  <TextBlock Text="{Binding Name}" FontSize="12" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>

            <!-- 自定义/当前镜像 URL 文本框 -->
            <TextBox Grid.Column="1" Text="{Binding CustomMirrorUrl, Mode=TwoWay}"
                     FontSize="11" FontFamily="Consolas" CornerRadius="8" Padding="10,7" Margin="10,0,0,0" />

            <!-- 测速按钮 -->
            <Button Grid.Column="2" Classes="toolbar-btn" Command="{Binding TestMirrorSpeedCommand}" Margin="10,0,0,0" Padding="12,6">
              <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <Border Width="8" Height="8" CornerRadius="4" Background="{DynamicResource SuccessBrush}" VerticalAlignment="Center" Margin="0,1,0,0"/>
                <TextBlock Text="{DynamicResource TestPingBtn}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
          </Grid>

          <!-- 延迟状态 -->
          <StackPanel Orientation="Horizontal" Spacing="4">
            <TextBlock Text="{DynamicResource PingLatencyLabel}" FontSize="11" Foreground="{DynamicResource SuccessBrush}" FontWeight="Bold" />
            <TextBlock Text="{Binding PingLatencyText}" FontSize="11" Foreground="{DynamicResource SuccessBrush}" FontWeight="Bold" FontFamily="Consolas" />
          </StackPanel>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
