<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="LivePhotoConvert.Desktop.App"
             RequestedThemeVariant="Light">

  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://LivePhotoConvert/Assets/Styles.axaml" />
  </Application.Styles>

  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://LivePhotoConvert/Assets/Strings.zh-CN.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>

</Application>
