<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dialogs="using:LivePhotoConvert.Desktop.Features.Dialogs"
             xmlns:ic="using:FluentIcons.Avalonia"
             xmlns:controls="using:LivePhotoConvert.Desktop.Controls"
             xmlns:infra="using:LivePhotoConvert.Desktop.Infrastructure"
             x:Class="LivePhotoConvert.Desktop.Features.Dialogs.ArbitrateDialog"
             x:CompileBindings="True"
             x:DataType="dialogs:ArbitrateDialogViewModel">

  <Border Classes="dialog-card" MaxWidth="600" BorderBrush="{DynamicResource WarningBorderBrush}">
    <StackPanel Spacing="16">
      <!-- 标题 -->
      <Grid ColumnDefinitions="Auto,*,Auto">
        <Border Grid.Column="0" Classes="dialog-icon-badge warning">
          <ic:SymbolIcon Symbol="Scales" FontSize="18" Foreground="{DynamicResource WarningBrush}" />
        </Border>
        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
          <TextBlock Text="{DynamicResource ArbitrateDialogTitle}" FontWeight="Black" FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}" />
          <TextBlock Text="{DynamicResource ArbitrateDialogDesc}" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource TextTertiaryBrush}" />
        </StackPanel>
        <Button Grid.Column="2" Classes="dialog-close-btn" Command="{CompiledBinding CancelCommand}" VerticalAlignment="Top"
                controls:ShortcutTip.Label="{DynamicResource DialogCloseTip}" controls:ShortcutTip.Shortcut="{x:Static infra:AppShortcuts.CloseDialog}">
          <ic:SymbolIcon Symbol="Dismiss" FontSize="14" />
        </Button>
      </Grid>

      <Grid ColumnDefinitions="*,*">
        <!-- 左侧：静态照片 -->
        <Border Grid.Column="0" Background="{DynamicResource CanvasBrush}" CornerRadius="16" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" Padding="12" Margin="0,0,6,0">
          <StackPanel Spacing="8">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Grid.Column="0" Text="{DynamicResource ArbitratePhotoTitle}" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
              <TextBlock Grid.Column="1" Text="{CompiledBinding PhotoTimeText}" FontSize="11" Foreground="{DynamicResource AccentTextBrush}" FontFamily="{DynamicResource MonoFontFamily}" />
            </Grid>
            <Border Background="{DynamicResource MediaCanvasBrush}" CornerRadius="12" Height="140">
              <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="4">
                <ic:SymbolIcon Symbol="Camera" FontSize="28" Foreground="{DynamicResource MediaAccentBrush}" />
                <TextBlock Text="{DynamicResource ArbitratePhotoDesc}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource OnMediaBrush}" HorizontalAlignment="Center" />
                <TextBlock Text="{CompiledBinding TargetCard.FileName}" TextTrimming="CharacterEllipsis" FontSize="11" Foreground="{DynamicResource OnMediaMutedBrush}" HorizontalAlignment="Center" />
              </StackPanel>
            </Border>
          </StackPanel>
        </Border>

        <!-- 右侧：动态视频 -->
        <Border Grid.Column="1" Background="{DynamicResource CanvasBrush}" CornerRadius="16" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" Padding="12" Margin="6,0,0,0">
          <StackPanel Spacing="8">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Grid.Column="0" Text="{DynamicResource ArbitrateVideoTitle}" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
              <TextBlock Grid.Column="1" Text="{CompiledBinding VideoTimeText}" FontSize="11" Foreground="{DynamicResource WarningTextBrush}" FontFamily="{DynamicResource MonoFontFamily}" />
            </Grid>
            <Border Background="{DynamicResource MediaCanvasBrush}" CornerRadius="12" Height="140">
              <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="4">
                <ic:SymbolIcon Symbol="Video" FontSize="28" Foreground="{DynamicResource MediaWarningBrush}" />
                <TextBlock Text="{DynamicResource ArbitrateVideoDesc}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource OnMediaBrush}" HorizontalAlignment="Center" />
                <TextBlock Text="{CompiledBinding TargetCard.VideoSizeText}" FontSize="11" Foreground="{DynamicResource OnMediaMutedBrush}" HorizontalAlignment="Center" />
              </StackPanel>
            </Border>
          </StackPanel>
        </Border>
      </Grid>

      <!-- 结论 -->
      <Border Background="{DynamicResource WarningSoftBrush}" CornerRadius="12" Padding="12" BorderBrush="{DynamicResource WarningBorderBrush}" BorderThickness="1">
        <StackPanel Spacing="4">
          <TextBlock Text="{DynamicResource ArbitrateConclusionLabel}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource WarningTextBrush}" />
          <TextBlock Text="{CompiledBinding VerdictConclusion}" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource WarningTextBrush}" />
        </StackPanel>
      </Border>

      <!-- 裁决按钮 -->
      <Grid ColumnDefinitions="*,Auto" Margin="0,8,0,0">
        <Button Grid.Column="0" Classes="nav-btn" Command="{CompiledBinding RejectSplitCommand}" HorizontalAlignment="Left">
          <TextBlock Text="{DynamicResource ArbitrateReject}" FontSize="11" FontWeight="SemiBold" />
        </Button>
        <Button Grid.Column="1" Classes="primary-btn" Background="{DynamicResource SuccessFillBrush}" Command="{CompiledBinding ConfirmWhitelistCommand}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <ic:SymbolIcon Symbol="Checkmark" FontSize="12" Foreground="{DynamicResource OnAccentBrush}" />
            <TextBlock Text="{DynamicResource ArbitrateConfirm}" FontSize="11" FontWeight="Bold" />
          </StackPanel>
        </Button>
      </Grid>
    </StackPanel>
  </Border>
</UserControl>
