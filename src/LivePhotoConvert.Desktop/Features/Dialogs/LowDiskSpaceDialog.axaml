<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dialogs="using:LivePhotoConvert.Desktop.Features.Dialogs"
             xmlns:ic="using:FluentIcons.Avalonia"
             x:Class="LivePhotoConvert.Desktop.Features.Dialogs.LowDiskSpaceDialog"
             x:CompileBindings="True"
             x:DataType="dialogs:LowDiskSpaceDialogViewModel">

  <Border Classes="dialog-card" MaxWidth="460" BorderBrush="{DynamicResource WarningBorderBrush}">
    <StackPanel Spacing="16">
      <Grid ColumnDefinitions="Auto,*">
        <Border Grid.Column="0" Classes="dialog-icon-badge warning">
          <ic:SymbolIcon Symbol="HardDrive" FontSize="20" Foreground="{DynamicResource WarningBrush}" />
        </Border>
        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" Spacing="2">
          <TextBlock Text="{DynamicResource LowDiskDialogTitle}" FontWeight="Black" FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}" />
          <TextBlock Text="{DynamicResource LowDiskDialogDesc}" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource TextTertiaryBrush}" />
        </StackPanel>
      </Grid>

      <Border Background="{DynamicResource WarningSoftBrush}" CornerRadius="12" Padding="12" BorderBrush="{DynamicResource WarningBorderBrush}" BorderThickness="1">
        <StackPanel Spacing="6">
          <TextBlock Text="{CompiledBinding TargetDirectory}" FontSize="11" FontFamily="Consolas" TextTrimming="CharacterEllipsis"
                     Foreground="{DynamicResource WarningTextBrush}" ToolTip.Tip="{CompiledBinding TargetDirectory}" />
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Grid.Column="0" Text="{DynamicResource LowDiskRequiredLabel}" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource WarningTextBrush}" />
            <TextBlock Grid.Column="1" Text="{CompiledBinding RequiredSpaceText}" FontWeight="Bold" FontSize="11" Margin="8,0,0,0" Foreground="{DynamicResource WarningTextBrush}" />
          </Grid>
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Grid.Column="0" Text="{DynamicResource LowDiskAvailableLabel}" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource WarningTextBrush}" />
            <TextBlock Grid.Column="1" Text="{CompiledBinding AvailableSpaceText}" FontWeight="Bold" FontSize="11" Margin="8,0,0,0" Foreground="{DynamicResource DangerTextBrush}" />
          </Grid>
        </StackPanel>
      </Border>

      <TextBlock Text="{DynamicResource LowDiskSolutionDesc}" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource TextTertiaryBrush}" />

      <Grid ColumnDefinitions="*,Auto" Margin="0,8,0,0">
        <Button Grid.Column="0" Classes="nav-btn" Command="{CompiledBinding ContinueCommand}" HorizontalAlignment="Left">
          <TextBlock Text="{DynamicResource LowDiskDialogContinue}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource WarningTextBrush}" />
        </Button>
        <Button Grid.Column="1" Classes="primary-btn" Command="{CompiledBinding CancelCommand}">
          <TextBlock Text="{DynamicResource LowDiskDialogDismiss}" FontSize="12" FontWeight="Bold" />
        </Button>
      </Grid>
    </StackPanel>
  </Border>
</UserControl>
