<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dialogs="using:LivePhotoConvert.Desktop.Features.Dialogs"
             xmlns:ic="using:FluentIcons.Avalonia"
             x:Class="LivePhotoConvert.Desktop.Features.Dialogs.DeleteConfirmDialog"
             x:CompileBindings="True"
             x:DataType="dialogs:DeleteConfirmDialogViewModel">

  <Border Classes="dialog-card" MaxWidth="440" BorderBrush="{DynamicResource DangerBorderBrush}">
    <StackPanel Spacing="16">
      <!-- 标题与警示 -->
      <Grid ColumnDefinitions="Auto,*">
        <Border Grid.Column="0" Classes="dialog-icon-badge danger">
          <ic:SymbolIcon Symbol="ShieldError" FontSize="20" Foreground="{DynamicResource DangerBrush}" />
        </Border>
        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" Spacing="2">
          <TextBlock Text="{DynamicResource DeleteDialogTitle}" FontWeight="Black" FontSize="14" Foreground="{DynamicResource DangerBrush}" />
          <TextBlock Text="{DynamicResource DeleteDialogDesc}" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource TextTertiaryBrush}" />
        </StackPanel>
      </Grid>

      <!-- 影响范围 -->
      <Border Background="{DynamicResource DangerSoftBrush}" CornerRadius="12" Padding="12" BorderBrush="{DynamicResource DangerBorderBrush}" BorderThickness="1">
        <StackPanel Spacing="4">
          <TextBlock Text="{CompiledBinding AffectedSummaryText}" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource DangerTextBrush}" />
          <TextBlock Text="{DynamicResource DeleteIrreversibleDesc}" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource DangerTextBrush}" />
        </StackPanel>
      </Border>

      <!-- 解锁输入 -->
      <StackPanel Spacing="6">
        <TextBlock Text="{DynamicResource DeleteDialogInputLabel}" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
        <TextBox x:Name="PasswordBox"
                 Text="{CompiledBinding PasswordInput, Mode=TwoWay}"
                 PlaceholderText="{DynamicResource DeleteInputPlaceholder}"
                 FontSize="13" FontWeight="Bold" FontFamily="Consolas"
                 HorizontalContentAlignment="Center"
                 CornerRadius="10" Padding="10" />
      </StackPanel>

      <!-- 操作按钮 -->
      <Grid ColumnDefinitions="*,Auto" Margin="0,8,0,0">
        <Button Grid.Column="0" Classes="nav-btn" Command="{CompiledBinding CancelCommand}" HorizontalAlignment="Left">
          <TextBlock Text="{DynamicResource DeleteDialogCancel}" FontSize="12" FontWeight="SemiBold" />
        </Button>
        <Button Grid.Column="1" Classes="danger-btn" Command="{CompiledBinding ConfirmCommand}">
          <TextBlock Text="{DynamicResource DeleteDialogConfirm}" FontSize="12" FontWeight="Bold" />
        </Button>
      </Grid>
    </StackPanel>
  </Border>
</UserControl>
