<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dialogs="using:LivePhotoConvert.Desktop.Features.Dialogs"
             xmlns:ic="using:FluentIcons.Avalonia"
             x:Class="LivePhotoConvert.Desktop.Features.Dialogs.BackupConfirmDialog"
             x:CompileBindings="True"
             x:DataType="dialogs:BackupConfirmDialogViewModel">

  <Border Classes="dialog-card" MaxWidth="460" BorderBrush="{DynamicResource WarningBorderBrush}">
    <StackPanel Spacing="16">
      <Grid ColumnDefinitions="Auto,*">
        <Border Grid.Column="0" Classes="dialog-icon-badge warning">
          <ic:SymbolIcon Symbol="Warning" FontSize="20" Foreground="{DynamicResource WarningBrush}" />
        </Border>
        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" Spacing="2">
          <TextBlock Text="{DynamicResource BackupDialogTitle}" FontWeight="Black" FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}" />
          <TextBlock Text="{DynamicResource BackupDialogDesc}" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource TextTertiaryBrush}" />
        </StackPanel>
      </Grid>

      <Border Background="{DynamicResource WarningSoftBrush}" CornerRadius="12" Padding="12" BorderBrush="{DynamicResource WarningBorderBrush}" BorderThickness="1">
        <StackPanel Spacing="6">
          <TextBlock Text="{DynamicResource BackupRiskTitle}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource WarningTextBrush}" />
          <TextBlock Text="{DynamicResource BackupRiskPoint1}" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource WarningTextBrush}" />
          <TextBlock Text="{DynamicResource BackupRiskPoint2}" FontSize="11" TextWrapping="Wrap" FontWeight="SemiBold" Foreground="{DynamicResource SuccessTextBrush}" />
        </StackPanel>
      </Border>

      <Grid ColumnDefinitions="*,Auto" Margin="0,8,0,0">
        <Button Grid.Column="0" Classes="nav-btn" Command="{CompiledBinding CancelCommand}" HorizontalAlignment="Left">
          <TextBlock Text="{DynamicResource BackupDialogCancel}" FontSize="12" FontWeight="SemiBold" />
        </Button>
        <Button Grid.Column="1" Classes="primary-btn" Background="{DynamicResource WarningBrush}" Command="{CompiledBinding ConfirmCommand}">
          <TextBlock Text="{DynamicResource BackupDialogConfirm}" FontSize="12" FontWeight="Bold" />
        </Button>
      </Grid>
    </StackPanel>
  </Border>
</UserControl>
