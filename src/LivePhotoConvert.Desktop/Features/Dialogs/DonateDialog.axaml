<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dialogs="using:LivePhotoConvert.Desktop.Features.Dialogs"
             xmlns:ic="using:FluentIcons.Avalonia"
             xmlns:controls="using:LivePhotoConvert.Desktop.Controls"
             xmlns:infra="using:LivePhotoConvert.Desktop.Infrastructure"
             x:Class="LivePhotoConvert.Desktop.Features.Dialogs.DonateDialog"
             x:CompileBindings="True"
             x:DataType="dialogs:DonateDialogViewModel">

  <Border Classes="dialog-card" MaxWidth="440">
    <StackPanel Spacing="14">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <Border Grid.Column="0" Classes="dialog-icon-badge danger">
          <ic:SymbolIcon Symbol="Heart" FontSize="20" Foreground="{DynamicResource DangerBrush}" />
        </Border>
        <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center" Spacing="2">
          <TextBlock Text="{DynamicResource AboutSponsorTitle}" FontWeight="Black" FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}" />
          <TextBlock Text="{DynamicResource AboutSponsorDesc}" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource TextTertiaryBrush}" />
        </StackPanel>
        <Button Grid.Column="2" Classes="dialog-close-btn" Command="{CompiledBinding CancelCommand}"
                controls:ShortcutTip.Label="{DynamicResource DialogCloseTip}" controls:ShortcutTip.Shortcut="{x:Static infra:AppShortcuts.CloseDialog}" VerticalAlignment="Top">
          <ic:SymbolIcon Symbol="Dismiss" FontSize="14" />
        </Button>
      </Grid>
      <!-- 二维码需要白底才能被扫描，深色主题下同样保持白底 -->
      <Border Classes="qr-frame" HorizontalAlignment="Center">
        <Image Source="avares://LivePhotoConvert/Assets/sponsor-qrcode.png" Width="320" Height="320" Stretch="Uniform" />
      </Border>
    </StackPanel>
  </Border>
</UserControl>
