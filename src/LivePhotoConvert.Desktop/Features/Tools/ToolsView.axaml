<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:LivePhotoConvert.Desktop.Features.Tools"
             xmlns:ic="using:FluentIcons.Avalonia"
             x:Class="LivePhotoConvert.Desktop.Features.Tools.ToolsView"
             x:CompileBindings="True"
             x:DataType="vm:ToolsViewModel">
  <UserControl.Resources>
    <DataTemplate x:Key="CapabilityTemplate" x:DataType="vm:CapabilityBadge">
      <Border Classes="capability-badge" Classes.supported="{CompiledBinding IsSupported}">
        <StackPanel Orientation="Horizontal" Spacing="4">
          <ic:SymbolIcon Symbol="CheckmarkCircle" FontSize="11" IsVisible="{CompiledBinding IsSupported}" />
          <ic:SymbolIcon Symbol="DismissCircle" FontSize="11" IsVisible="{CompiledBinding !IsSupported}" />
          <TextBlock Text="{CompiledBinding Label}" VerticalAlignment="Center" />
        </StackPanel>
      </Border>
    </DataTemplate>

    <DataTemplate x:Key="ToolCardTemplate" x:DataType="vm:ToolCardViewModel">
      <Border Classes="engine-card" Margin="6">
        <StackPanel Spacing="10">
          <Grid ColumnDefinitions="Auto,*,Auto">
            <Border Classes="status-dot large" Classes.ok="{CompiledBinding IsHealthy}" Classes.warn="{CompiledBinding HasWarning}" Classes.bad="{CompiledBinding IsMissing}" Classes.probing="{CompiledBinding IsProbing}" Margin="0,0,8,0" />
            <TextBlock Grid.Column="1" Text="{CompiledBinding DisplayName}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
            <Border Grid.Column="2" Classes="status-pill" Classes.success="{CompiledBinding IsHealthy}" Classes.warning="{CompiledBinding HasWarning}" Classes.danger="{CompiledBinding IsMissing}" Classes.muted="{CompiledBinding IsProbing}"
                    ToolTip.Tip="{CompiledBinding VersionDetail}">
              <TextBlock Text="{CompiledBinding StatusText}" FontSize="11" FontWeight="Bold" FontFamily="{DynamicResource MonoFontFamily}" TextTrimming="CharacterEllipsis" />
            </Border>
          </Grid>

          <TextBlock Text="{CompiledBinding Description}" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" TextWrapping="Wrap" />

          <ItemsControl ItemsSource="{CompiledBinding Capabilities}" ItemTemplate="{StaticResource CapabilityTemplate}" IsVisible="{CompiledBinding HasCapabilities}" Margin="0,0,0,-6">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
          </ItemsControl>

          <Grid Classes="tool-hint warning" ColumnDefinitions="Auto,*" IsVisible="{CompiledBinding IsHdrUnavailable}">
            <ic:SymbolIcon Symbol="Warning" FontSize="13" VerticalAlignment="Top" />
            <TextBlock Grid.Column="1" Text="{DynamicResource ToolHdrUnavailable}" />
          </Grid>

          <Grid Classes="tool-hint warning" ColumnDefinitions="Auto,*" IsVisible="{CompiledBinding IsExplicitPathInvalid}">
            <ic:SymbolIcon Symbol="Warning" FontSize="13" VerticalAlignment="Top" />
            <TextBlock Grid.Column="1" Text="{DynamicResource ToolExplicitPathInvalid}" />
          </Grid>

          <Grid Classes="tool-hint accent" ColumnDefinitions="Auto,*" IsVisible="{CompiledBinding IsUpdateRecommended}">
            <ic:SymbolIcon Symbol="ArrowDownload" FontSize="13" VerticalAlignment="Top" />
            <TextBlock Grid.Column="1" Text="{CompiledBinding UpdateText}" />
          </Grid>

          <Border Classes="engine-path">
            <TextBlock Text="{CompiledBinding PathText}" FontSize="11" FontFamily="{DynamicResource MonoFontFamily}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{CompiledBinding PathText}" Foreground="{DynamicResource TextSecondaryBrush}" />
          </Border>

          <StackPanel Spacing="6" IsVisible="{CompiledBinding IsInstalling}">
            <TextBlock Text="{CompiledBinding ProgressText}" FontSize="11" Foreground="{DynamicResource AccentTextBrush}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{CompiledBinding ProgressText}" />
            <ProgressBar Minimum="0" Maximum="100" Value="{CompiledBinding ProgressValue}" IsIndeterminate="{CompiledBinding IsProgressIndeterminate}" Height="4" MinHeight="4" />
          </StackPanel>

          <Button Classes="engine-install-btn" HorizontalAlignment="Stretch" Command="{CompiledBinding InstallCommand}" IsEnabled="{CompiledBinding CanStartInstall}" IsVisible="{CompiledBinding ShowInstallButton}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <ic:SymbolIcon Symbol="ArrowDownload" FontSize="13" Foreground="{DynamicResource OnAccentBrush}" />
              <TextBlock Text="{CompiledBinding InstallButtonText}" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Classes="engine-install-btn" HorizontalAlignment="Stretch" IsEnabled="False" IsVisible="{CompiledBinding ShowPlatformUnsupported}">
            <TextBlock Text="{DynamicResource ToolPlatformUnsupportedBtn}" TextWrapping="Wrap" TextAlignment="Center" />
          </Button>
          <Button Classes="engine-secondary-btn" HorizontalAlignment="Stretch" Command="{CompiledBinding CancelCommand}" IsVisible="{CompiledBinding IsInstalling}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <ic:SymbolIcon Symbol="Dismiss" FontSize="13" />
              <TextBlock Text="{DynamicResource CancelBtn}" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Classes="engine-secondary-btn" HorizontalAlignment="Stretch" Command="{CompiledBinding PickPathCommand}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <ic:SymbolIcon Symbol="FolderOpen" FontSize="13" />
              <TextBlock Text="{DynamicResource CustomPathBtn}" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </StackPanel>
      </Border>
    </DataTemplate>
  </UserControl.Resources>

  <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="24" Spacing="16">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Spacing="4">
          <TextBlock Text="{DynamicResource ToolsTitle}" FontWeight="Bold" FontSize="18" Foreground="{DynamicResource TextPrimaryBrush}" />
          <TextBlock Text="{DynamicResource ToolsDesc}" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" TextWrapping="Wrap" />
        </StackPanel>
        <Button Grid.Column="1" Classes="primary-btn" Command="{CompiledBinding RescanToolsCommand}" Padding="14,8" VerticalAlignment="Top">
          <StackPanel Orientation="Horizontal" Spacing="6"><ic:SymbolIcon Symbol="ArrowSync" FontSize="13" Foreground="{DynamicResource OnAccentBrush}" /><TextBlock Text="{DynamicResource RescanToolsBtn}" FontSize="11" FontWeight="Bold" /></StackPanel>
        </Button>
      </Grid>

      <Border Classes="tools-note">
        <Grid ColumnDefinitions="Auto,*">
          <ic:SymbolIcon Symbol="ShieldCheckmark" FontSize="16" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Top" />
          <StackPanel Grid.Column="1" Margin="10,0,0,0" Spacing="3">
            <TextBlock Text="{DynamicResource ToolsIntegrityNote}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="4">
              <TextBlock Text="{DynamicResource ToolsInstallRootLabel}" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" />
              <TextBlock Grid.Column="1" Text="{CompiledBinding InstallRoot}" FontSize="11" FontFamily="{DynamicResource MonoFontFamily}" Foreground="{DynamicResource TextTertiaryBrush}" TextTrimming="LeadingCharacterEllipsis" ToolTip.Tip="{CompiledBinding InstallRoot}" />
            </Grid>
          </StackPanel>
        </Grid>
      </Border>

      <Border Classes="tools-note warning" IsVisible="{CompiledBinding IsInstallBlocked}">
        <Grid ColumnDefinitions="Auto,*">
          <ic:SymbolIcon Symbol="Warning" FontSize="16" Foreground="{DynamicResource WarningBrush}" VerticalAlignment="Center" />
          <TextBlock Grid.Column="1" Margin="10,0,0,0" Text="{DynamicResource ToolInstallBlockedByTask}" FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center" />
        </Grid>
      </Border>

      <ItemsControl ItemsSource="{CompiledBinding Cards}" ItemTemplate="{StaticResource ToolCardTemplate}" Margin="-6">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <UniformGrid Columns="3" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
      </ItemsControl>

      <Border Classes="tools-note" Classes.danger="{CompiledBinding IsActionMessageError}" IsVisible="{CompiledBinding HasActionMessage}">
        <TextBlock Text="{CompiledBinding ActionMessageText}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
      </Border>

      <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="14" Padding="16">
        <StackPanel Spacing="12">
          <StackPanel Spacing="2">
            <TextBlock Text="{DynamicResource MirrorTitle}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
            <TextBlock Text="{DynamicResource MirrorDesc}" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" TextWrapping="Wrap" />
          </StackPanel>
          <Grid ColumnDefinitions="240,*,Auto" ColumnSpacing="10">
            <ComboBox Grid.Column="0" Classes="engine-select" HorizontalAlignment="Stretch" ItemsSource="{CompiledBinding MirrorPresets}" SelectedItem="{CompiledBinding SelectedMirrorPreset, Mode=TwoWay}">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="vm:MirrorPreset"><TextBlock Text="{CompiledBinding Name}" FontSize="12" /></DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <TextBox Grid.Column="1" Text="{CompiledBinding CustomMirrorUrl, Mode=TwoWay}" FontSize="11" FontFamily="{DynamicResource MonoFontFamily}" Padding="10,8" />
            <Button Grid.Column="2" Classes="engine-secondary-btn" Command="{CompiledBinding TestMirrorSpeedCommand}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <ic:SymbolIcon Symbol="TopSpeed" FontSize="13" />
                <TextBlock Text="{DynamicResource TestPingBtn}" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
          </Grid>
          <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{CompiledBinding HasPingResult}">
            <TextBlock Classes="ping-result" Classes.ok="{CompiledBinding IsPingHealthy}" Text="{DynamicResource PingLatencyLabel}" FontWeight="Bold" />
            <TextBlock Classes="ping-result" Classes.ok="{CompiledBinding IsPingHealthy}" Text="{CompiledBinding PingLatencyText}" FontFamily="{DynamicResource MonoFontFamily}" />
          </StackPanel>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
