<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:LivePhotoConvert.Desktop.Features.Tools"
             xmlns:ic="using:FluentIcons.Avalonia"
             x:Class="LivePhotoConvert.Desktop.Features.Tools.ToolsView"
             x:CompileBindings="True"
             x:DataType="vm:ToolsViewModel">
  <UserControl.Resources>
    <DataTemplate x:Key="CapabilityTemplate" x:DataType="vm:CapabilityBadge">
      <Border Classes="capability-badge" Classes.supported="{Binding IsSupported}">
        <StackPanel Orientation="Horizontal" Spacing="4">
          <ic:SymbolIcon Symbol="CheckmarkCircle" FontSize="11" IsVisible="{Binding IsSupported}" />
          <ic:SymbolIcon Symbol="DismissCircle" FontSize="11" IsVisible="{Binding !IsSupported}" />
          <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
        </StackPanel>
      </Border>
    </DataTemplate>

    <DataTemplate x:Key="ToolCardTemplate" x:DataType="vm:ToolCardViewModel">
      <Border Classes="engine-card" Margin="6">
        <StackPanel Spacing="10">
          <Grid ColumnDefinitions="Auto,*,Auto">
            <Border Classes="status-dot large" Classes.ok="{Binding IsHealthy}" Classes.warn="{Binding HasWarning}" Classes.bad="{Binding IsMissing}" Margin="0,0,8,0" />
            <TextBlock Grid.Column="1" Text="{Binding DisplayName}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
            <Border Grid.Column="2" Classes="status-pill" Classes.success="{Binding IsHealthy}" Classes.warning="{Binding HasWarning}" Classes.danger="{Binding IsMissing}" Classes.muted="{Binding IsProbing}"
                    ToolTip.Tip="{Binding VersionDetail}">
              <TextBlock Text="{Binding StatusText}" FontSize="10" FontWeight="Bold" FontFamily="Consolas" TextTrimming="CharacterEllipsis" />
            </Border>
          </Grid>

          <TextBlock Text="{Binding Description}" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" TextWrapping="Wrap" />

          <ItemsControl ItemsSource="{Binding Capabilities}" ItemTemplate="{StaticResource CapabilityTemplate}" IsVisible="{Binding HasCapabilities}" Margin="0,0,0,-6">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
          </ItemsControl>

          <Grid Classes="tool-hint warning" ColumnDefinitions="Auto,*" IsVisible="{Binding IsHdrUnavailable}">
            <ic:SymbolIcon Symbol="Warning" FontSize="13" VerticalAlignment="Top" />
            <TextBlock Grid.Column="1" Text="{DynamicResource ToolHdrUnavailable}" />
          </Grid>

          <Grid Classes="tool-hint warning" ColumnDefinitions="Auto,*" IsVisible="{Binding IsExplicitPathInvalid}">
            <ic:SymbolIcon Symbol="Warning" FontSize="13" VerticalAlignment="Top" />
            <TextBlock Grid.Column="1" Text="{DynamicResource ToolExplicitPathInvalid}" />
          </Grid>

          <Grid Classes="tool-hint accent" ColumnDefinitions="Auto,*" IsVisible="{Binding IsUpdateRecommended}">
            <ic:SymbolIcon Symbol="ArrowDownload" FontSize="13" VerticalAlignment="Top" />
            <TextBlock Grid.Column="1" Text="{Binding UpdateText}" />
          </Grid>

          <Border Classes="engine-path">
            <TextBlock Text="{Binding PathText}" FontSize="10" FontFamily="Consolas" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding PathText}" Foreground="{DynamicResource TextSecondaryBrush}" />
          </Border>

          <StackPanel Spacing="6" IsVisible="{Binding IsInstalling}">
            <TextBlock Text="{Binding ProgressText}" FontSize="10" Foreground="{DynamicResource AccentTextBrush}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding ProgressText}" />
            <ProgressBar Minimum="0" Maximum="100" Value="{Binding ProgressValue}" IsIndeterminate="{Binding IsProgressIndeterminate}" Height="4" MinHeight="4" />
          </StackPanel>

          <Button Classes="engine-install-btn" HorizontalAlignment="Stretch" Command="{Binding InstallCommand}" IsEnabled="{Binding CanStartInstall}" IsVisible="{Binding ShowInstallButton}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <ic:SymbolIcon Symbol="ArrowDownload" FontSize="13" Foreground="{DynamicResource OnAccentBrush}" />
              <TextBlock Text="{Binding InstallButtonText}" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Classes="engine-install-btn" HorizontalAlignment="Stretch" IsEnabled="False" IsVisible="{Binding ShowPlatformUnsupported}">
            <TextBlock Text="{DynamicResource ToolPlatformUnsupportedBtn}" TextWrapping="Wrap" TextAlignment="Center" />
          </Button>
          <Button Classes="engine-secondary-btn" HorizontalAlignment="Stretch" Command="{Binding CancelCommand}" IsVisible="{Binding IsInstalling}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <ic:SymbolIcon Symbol="Dismiss" FontSize="13" />
              <TextBlock Text="{DynamicResource CancelBtn}" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Classes="engine-secondary-btn" HorizontalAlignment="Stretch" Command="{Binding PickPathCommand}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <ic:SymbolIcon Symbol="FolderOpen" FontSize="13" />
              <TextBlock Text="{DynamicResource CustomPathBtn}" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </StackPanel>
      </Border>
    </DataTemplate>
  </UserControl.Resources>

  <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="24" Spacing="16">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Spacing="4">
          <TextBlock Text="{DynamicResource ToolsTitle}" FontWeight="Bold" FontSize="18" Foreground="{DynamicResource TextPrimaryBrush}" />
          <TextBlock Text="{DynamicResource ToolsDesc}" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" TextWrapping="Wrap" />
        </StackPanel>
        <Button Grid.Column="1" Classes="primary-btn" Command="{Binding RescanToolsCommand}" Padding="14,8" VerticalAlignment="Top">
          <StackPanel Orientation="Horizontal" Spacing="6"><ic:SymbolIcon Symbol="ArrowSync" FontSize="13" Foreground="{DynamicResource OnAccentBrush}" /><TextBlock Text="{DynamicResource RescanToolsBtn}" FontSize="11" FontWeight="Bold" /></StackPanel>
        </Button>
      </Grid>

      <Border Classes="tools-note">
        <Grid ColumnDefinitions="Auto,*">
          <ic:SymbolIcon Symbol="ShieldCheckmark" FontSize="16" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Top" />
          <StackPanel Grid.Column="1" Margin="10,0,0,0" Spacing="3">
            <TextBlock Text="{DynamicResource ToolsIntegrityNote}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="4">
              <TextBlock Text="{DynamicResource ToolsInstallRootLabel}" FontSize="10" Foreground="{DynamicResource TextTertiaryBrush}" />
              <TextBlock Grid.Column="1" Text="{Binding InstallRoot}" FontSize="10" FontFamily="Consolas" Foreground="{DynamicResource TextTertiaryBrush}" TextTrimming="LeadingCharacterEllipsis" ToolTip.Tip="{Binding InstallRoot}" />
            </Grid>
          </StackPanel>
        </Grid>
      </Border>

      <Border Classes="tools-note warning" IsVisible="{Binding IsInstallBlocked}">
        <Grid ColumnDefinitions="Auto,*">
          <ic:SymbolIcon Symbol="Warning" FontSize="16" Foreground="{DynamicResource WarningBrush}" VerticalAlignment="Center" />
          <TextBlock Grid.Column="1" Margin="10,0,0,0" Text="{DynamicResource ToolInstallBlockedByTask}" FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center" />
        </Grid>
      </Border>

      <ItemsControl ItemsSource="{Binding Cards}" ItemTemplate="{StaticResource ToolCardTemplate}" Margin="-6">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <UniformGrid Columns="3" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
      </ItemsControl>

      <Border Classes="tools-note" Classes.danger="{Binding IsActionMessageError}" IsVisible="{Binding HasActionMessage}">
        <TextBlock Text="{Binding ActionMessageText}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
      </Border>

      <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="14" Padding="16">
        <StackPanel Spacing="12">
          <StackPanel Spacing="2">
            <TextBlock Text="{DynamicResource MirrorTitle}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
            <TextBlock Text="{DynamicResource MirrorDesc}" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" TextWrapping="Wrap" />
          </StackPanel>
          <Grid ColumnDefinitions="240,*,Auto" ColumnSpacing="10">
            <ComboBox Grid.Column="0" Classes="engine-select" HorizontalAlignment="Stretch" ItemsSource="{Binding MirrorPresets}" SelectedItem="{Binding SelectedMirrorPreset, Mode=TwoWay}">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="vm:MirrorPreset"><TextBlock Text="{Binding Name}" FontSize="12" /></DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <TextBox Grid.Column="1" Text="{Binding CustomMirrorUrl, Mode=TwoWay}" FontSize="11" FontFamily="Consolas" Padding="10,8" />
            <Button Grid.Column="2" Classes="engine-secondary-btn" Command="{Binding TestMirrorSpeedCommand}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <ic:SymbolIcon Symbol="TopSpeed" FontSize="13" />
                <TextBlock Text="{DynamicResource TestPingBtn}" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
          </Grid>
          <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding HasPingResult}">
            <TextBlock Classes="ping-result" Classes.ok="{Binding IsPingHealthy}" Text="{DynamicResource PingLatencyLabel}" FontWeight="Bold" />
            <TextBlock Classes="ping-result" Classes.ok="{Binding IsPingHealthy}" Text="{Binding PingLatencyText}" FontFamily="Consolas" />
          </StackPanel>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
