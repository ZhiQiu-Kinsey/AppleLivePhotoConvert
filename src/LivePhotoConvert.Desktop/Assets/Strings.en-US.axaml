  <sys:String x:Key="AboutLicenseTitle">License</sys:String>
  <sys:String x:Key="AboutLicenseDesc">Released under the MIT License: anyone may freely use, copy, modify, merge, publish, distribute and sell this software, provided the copyright and permission notice are retained. The software is provided "as is", without warranty of any kind.</sys:String>
