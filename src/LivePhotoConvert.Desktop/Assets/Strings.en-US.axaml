  <sys:String x:Key="NamingFormatOriginal">Keep Original Name (MVIMG_{name}.jpg)</sys:String>
  <sys:String x:Key="NamingFormatDateName">Date + Original Name (Recommended)</sys:String>
  <sys:String x:Key="NamingFormatClean">Camera Timestamp Only</sys:String>
  <sys:String x:Key="SourceActionTitle">Post-Conversion Action</sys:String>
  <sys:String x:Key="SourceActionKeep">Keep Source Files (Safe Recommended)</sys:String>
