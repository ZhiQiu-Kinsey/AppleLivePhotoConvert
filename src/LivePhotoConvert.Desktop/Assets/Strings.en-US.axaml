  <sys:String x:Key="DeleteWarningDesc">Original live photos will be wiped permanently. Type DELETE to unlock.</sys:String>
  <sys:String x:Key="AutoAppendIndexTitle">Auto-append _1 suffix on collision</sys:String>
  <sys:String x:Key="AutoAppendIndexDesc">If disabled, existing files with the same name will be overwritten</sys:String>
  <sys:String x:Key="HeicQualityTitle">Apple Cover HEIC Quality</sys:String>
  <sys:String x:Key="HeicQualityDesc">Quality factor when transcoding cover JPEG to Apple HEIC.</sys:String>
