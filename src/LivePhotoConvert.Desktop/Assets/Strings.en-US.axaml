  <!-- Empty States &amp; Format Strings -->
  <sys:String x:Key="EmptyStateNoDirTitle">Please select an album directory</sys:String>
  <sys:String x:Key="EmptyStateNoDirSubtitle">Choose a folder with Live Photos (HEIC/JPG + MOV) or Android motion photos, then pick an action on the right.</sys:String>
  <sys:String x:Key="EmptyStateDropHint">Or drag a folder here</sys:String>
  <sys:String x:Key="DropOverlayTitle">Drop to open this folder</sys:String>
  <sys:String x:Key="EmptyStateEmptyTitle">No live photos found in directory</sys:String>
  <sys:String x:Key="EmptyStateEmptySubtitle">Please ensure the folder contains valid Live Photo pairs or Motion Photos</sys:String>
  <sys:String x:Key="FunnelTotalFormat">{0:N0} files scanned</sys:String>
  <sys:String x:Key="FunnelReadyFormat">Ready: {0:N0}</sys:String>
  <sys:String x:Key="FunnelSuspiciousFormat">Suspicious: {0:N0}</sys:String>
  <sys:String x:Key="FunnelItemsFormat">{0:N0} items</sys:String>
  <sys:String x:Key="FunnelIgnoredFormat">{0:N0} ignored</sys:String>
  <sys:String x:Key="FunnelTooltipFormat">Scanned {0:N0} files into {1:N0} library items (a Live Photo pair counts as one item). {2:N0} non-media, hidden or system files and conversion staging or backup files were ignored.</sys:String>
  <sys:String x:Key="PrimaryBtnMergeFormat">Merge {0} into Android motion photos</sys:String>
  <sys:String x:Key="PrimaryBtnAppleFormat">Restore {0} as Apple Live Photos</sys:String>
  <sys:String x:Key="PrimaryBtnExtractFormat">Extract {0} motion photos</sys:String>
