<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                    x:Class="LivePhotoConvert.Desktop.Assets.EnUsStrings">

  <!-- Application Title & Navigation -->
  <sys:String x:Key="AppTitle">LivePhotoConvert</sys:String>
  <sys:String x:Key="AppSubtitle">Professional Live Photo Studio</sys:String>
  <sys:String x:Key="NavTools">Engines</sys:String>
  <sys:String x:Key="NavSettings">Preferences</sys:String>
  <sys:String x:Key="ShellToolReady">Ready</sys:String>
  <sys:String x:Key="ShellToolAttention">Available, but needs attention. See Engines.</sys:String>
  <sys:String x:Key="ShellToolMissing">Not found; related features are unavailable</sys:String>
  <sys:String x:Key="ShellToolProbing">Checking</sys:String>

  <!-- Funnel & Direction -->
  <sys:String x:Key="SelectedSummaryFormat">{0} Live Photos · {1}</sys:String>

  <!-- Toolbar & Gallery -->
  <sys:String x:Key="ToolbarAlbumTitle">Album Live Roll</sys:String>
  <sys:String x:Key="SortDateTaken">Date Taken</sys:String>
  <sys:String x:Key="SortDateCreated">Date Created</sys:String>
  <sys:String x:Key="SortDateModified">Date Modified</sys:String>
  <sys:String x:Key="SortName">Name</sys:String>
  <sys:String x:Key="SortAsc">Ascending</sys:String>
  <sys:String x:Key="SortDesc">Descending</sys:String>
  <sys:String x:Key="FilterAllFormat">All Photos ({0})</sys:String>
  <sys:String x:Key="FilterSuspiciousFormat">Needs Decision Only ({0})</sys:String>
  <sys:String x:Key="FilterSelected">Selected Only</sys:String>
  <sys:String x:Key="FilterBannerPrefix" xml:space="preserve">Current Filter View: </sys:String>
  <sys:String x:Key="FilterClear">Clear Filter</sys:String>
  <sys:String x:Key="CropNatural">Justified rows</sys:String>
  <sys:String x:Key="CropSquare">Square (1:1)</sys:String>
  <sys:String x:Key="ScaleSmall">Compact Grid (Overview)</sys:String>
  <sys:String x:Key="ScaleMedium">Standard Grid</sys:String>
  <sys:String x:Key="ScaleLarge">Large Cards (Details)</sys:String>
  <sys:String x:Key="GroupDate">Group by Date</sys:String>
  <sys:String x:Key="GroupMonth">Group by Month</sys:String>
  <sys:String x:Key="GroupYear">Group by Year</sys:String>
  <sys:String x:Key="GroupNone">Continuous (No Grouping)</sys:String>
  <sys:String x:Key="SelectAll">Select All Photos</sys:String>
  <sys:String x:Key="DeselectAll">Deselect All</sys:String>
  <sys:String x:Key="ToggleAllCollapse">Toggle All Collapse / Expand</sys:String>
  <sys:String x:Key="RefreshAlbum">Rescan Album</sys:String>

  <!-- Console & Output -->
  <sys:String x:Key="NamingFormatTitle">Output Naming Format</sys:String>
  <sys:String x:Key="NamingFormatOriginalShort">Keep original</sys:String>
  <sys:String x:Key="NamingFormatDateNameShort">Date + name</sys:String>
  <sys:String x:Key="NamingFormatCleanShort">Timestamp only</sys:String>
  <sys:String x:Key="SourceActionTitle">Post-Conversion Action</sys:String>
  <sys:String x:Key="SourceActionKeepShort">Keep originals</sys:String>
  <sys:String x:Key="SourceActionSubfolderShort">Move to backup</sys:String>
  <sys:String x:Key="SourceActionRecycleShort">Move to Recycle Bin</sys:String>
  <sys:String x:Key="SourceActionDeleteShort">Delete permanently</sys:String>
  <sys:String x:Key="DeleteWarningTitle">Physical Deletion Alert</sys:String>
  <sys:String x:Key="DeleteWarningDesc">Source files are permanently deleted after conversion; you must type a confirmation word to start.</sys:String>
  <sys:String x:Key="AutoAppendIndexTitle">Append a number on name clashes</sys:String>
  <sys:String x:Key="AutoAppendIndexDesc">When off, files with the same name in the output folder are overwritten.</sys:String>
  <sys:String x:Key="PreserveHdrTitle">Keep HDR (Ultra HDR)</sys:String>
  <sys:String x:Key="PreserveHdrDesc">Writes the gain map of iPhone HDR photos into an Ultra HDR cover that supporting galleries show in HDR. Requires heif-dec (part of libheif); without it a standard cover is written and the report says why.</sys:String>
  <sys:String x:Key="HeicQualityTitle">HEIC quality</sys:String>
  <sys:String x:Key="HeicQualityDesc">Quality used when encoding HEIC; higher means better quality and larger files.</sys:String>
  <sys:String x:Key="ChangeOutputDirBtn">Change</sys:String>
  <sys:String x:Key="OpenOutputDirTip">Open folder</sys:String>
  <sys:String x:Key="KeepSubfoldersLabel">Keep subfolders</sys:String>
  <sys:String x:Key="CancelTaskBtn">Cancel Task</sys:String>

  <!-- Storage Strip -->
  <sys:String x:Key="NoAlbumOrPhotoSelected">No album or photo selected</sys:String>
  <sys:String x:Key="CurtainCompareTitle">Slim-down quality comparison</sys:String>
  <sys:String x:Key="CurtainCompareDesc">The sample was actually processed with the current slim-down settings. Drag the divider to compare; scroll to zoom, drag to pan, and hold the right button or turn on the magnifier for 1:1 pixels.</sys:String>
  <sys:String x:Key="InPlaceStripTitle">In-Place Overwrite (Destructive)</sys:String>
  <sys:String x:Key="InPlaceStripDesc">Overwrites sources in-place; disable to export safely</sys:String>
  <sys:String x:Key="SpaceEstimateTitle">Estimated Space Savings</sys:String>
  <sys:String x:Key="OriginalSizeLabel">Original Album Size:</sys:String>
  <sys:String x:Key="StrippedSizeLabel">Size after slimming (estimated):</sys:String>
  <sys:String x:Key="SavedSizeLabel">Space freed (estimated):</sys:String>
  <sys:String x:Key="PauseBtn">Pause</sys:String>
  <sys:String x:Key="OpenOutputDirBtn">Open Output Folder</sys:String>

  <!-- Engines -->
  <sys:String x:Key="ToolsTitle">Core Engine Management</sys:String>
  <sys:String x:Key="ToolsDesc">Manage conversion tools: ExifTool, FFmpeg, and heif-enc.</sys:String>
  <sys:String x:Key="ToolNotInstalled">Not installed</sys:String>
  <sys:String x:Key="RescanToolsBtn">Rescan Engines</sys:String>
  <sys:String x:Key="MirrorTitle">GitHub Download Mirror</sys:String>
  <sys:String x:Key="MirrorDesc">Select acceleration proxy or enter custom mirror endpoint</sys:String>
  <sys:String x:Key="MirrorPresetGhfast">Fast mirror (ghfast.top - recommended)</sys:String>
  <sys:String x:Key="MirrorPresetGhproxy">Community mirror (ghproxy.net)</sys:String>
  <sys:String x:Key="MirrorPresetMirrorGhproxy">Accelerated node (mirror.ghproxy.com)</sys:String>
  <sys:String x:Key="MirrorPresetGithub">Direct (github.com)</sys:String>
  <sys:String x:Key="MirrorPresetCustom">Custom mirror (enter manually)</sys:String>
  <sys:String x:Key="TestPingBtn">Test Connectivity</sys:String>

  <!-- Dialogs -->
  <sys:String x:Key="DeleteDialogTitle">Alert: Permanent Source Deletion!</sys:String>
  <sys:String x:Key="DeleteDialogDesc">This action is irreversible! Files will be permanently deleted.</sys:String>
  <sys:String x:Key="DeleteDialogInputLabel">Type uppercase DELETE to unlock:</sys:String>
  <sys:String x:Key="DeleteDialogCancel">Cancel and keep originals</sys:String>
  <sys:String x:Key="DeleteDialogConfirm">Confirm Permanent Deletion</sys:String>

  <sys:String x:Key="LowDiskDialogTitle">Low Disk Space Alert (ENOSPC)</sys:String>
  <sys:String x:Key="LowDiskDialogDesc">Target drive has insufficient space for safe conversion</sys:String>
  <sys:String x:Key="LowDiskDialogDismiss">Go Back</sys:String>

  <sys:String x:Key="BackupDialogTitle">High-Risk Confirmation: In-Place Overwrite</sys:String>
  <sys:String x:Key="BackupDialogDesc">Enabling this will permanently strip embedded video streams!</sys:String>
  <sys:String x:Key="BackupDialogCancel">Cancel, Use Safe Export</sys:String>
  <sys:String x:Key="BackupDialogConfirm">I Understand the Risk, Enable Overwrite</sys:String>

  <sys:String x:Key="ArbitrateDialogTitle">Dual-Frame Verification (Time Gap Exceeded)</sys:String>
  <sys:String x:Key="ArbitrateDialogDesc">Compare photo and video first frame to verify shutter moment</sys:String>
  <sys:String x:Key="ArbitrateReject">Not Live Pair (Split Separately)</sys:String>
  <sys:String x:Key="ArbitrateConfirm">Confirm Live Pair (Add to Whitelist)</sys:String>

  <sys:String x:Key="SettingsPageTitle">Global Preferences</sys:String>
  <sys:String x:Key="ThemeTitle">Appearance Theme</sys:String>
  <sys:String x:Key="LangTitle">System Language</sys:String>
  <sys:String x:Key="ConcurrencyTitle">Concurrent Task Count</sys:String>

  <!-- CompactToolbar Keys -->
  <sys:String x:Key="ToolbarSortTip">Sort by</sys:String>
  <sys:String x:Key="ToolbarFilterTip">Filter</sys:String>
  <sys:String x:Key="ToolbarViewTip">View layout and card aspect ratio</sys:String>
  <sys:String x:Key="ToolbarMoreTip">More options</sys:String>

  <!-- ToolsView Keys -->
  <sys:String x:Key="ExifToolDesc">Injects XMP Motion Photo tags and QuickTime UTC timezone metadata.</sys:String>
  <sys:String x:Key="FfmpegDesc">Video stream copy, transcoding and HDR tone mapping.</sys:String>
  <sys:String x:Key="HeifEncDesc">High-quality HEIC/HEIF image encoder.</sys:String>
  <sys:String x:Key="CustomPathBtn">Specify Custom Path...</sys:String>
  <sys:String x:Key="InstallToolBtn">Install Now</sys:String>
  <sys:String x:Key="InstallStartingFormat">Installing {0}, please keep the network connected...</sys:String>
  <sys:String x:Key="InstallCompletedFormat">{0} installed</sys:String>
  <sys:String x:Key="InstallFailedFormat">{0} install failed: {1}</sys:String>
  <sys:String x:Key="InstallCanceled">Installation canceled</sys:String>
  <sys:String x:Key="ToolPathInvalidFormat">The selected file is not a usable engine executable: {0}</sys:String>
  <sys:String x:Key="ToolPathAppliedFormat">Executable path for {0} has been set</sys:String>
  <sys:String x:Key="PickerToolExecutableTitle">Select engine executable</sys:String>
  <sys:String x:Key="ToolsIntegrityNote">One-click install uses pinned versions: each download is verified by SHA256, extracted, test-run and then swapped in as a whole. If any step fails, the existing version is kept.</sys:String>
  <sys:String x:Key="ToolsInstallRootLabel">Install location:</sys:String>
  <sys:String x:Key="ToolProbing">Detecting</sys:String>
  <sys:String x:Key="ToolVersionUnknown">Unknown version</sys:String>
  <sys:String x:Key="ToolUpdateAvailableFormat">Recommended version {0} is available</sys:String>
  <sys:String x:Key="ToolUpgradeBtnFormat">Upgrade to {0}</sys:String>
  <sys:String x:Key="ToolHdrUnavailable">HDR preview/transcoding unavailable: this FFmpeg lacks HDR tone mapping or 10-bit HEVC encoding.</sys:String>
  <sys:String x:Key="ToolExplicitPathInvalid">The custom path is invalid; fell back to automatic detection.</sys:String>
  <sys:String x:Key="ToolCapabilityHdrTonemap">HDR tone mapping (zscale+tonemap)</sys:String>
  <sys:String x:Key="ToolCapabilityHevc10Bit">HEVC 10-bit</sys:String>
  <sys:String x:Key="ToolPlatformUnsupportedBtn">Install with your system package manager</sys:String>
  <sys:String x:Key="ToolPlatformUnsupported">No bundled package for this platform. Install it with your system package manager or specify its path.</sys:String>
  <sys:String x:Key="ToolInstallBlockedByTask">A running task is using these tools. Install or upgrade after it finishes.</sys:String>
  <sys:String x:Key="ToolStagePreparing">Preparing...</sys:String>
  <sys:String x:Key="ToolStageDownloadingFormat">Downloading from {0}: {1}</sys:String>
  <sys:String x:Key="ToolStageVerifying">Verifying integrity...</sys:String>
  <sys:String x:Key="ToolStageExtracting">Extracting...</sys:String>
  <sys:String x:Key="ToolStageProbing">Test-running...</sys:String>
  <sys:String x:Key="ToolStageCommitting">Replacing the old version...</sys:String>
  <sys:String x:Key="ToolStageSourceFailedFormat">{0} failed ({1}), trying the next source...</sys:String>
  <sys:String x:Key="ToolSourceFailureFormat">{0}: {1}</sys:String>
  <sys:String x:Key="ToolSourceViaFormat">{0} (via {1})</sys:String>
  <sys:String x:Key="ToolSourceNpmMirror">npmmirror (China mirror)</sys:String>
  <sys:String x:Key="ToolSourceNpmRegistry">npm registry</sys:String>
  <sys:String x:Key="ToolSourceSourceForge">SourceForge</sys:String>
  <sys:String x:Key="ToolSourceGitHub">GitHub Releases</sys:String>
  <sys:String x:Key="ToolFailureUnverified">no trusted checksum, rejected</sys:String>
  <sys:String x:Key="ToolFailureNetwork">network error</sys:String>
  <sys:String x:Key="ToolFailureStalled">download stalled</sys:String>
  <sys:String x:Key="ToolFailureIntegrity">checksum mismatch, the file may be tampered with or incomplete</sys:String>
  <sys:String x:Key="ToolFailureUnsafeArchive">package contains unsafe paths, rejected</sys:String>
  <sys:String x:Key="ToolFailureInvalidArchive">package is corrupt or has an unexpected layout</sys:String>
  <sys:String x:Key="ToolFailureProbe">test run failed, possibly blocked by security software</sys:String>
  <sys:String x:Key="ToolFailureCommit">could not replace the old version, it may be in use</sys:String>
  <sys:String x:Key="PingInvalidAddress">invalid address</sys:String>
  <sys:String x:Key="PingTimedOut">timed out</sys:String>

  <!-- CurtainCompare Keys -->
  <sys:String x:Key="CurtainAfterBadge">Optimized</sys:String>
  <sys:String x:Key="CurtainBeforeBadge">Original</sys:String>

  <!-- PhotoCard Keys -->
  <sys:String x:Key="CardLiveBadge">Live</sys:String>
  <sys:String x:Key="CardTimeMismatch">Timestamp Mismatch</sys:String>
  <sys:String x:Key="CardArbitrateBtn">Manual Arbitration</sys:String>

  <!-- QuickLook Keys -->
  <sys:String x:Key="QuickLookLiveBadge">Live Photo</sys:String>
  <sys:String x:Key="QuickLookFormat">Format</sys:String>
  <sys:String x:Key="QuickLookResolution">Resolution</sys:String>
  <sys:String x:Key="QuickLookPairing">Pairing</sys:String>
  <sys:String x:Key="QuickLookSize">Size</sys:String>
  <sys:String x:Key="QuickLookPause">Pause</sys:String>
  <sys:String x:Key="QuickLookShortcutsFormat">Press {0} to play/pause · {1} / {2} to navigate · {3} to close</sys:String>
  <sys:String x:Key="QuickLookPrevTip">Previous</sys:String>
  <sys:String x:Key="QuickLookNextTip">Next</sys:String>

  <!-- Dialog Secondary Keys -->
  <sys:String x:Key="DeleteAffectedFormat">Affected source files: {0} pairs ({1})</sys:String>
  <sys:String x:Key="DeleteIrreversibleDesc">Deleted files cannot be recovered from the Recycle Bin or Trash.</sys:String>
  <sys:String x:Key="DeleteInputPlaceholder">Type DELETE</sys:String>
  <sys:String x:Key="LowDiskRequiredLabel">Estimated space required (1.2x safety margin + 500MB):</sys:String>
  <sys:String x:Key="LowDiskAvailableLabel">Available free space on target drive:</sys:String>
  <sys:String x:Key="LowDiskSolutionDesc">Please free up disk space or choose another output drive.</sys:String>
  <sys:String x:Key="BackupRiskTitle">Operational Impact &amp; Irreversible Risks:</sys:String>
  <sys:String x:Key="BackupRiskPoint1">1. Motion Photo video streams will be permanently removed, keeping only static covers;</sys:String>
  <sys:String x:Key="BackupRiskPoint2">2. Safety guarantee: .livephoto_backup will be staged atomically before deletion.</sys:String>
  <sys:String x:Key="ArbitratePhotoTitle">Static Photo (HEIC)</sys:String>
  <sys:String x:Key="ArbitratePhotoDesc">High-res static original</sys:String>
  <sys:String x:Key="ArbitrateVideoTitle">Video First Frame (MOV)</sys:String>
  <sys:String x:Key="ArbitrateVideoDesc">Live video frame at 0ms</sys:String>
  <sys:String x:Key="ArbitrateConclusionLabel" xml:space="preserve">Time Offset Conclusion: </sys:String>

  <!-- Settings Dialog Options -->
  <sys:String x:Key="ThemeLightOption">Light Mode</sys:String>
  <sys:String x:Key="ThemeDarkOption">Dark Mode</sys:String>
  <sys:String x:Key="ThemeAutoOption">Follow System</sys:String>
  <sys:String x:Key="LangZhOption">Simplified Chinese</sys:String>
  <sys:String x:Key="LangEnOption">English</sys:String>

  <!-- Settings Dialog Redesign -->
  <sys:String x:Key="CancelBtn">Cancel</sys:String>
  <sys:String x:Key="SettingsConcurrencyDesc">Number of live photo pairs processed in parallel (1~16). Higher values are faster but consume more memory and disk IO.</sys:String>
  <sys:String x:Key="SettingsPageDesc">Global preferences such as theme, language and conversion performance. Changes apply immediately and are saved automatically.</sys:String>
  <sys:String x:Key="SettingsSavedHint">Saved automatically</sys:String>
  <sys:String x:Key="NotifyOnCompleteTitle">Completion Notification</sys:String>
  <sys:String x:Key="NotifyOnCompleteDesc">Play a sound when a batch conversion or strip finishes.</sys:String>
  <sys:String x:Key="AutoOpenOutputTitle">Open Output Folder After Convert</sys:String>
  <sys:String x:Key="AutoOpenOutputDesc">Automatically open the output folder in File Explorer when a task completes.</sys:String>
  <sys:String x:Key="AutoCleanTempTitle">Auto-clean Temporary Files</sys:String>
  <sys:String x:Key="AutoCleanTempDesc">Clean up temporary files generated during conversion on exit to reclaim disk space.</sys:String>

  <!-- About Page (inside Settings Dialog) -->
  <sys:String x:Key="SettingsTabTitle">Preferences</sys:String>
  <sys:String x:Key="AboutTabTitle">About</sys:String>
  <sys:String x:Key="AboutVersionLabel">Version</sys:String>
  <sys:String x:Key="AboutAuthorLabel">Author &amp; Maintainer</sys:String>
  <sys:String x:Key="AboutAuthorHomeBtn">Profile</sys:String>
  <sys:String x:Key="AboutSponsorTitle">Support the Project</sys:String>
  <sys:String x:Key="AboutSponsorDesc">If this project helps you, you can scan the code to support its development.</sys:String>
  <sys:String x:Key="AboutRepoBtn">Repository</sys:String>
  <sys:String x:Key="AboutIssuesBtn">Report Issue</sys:String>
  <sys:String x:Key="AboutReleasesBtn">Releases</sys:String>
  <sys:String x:Key="AboutLicenseTitle">License</sys:String>
  <sys:String x:Key="AboutLicenseDesc">Released under the MIT License: anyone may freely use, copy, modify, merge, publish, distribute and sell this software, provided the copyright and permission notice are retained. The software is provided "as is", without warranty of any kind.</sys:String>
  <sys:String x:Key="AboutViewLicenseBtn">View Full License</sys:String>
  <sys:String x:Key="AboutCopyrightLine">Copyright (c) 2024-2026 Kinsey.Qiu. All rights reserved.</sys:String>
  <sys:String x:Key="AboutContributorsTitle">Contributors</sys:String>
  <sys:String x:Key="AboutContributorsHint">Thanks to everyone involved — pull requests are always welcome.</sys:String>
  <sys:String x:Key="AboutCreditsRuntimeTitle">Runtime Engines &amp; Libraries</sys:String>
  <sys:String x:Key="AboutCreditsRuntimeDesc">ExifTool and FFmpeg ship as external executables; the Engines page detects them and can download them on first run.</sys:String>
  <sys:String x:Key="AboutCreditsBuildTitle">Frameworks &amp; Specifications</sys:String>
  <sys:String x:Key="CreditContributorAuthorDesc">Project author and primary maintainer</sys:String>
  <sys:String x:Key="CreditExifToolDesc">Industry-standard metadata read/write engine</sys:String>
  <sys:String x:Key="CreditFfmpegDesc">Lossless video stream copy and demuxing</sys:String>
  <sys:String x:Key="CreditLibheifDesc">HEIC / HEIF codec (heif-enc is built on it)</sys:String>
  <sys:String x:Key="CreditMagickDesc">High-performance .NET image decoding and thumbnails</sys:String>
  <sys:String x:Key="CreditDotNetDesc">Cross-platform runtime and Native AOT toolchain</sys:String>
  <sys:String x:Key="CreditAvaloniaDesc">Cross-platform XAML desktop UI framework</sys:String>
  <sys:String x:Key="CreditToolkitDesc">MVVM source generators and messaging infrastructure</sys:String>
  <sys:String x:Key="CreditFluentIconsDesc">Fluent Design vector icon library</sys:String>
  <sys:String x:Key="CreditMotionPhotoSpecDesc">Official Android Motion Photo container specification</sys:String>

  <!-- Dynamic Units & Labels -->
  <sys:String x:Key="UnitLivePhotos">Live Photos</sys:String>
  <sys:String x:Key="CurrentFileLabel">Current file:</sys:String>
  <sys:String x:Key="PingLatencyLabel">Latency:</sys:String>
  <sys:String x:Key="SelectAlbumFolderBtn">Select Folder</sys:String>

  <!-- ============================================================= -->
  <!-- Task reports and strip page status -->
  <!-- ============================================================= -->
  <sys:String x:Key="ReportCanceledSuffix" xml:space="preserve"> (canceled)</sys:String>
  <sys:String x:Key="ReportAvgSpeedFormat">{0:F2}s / item</sys:String>
  <sys:String x:Key="SplitTargetApple">Apple Live Photo</sys:String>
  <sys:String x:Key="SplitTargetExtract">Cover &amp; Video</sys:String>
  <sys:String x:Key="MergeSuccessDesc">Successfully merged into a Live Photo</sys:String>
  <sys:String x:Key="SplitSuccessDescFormat">Successfully split into {0}</sys:String>

  <!-- QuickLook Extended Playback States -->
  <sys:String x:Key="QuickLookLoading">Loading live...</sys:String>
  <sys:String x:Key="QuickLookPlaying">Playing live</sys:String>
  <sys:String x:Key="QuickLookStatic">Static Photo</sys:String>
  <sys:String x:Key="QuickLookLoop">Loop Playback</sys:String>
  <sys:String x:Key="QuickLookPaused">Live Paused</sys:String>

  <!-- Live playback failures -->
  <sys:String x:Key="PlaybackErrorFfmpegMissing">FFmpeg was not found, so the live video cannot play.</sys:String>
  <sys:String x:Key="PlaybackErrorSourceMissing">The video file no longer exists.</sys:String>
  <sys:String x:Key="PlaybackErrorNoVideoStream">The file has no playable video stream.</sys:String>
  <sys:String x:Key="PlaybackErrorHdrToneMap">This is an HDR video and the current FFmpeg lacks the zscale / tonemap filters needed to show it correctly. Switch to an FFmpeg build with libzimg on the Engines page.</sys:String>
  <sys:String x:Key="PlaybackErrorDecodeFailed">The video could not be decoded.</sys:String>

