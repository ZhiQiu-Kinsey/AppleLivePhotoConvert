  <sys:String x:Key="KeepSubfoldersTip">Preserve subfolder hierarchy (prevent name collision)</sys:String>
  <sys:String x:Key="ConvertRunningPrefix">Packaging micro-video and metadata: </sys:String>
  <sys:String x:Key="CancelTaskBtn">Cancel Task</sys:String>

  <!-- Storage Strip -->
  <sys:String x:Key="NoAlbumOrPhotoSelected">No album or photo selected</sys:String>
  <sys:String x:Key="StripBannerTitle">Storage Optimization Studio</sys:String>
  <sys:String x:Key="StripBannerDesc">Strip redundant micro-videos from live photos while keeping photos intact. Reclaims 70%~90% space.</sys:String>
  <sys:String x:Key="StripStagePreview">1. Analysis &amp; Comparison</sys:String>
  <sys:String x:Key="StripStageRunning">2. Stripping in Progress</sys:String>
  <sys:String x:Key="StripStageCompleted">3. Optimization Results</sys:String>
  <sys:String x:Key="CurtainCompareTitle">Quality Sandbox (Before / After Overlay)</sys:String>
  <sys:String x:Key="CurtainCompareDesc">Drag divider to compare pixel details between original and stripped HEIC:</sys:String>
  <sys:String x:Key="InPlaceStripTitle">In-Place Overwrite (Destructive)</sys:String>
  <sys:String x:Key="InPlaceStripDesc">Overwrites sources in-place; disable to export safely</sys:String>
  <sys:String x:Key="SafeExportDirTitle">Safe Export Directory (Keeps video copies):</sys:String>
  <sys:String x:Key="SpaceEstimateTitle">Estimated Space Savings</sys:String>
  <sys:String x:Key="OriginalSizeLabel">Original Album Size:</sys:String>
  <sys:String x:Key="StrippedSizeLabel">Estimated Stripped Size:</sys:String>
  <sys:String x:Key="SavedSizeLabel">Estimated Saved Space:</sys:String>
  <sys:String x:Key="StartStripBtn">Start Storage Optimization</sys:String>
  <sys:String x:Key="StripRunningTitle">Stripping micro-videos and transcoding to HEIC...</sys:String>
  <sys:String x:Key="PauseBtn">Pause</sys:String>
  <sys:String x:Key="AbortBtn">Abort Task</sys:String>
  <sys:String x:Key="CelebrationTitle">Optimization Successfully Complete!</sys:String>
  <sys:String x:Key="CelebrationDesc">Successfully recovered substantial disk space while preserving full photo quality.</sys:String>
  <sys:String x:Key="OpenOutputDirBtn">Open Output Folder</sys:String>
  <sys:String x:Key="ContinueStripBtn">Optimize More Albums</sys:String>

  <!-- Engines -->
  <sys:String x:Key="ToolsTitle">Core Engine Management</sys:String>
  <sys:String x:Key="ToolsDesc">Manage conversion tools: ExifTool, FFmpeg, and heif-enc.</sys:String>
  <sys:String x:Key="RescanToolsBtn">Rescan Engines</sys:String>
  <sys:String x:Key="MirrorTitle">GitHub Download Mirror</sys:String>
  <sys:String x:Key="MirrorDesc">Select acceleration proxy or enter custom mirror endpoint</sys:String>
  <sys:String x:Key="AutoDownloadLabel">Auto-download when missing</sys:String>
  <sys:String x:Key="TestPingBtn">Test Connectivity</sys:String>

  <!-- Reports -->
  <sys:String x:Key="ReportTitle">Execution Summary Report</sys:String>
  <sys:String x:Key="SkippedTitle">Skipped and Pending Details</sys:String>
  <sys:String x:Key="ExportLogBtn">Export Error Log</sys:String>
  <sys:String x:Key="ForceRetryBtn">Force Retry Single Item</sys:String>

  <!-- Dialogs -->
  <sys:String x:Key="DeleteDialogTitle">Alert: Permanent Source Deletion!</sys:String>
  <sys:String x:Key="DeleteDialogDesc">This action is irreversible! Files will be permanently deleted.</sys:String>
  <sys:String x:Key="DeleteDialogInputLabel">Type uppercase DELETE to unlock:</sys:String>
  <sys:String x:Key="DeleteDialogCancel">Cancel, Use Recycle Bin</sys:String>
  <sys:String x:Key="DeleteDialogConfirm">Confirm Permanent Deletion</sys:String>

  <sys:String x:Key="LowDiskDialogTitle">Low Disk Space Alert (ENOSPC)</sys:String>
  <sys:String x:Key="LowDiskDialogDesc">Target drive has insufficient space for safe conversion</sys:String>
  <sys:String x:Key="LowDiskDialogDismiss">Understood</sys:String>

  <sys:String x:Key="BackupDialogTitle">High-Risk Confirmation: In-Place Overwrite</sys:String>
  <sys:String x:Key="BackupDialogDesc">Enabling this will permanently strip embedded video streams!</sys:String>
  <sys:String x:Key="BackupDialogCancel">Cancel, Use Safe Export</sys:String>
  <sys:String x:Key="BackupDialogConfirm">I Understand the Risk, Enable Overwrite</sys:String>

  <sys:String x:Key="ArbitrateDialogTitle">Dual-Frame Verification (Time Gap Exceeded)</sys:String>
  <sys:String x:Key="ArbitrateDialogDesc">Compare photo and video first frame to verify shutter moment</sys:String>
  <sys:String x:Key="ArbitrateReject">Not Live Pair (Split Separately)</sys:String>
  <sys:String x:Key="ArbitrateConfirm">Confirm Live Pair (Add to Whitelist)</sys:String>

