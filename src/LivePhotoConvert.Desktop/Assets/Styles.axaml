<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ic="using:FluentIcons.Avalonia">

  <!--
    语义化主题调色板（R1 主题根治）。
    所有颜色均通过 ThemeDictionaries 按 Light/Dark 变体提供，
    视图层一律使用 DynamicResource 引用语义画刷，实现运行时热切换。
  -->
  <Styles.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>

        <!-- ========== Light ========== -->
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="CanvasBrush" Color="#F8FAFC" />
          <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
          <SolidColorBrush x:Key="HoverBrush" Color="#F1F5F9" />
          <SolidColorBrush x:Key="LineBrush" Color="#E2E8F0" />
          <SolidColorBrush x:Key="LineStrongBrush" Color="#CBD5E1" />

          <SolidColorBrush x:Key="TextPrimaryBrush" Color="#0F172A" />
          <SolidColorBrush x:Key="TextSecondaryBrush" Color="#334155" />
          <SolidColorBrush x:Key="TextTertiaryBrush" Color="#475569" />
          <SolidColorBrush x:Key="TextMutedBrush" Color="#94A3B8" />

          <SolidColorBrush x:Key="AccentBrush" Color="#2563EB" />
          <SolidColorBrush x:Key="AccentPressedBrush" Color="#1D4ED8" />
          <SolidColorBrush x:Key="AccentTextBrush" Color="#1D4ED8" />
          <SolidColorBrush x:Key="AccentSoftBrush" Color="#EFF6FF" />
          <SolidColorBrush x:Key="AccentBorderBrush" Color="#BFDBFE" />
          <SolidColorBrush x:Key="AccentBrightBrush" Color="#3B82F6" />
          <Color x:Key="AccentGradientStartColor">#2563EB</Color>
          <Color x:Key="AccentGradientEndColor">#4F46E5</Color>
          <SolidColorBrush x:Key="VioletBrush" Color="#7C3AED" />

          <SolidColorBrush x:Key="SuccessBrush" Color="#059669" />
          <SolidColorBrush x:Key="SuccessSoftBrush" Color="#ECFDF5" />
          <SolidColorBrush x:Key="SuccessBorderBrush" Color="#A7F3D0" />

          <SolidColorBrush x:Key="WarningBrush" Color="#D97706" />
          <SolidColorBrush x:Key="WarningSoftBrush" Color="#FFFBEB" />
          <SolidColorBrush x:Key="WarningBorderBrush" Color="#FDE68A" />

          <SolidColorBrush x:Key="DangerBrush" Color="#DC2626" />
          <SolidColorBrush x:Key="DangerPressedBrush" Color="#B91C1C" />
          <SolidColorBrush x:Key="DangerSoftBrush" Color="#FEF2F2" />
          <SolidColorBrush x:Key="DangerBorderBrush" Color="#FECACA" />

          <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFF" />

          <SolidColorBrush x:Key="SuccessTextBrush" Color="#065F46" />
          <SolidColorBrush x:Key="WarningTextBrush" Color="#92400E" />
          <SolidColorBrush x:Key="DangerTextBrush" Color="#7F1D1D" />

          <!-- 弹窗遮罩与深色媒体画布（画布在两种主题下都保持深色以衬托照片） -->
          <SolidColorBrush x:Key="OverlayBrush" Color="#990F172A" />
          <SolidColorBrush x:Key="MediaCanvasBrush" Color="#0A0E1A" />
          <SolidColorBrush x:Key="MediaControlBrush" Color="#80000000" />
          <SolidColorBrush x:Key="MediaControlBorderBrush" Color="#40FFFFFF" />
          <SolidColorBrush x:Key="MediaBadgeBrush" Color="#99000000" />
          <SolidColorBrush x:Key="OnMediaBrush" Color="#FFFFFF" />
          <SolidColorBrush x:Key="MediaAccentBrush" Color="#38BDF8" />
          <SolidColorBrush x:Key="MediaWarningBrush" Color="#FBBF24" />
        </ResourceDictionary>

        <!-- ========== Dark ========== -->
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="CanvasBrush" Color="#0F172A" />
          <SolidColorBrush x:Key="SurfaceBrush" Color="#1E293B" />
          <SolidColorBrush x:Key="HoverBrush" Color="#334155" />
          <SolidColorBrush x:Key="LineBrush" Color="#334155" />
          <SolidColorBrush x:Key="LineStrongBrush" Color="#475569" />

          <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F1F5F9" />
          <SolidColorBrush x:Key="TextSecondaryBrush" Color="#CBD5E1" />
          <SolidColorBrush x:Key="TextTertiaryBrush" Color="#94A3B8" />
          <SolidColorBrush x:Key="TextMutedBrush" Color="#64748B" />

          <SolidColorBrush x:Key="AccentBrush" Color="#3B82F6" />
          <SolidColorBrush x:Key="AccentPressedBrush" Color="#2563EB" />
          <SolidColorBrush x:Key="AccentTextBrush" Color="#93C5FD" />
          <SolidColorBrush x:Key="AccentSoftBrush" Color="#1E3A8A" />
          <SolidColorBrush x:Key="AccentBorderBrush" Color="#1E40AF" />
          <SolidColorBrush x:Key="AccentBrightBrush" Color="#60A5FA" />
          <Color x:Key="AccentGradientStartColor">#3B82F6</Color>
          <Color x:Key="AccentGradientEndColor">#6366F1</Color>
          <SolidColorBrush x:Key="VioletBrush" Color="#8B5CF6" />

          <SolidColorBrush x:Key="SuccessBrush" Color="#10B981" />
          <SolidColorBrush x:Key="SuccessSoftBrush" Color="#064E3B" />
          <SolidColorBrush x:Key="SuccessBorderBrush" Color="#065F46" />

          <SolidColorBrush x:Key="WarningBrush" Color="#F59E0B" />
          <SolidColorBrush x:Key="WarningSoftBrush" Color="#78350F" />
          <SolidColorBrush x:Key="WarningBorderBrush" Color="#92400E" />

          <SolidColorBrush x:Key="DangerBrush" Color="#EF4444" />
          <SolidColorBrush x:Key="DangerPressedBrush" Color="#DC2626" />
          <SolidColorBrush x:Key="DangerSoftBrush" Color="#7F1D1D" />
          <SolidColorBrush x:Key="DangerBorderBrush" Color="#991B1B" />

          <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFF" />

          <SolidColorBrush x:Key="SuccessTextBrush" Color="#6EE7B7" />
          <SolidColorBrush x:Key="WarningTextBrush" Color="#FCD34D" />
          <SolidColorBrush x:Key="DangerTextBrush" Color="#FCA5A5" />

          <SolidColorBrush x:Key="OverlayBrush" Color="#CC020617" />
          <SolidColorBrush x:Key="MediaCanvasBrush" Color="#0A0E1A" />
          <SolidColorBrush x:Key="MediaControlBrush" Color="#80000000" />
          <SolidColorBrush x:Key="MediaControlBorderBrush" Color="#40FFFFFF" />
          <SolidColorBrush x:Key="MediaBadgeBrush" Color="#99000000" />
          <SolidColorBrush x:Key="OnMediaBrush" Color="#FFFFFF" />
          <SolidColorBrush x:Key="MediaAccentBrush" Color="#38BDF8" />
          <SolidColorBrush x:Key="MediaWarningBrush" Color="#FBBF24" />
        </ResourceDictionary>

      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </Styles.Resources>

  <!-- 全局弹出面板 FlyoutPresenter 规范：消除默认双重内边距与双层嵌套边框 -->
  <Style Selector="FlyoutPresenter">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="6" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
    <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
  </Style>

  <!-- 32px Compact Toolbar Button Style -->
  <Style Selector="Button.toolbar-btn">
    <Setter Property="Height" Value="32" />
    <Setter Property="Padding" Value="8,0" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>

  <Style Selector="Button.toolbar-btn:pointerover">
    <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LineStrongBrush}" />
  </Style>

  <Style Selector="Button.toolbar-btn.active">
    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrightBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
  </Style>

  <!-- 作者栏的赞赏入口：轻量呼吸动画吸引注意，不干扰其他操作。 -->
  <Style Selector="Button.sponsor-btn">
    <Setter Property="Height" Value="28" />
    <Setter Property="Padding" Value="10,0" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Cursor" Value="Hand" />
    <Style.Animations>
      <Animation Duration="0:0:1.8" IterationCount="INFINITE">
        <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0.82" /></KeyFrame>
        <KeyFrame Cue="50%"><Setter Property="Opacity" Value="1" /></KeyFrame>
        <KeyFrame Cue="100%"><Setter Property="Opacity" Value="0.82" /></KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>

  <Style Selector="Button.sponsor-btn:pointerover">
    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
  </Style>

  <!-- 弹窗右上角的关闭按钮 -->
  <Style Selector="Button.dialog-close-btn">
    <Setter Property="Width" Value="28" />
    <Setter Property="Height" Value="28" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="7" />
    <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>

  <Style Selector="Button.dialog-close-btn:pointerover">
    <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
  </Style>

  <!-- 二维码必须白底才能被扫描，不随主题变化 -->
  <Style Selector="Border.qr-frame">
    <Setter Property="Background" Value="#FFFFFF" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="8" />
  </Style>

  <!-- Primary Action Button -->
  <Style Selector="Button.primary-btn">
    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Padding" Value="16,10" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>

  <Style Selector="Button.primary-btn:pointerover">
    <Setter Property="Background" Value="{DynamicResource AccentPressedBrush}" />
  </Style>

  <!-- Danger Button -->
  <Style Selector="Button.danger-btn">
    <Setter Property="Background" Value="{DynamicResource DangerBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Padding" Value="16,10" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>

  <Style Selector="Button.danger-btn:pointerover">
    <Setter Property="Background" Value="{DynamicResource DangerPressedBrush}" />
  </Style>

  <!-- Nav Item Button Style -->
  <Style Selector="Button.nav-btn">
    <Setter Property="Height" Value="40" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="12,8" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>

  <Style Selector="Button.nav-btn:pointerover">
    <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
  </Style>

  <Style Selector="Button.nav-btn.selected">
    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>

  <!-- 现代化全局 ComboBox 风格系统 -->
  <Style Selector="ComboBox">
    <Setter Property="MinHeight" Value="34" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="10,6" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="MaxDropDownHeight" Value="260" />
  </Style>

  <Style Selector="ComboBox:pointerover">
    <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LineStrongBrush}" />
  </Style>

  <Style Selector="ComboBox:focus /template/ Border#PopupBorder">
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
  </Style>

  <!-- ComboBox 下拉弹出面板与子项样式规范 -->
  <Style Selector="ComboBoxItem">
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="Padding" Value="10,6" />
    <Setter Property="Margin" Value="4,2" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>

  <Style Selector="ComboBoxItem:pointerover">
    <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
  </Style>

  <Style Selector="ComboBoxItem:selected">
    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <!-- 下拉弹层使用独立的紧凑面板，避免默认主题的灰色大块和双重边框。 -->
  <Style Selector="ComboBox /template/ Border#PopupBorder">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LineStrongBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="4" />
    <Setter Property="BoxShadow" Value="0 8 24 0 #26000000" />
  </Style>

  <!-- 下拉选项中的危险项（例如永久删除原片） -->
  <Style Selector="TextBlock.danger-option">
    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
  </Style>

  <Style Selector="ComboBox.engine-select">
    <Setter Property="MinHeight" Value="38" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="12,7" />
    <Setter Property="FontSize" Value="12" />
  </Style>

  <Style Selector="Border.engine-card">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="Padding" Value="14" />
    <Setter Property="BoxShadow" Value="0 3 12 0 #10000000" />
  </Style>

  <Style Selector="Border.engine-path">
    <Setter Property="Background" Value="{DynamicResource CanvasBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="9,7" />
  </Style>

  <!-- 依赖卡片的次要按钮（自定义路径、取消）：与安装按钮同高同圆角，只是不填充强调色 -->
  <Style Selector="Button.engine-secondary-btn">
    <Setter Property="Height" Value="36" />
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="CornerRadius" Value="9" />
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>

  <Style Selector="Button.engine-secondary-btn:pointerover">
    <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LineStrongBrush}" />
  </Style>

  <!-- 页头下方的说明条：安装方式与安装位置 -->
  <Style Selector="Border.tools-note">
    <Setter Property="Background" Value="{DynamicResource CanvasBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="12,9" />
  </Style>

  <Style Selector="Border.tools-note.warning">
    <Setter Property="Background" Value="{DynamicResource WarningSoftBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource WarningBorderBrush}" />
  </Style>

  <Style Selector="Border.tools-note.warning TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource WarningTextBrush}" />
  </Style>

  <Style Selector="Border.tools-note.danger">
    <Setter Property="Background" Value="{DynamicResource DangerSoftBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource DangerBorderBrush}" />
  </Style>

  <Style Selector="Border.tools-note.danger TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource DangerTextBrush}" />
  </Style>

  <!-- 卡片内的一行提示（图标 + 可换行文字） -->
  <Style Selector="Grid.tool-hint > TextBlock">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="Margin" Value="6,0,0,0" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="Grid.tool-hint.warning > TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource WarningTextBrush}" />
  </Style>

  <Style Selector="Grid.tool-hint.warning ic|SymbolIcon">
    <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
  </Style>

  <Style Selector="Grid.tool-hint.accent > TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
  </Style>

  <Style Selector="Grid.tool-hint.accent ic|SymbolIcon">
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
  </Style>

  <!-- 能力徽章：支持为绿色，不支持为灰色 -->
  <Style Selector="Border.capability-badge">
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="7,3" />
    <Setter Property="Margin" Value="0,0,6,6" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
  </Style>

  <Style Selector="Border.capability-badge TextBlock">
    <Setter Property="FontSize" Value="10" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
  </Style>

  <Style Selector="Border.capability-badge ic|SymbolIcon">
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
  </Style>

  <Style Selector="Border.capability-badge.supported">
    <Setter Property="Background" Value="{DynamicResource SuccessSoftBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource SuccessBorderBrush}" />
  </Style>

  <Style Selector="Border.capability-badge.supported TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource SuccessTextBrush}" />
  </Style>

  <Style Selector="Border.capability-badge.supported ic|SymbolIcon">
    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
  </Style>

  <Style Selector="TextBlock.ping-result">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
  </Style>

  <Style Selector="TextBlock.ping-result.ok">
    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
  </Style>

  <Style Selector="Border.status-pill">
    <Setter Property="CornerRadius" Value="9" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="7,3" />
    <Setter Property="MaxWidth" Value="150" />
  </Style>

  <Style Selector="Border.status-pill.success">
    <Setter Property="Background" Value="{DynamicResource SuccessSoftBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource SuccessBorderBrush}" />
  </Style>

  <Style Selector="Border.status-pill.success TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
  </Style>

  <Style Selector="Border.status-pill.danger">
    <Setter Property="Background" Value="{DynamicResource DangerSoftBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource DangerBorderBrush}" />
  </Style>

  <Style Selector="Border.status-pill.danger TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
  </Style>

  <Style Selector="Border.status-pill.warning">
    <Setter Property="Background" Value="{DynamicResource WarningSoftBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource WarningBorderBrush}" />
  </Style>

  <Style Selector="Border.status-pill.warning TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource WarningTextBrush}" />
  </Style>

  <Style Selector="Border.status-pill.muted">
    <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
  </Style>

  <Style Selector="Border.status-pill.muted TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
  </Style>

  <Style Selector="Button.engine-install-btn">
    <Setter Property="Height" Value="36" />
    <Setter Property="CornerRadius" Value="9" />
    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>

  <Style Selector="Button.engine-install-btn:pointerover">
    <Setter Property="Background" Value="{DynamicResource AccentPressedBrush}" />
  </Style>

  <Style Selector="Button.engine-install-btn:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
  </Style>

  <!-- 精致胶囊分段控制器 (Segmented Control) 样式规范 -->
  <Style Selector="Border.segmented-group">
    <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="3" />
    <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>

  <Style Selector="Button.segmented-item">
    <Setter Property="Height" Value="28" />
    <Setter Property="Padding" Value="12,4" />
    <Setter Property="CornerRadius" Value="7" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>

  <!-- 设置页卡片：统一层级、内边距和图标容器，避免视图内重复堆叠视觉属性 -->
  <Style Selector="Border.settings-card">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="Padding" Value="16" />
    <Setter Property="BoxShadow" Value="0 2 8 0 #0D000000" />
  </Style>

  <Style Selector="Border.settings-icon-badge">
    <Setter Property="Width" Value="32" />
    <Setter Property="Height" Value="32" />
    <Setter Property="CornerRadius" Value="9" />
    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="HorizontalAlignment" Value="Left" />
  </Style>

  <Style Selector="TextBlock.settings-card-title">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="TextBlock.settings-card-caption">
    <Setter Property="FontSize" Value="10" />
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="Margin" Value="0,2,0,0" />
  </Style>

  <Style Selector="Border.about-hero">
    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="18" />
    <Setter Property="Padding" Value="24,22" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
  </Style>

  <!-- “关于”页鸣谢行按钮 (About Credit Row) -->
  <Style Selector="Button.credit-row">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="8,6" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>

  <Style Selector="Button.credit-row:pointerover">
    <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
  </Style>

  <!-- 胶囊内嵌操作按钮 (Capsule Inner Button) -->
  <Style Selector="Button.capsule-btn">
    <Setter Property="Height" Value="22" />
    <Setter Property="Padding" Value="6,0" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>

  <Style Selector="Button.capsule-btn:pointerover">
    <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LineStrongBrush}" />
  </Style>

  <Style Selector="Button.capsule-icon-btn">
    <Setter Property="Width" Value="22" />
    <Setter Property="Height" Value="22" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>

  <Style Selector="Button.capsule-icon-btn:pointerover">
    <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
  </Style>

  <Style Selector="Button.segmented-item:pointerover">
    <Setter Property="Background" Value="{DynamicResource LineBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
  </Style>

  <Style Selector="Button.segmented-item.active">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>

  <!-- 左下角微型分段按钮 (Mini Segmented Item) -->
  <Style Selector="Button.mini-segmented-btn">
    <Setter Property="Height" Value="26" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>

  <Style Selector="Button.mini-segmented-btn:pointerover">
    <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
  </Style>

  <Style Selector="Button.mini-segmented-btn.active">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>

  <!-- 窗口系统控制按钮 (最小化、最大化、关闭) 样式规范 -->
  <Style Selector="Button.caption-btn">
    <Setter Property="Width" Value="46" />
    <Setter Property="Height" Value="40" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>

  <Style Selector="Button.caption-btn:pointerover">
    <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
  </Style>

  <Style Selector="Button.caption-btn:pressed">
    <Setter Property="Background" Value="{DynamicResource LineStrongBrush}" />
  </Style>

  <!-- 窗口关闭按钮专用样式规范 (悬停 Windows 标准红底白字) -->
  <Style Selector="Button.caption-close-btn">
    <Setter Property="Width" Value="46" />
    <Setter Property="Height" Value="40" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>

  <Style Selector="Button.caption-close-btn:pointerover">
    <Setter Property="Background" Value="#E81123" />
    <Setter Property="Foreground" Value="#FFFFFF" />
  </Style>

  <Style Selector="Button.caption-close-btn:pointerover ic|SymbolIcon">
    <Setter Property="Foreground" Value="#FFFFFF" />
  </Style>

  <Style Selector="Button.caption-close-btn:pressed">
    <Setter Property="Background" Value="#C42B1C" />
    <Setter Property="Foreground" Value="#FFFFFF" />
  </Style>

  <Style Selector="Button.caption-close-btn:pressed ic|SymbolIcon">
    <Setter Property="Foreground" Value="#FFFFFF" />
  </Style>

  <!-- 弹窗卡片：遮罩由主窗口弹窗宿主统一提供，卡片只负责自身外观 -->
  <Style Selector="Border.dialog-card">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="24" />
    <Setter Property="Padding" Value="24" />
    <Setter Property="Margin" Value="16" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="BoxShadow" Value="0 20 40 0 #40000000" />
  </Style>

  <Style Selector="Border.dialog-icon-badge">
    <Setter Property="Width" Value="40" />
    <Setter Property="Height" Value="40" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="Border.dialog-icon-badge.warning">
    <Setter Property="Background" Value="{DynamicResource WarningSoftBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource WarningBorderBrush}" />
  </Style>

  <Style Selector="Border.dialog-icon-badge.danger">
    <Setter Property="Background" Value="{DynamicResource DangerSoftBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource DangerBorderBrush}" />
  </Style>

  <Style Selector="Border.dialog-icon-badge.info">
    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBorderBrush}" />
  </Style>

  <!-- 任务页：运行卡片、状态胶囊与历史列表 -->
  <Style Selector="Border.task-card">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="16" />
    <Setter Property="Padding" Value="18" />
    <Setter Property="BoxShadow" Value="0 2 8 0 #0D000000" />
  </Style>

  <Style Selector="Border.task-card.running">
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBorderBrush}" />
  </Style>

  <Style Selector="Border.task-chip">
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="8,2" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
  </Style>

  <Style Selector="Border.task-chip TextBlock">
    <Setter Property="FontSize" Value="10" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
  </Style>

  <Style Selector="Border.task-chip.accent">
    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBorderBrush}" />
  </Style>

  <Style Selector="Border.task-chip.accent TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
  </Style>

  <Style Selector="Border.task-chip.warning">
    <Setter Property="Background" Value="{DynamicResource WarningSoftBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource WarningBorderBrush}" />
  </Style>

  <Style Selector="Border.task-chip.warning TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource WarningTextBrush}" />
  </Style>

  <Style Selector="Border.task-chip.success">
    <Setter Property="Background" Value="{DynamicResource SuccessSoftBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource SuccessBorderBrush}" />
  </Style>

  <Style Selector="Border.task-chip.success TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource SuccessTextBrush}" />
  </Style>

  <Style Selector="Border.task-chip.danger">
    <Setter Property="Background" Value="{DynamicResource DangerSoftBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource DangerBorderBrush}" />
  </Style>

  <Style Selector="Border.task-chip.danger TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource DangerTextBrush}" />
  </Style>

  <Style Selector="ListBox.task-history">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
  </Style>

  <Style Selector="ListBox.task-history ListBoxItem">
    <Setter Property="Padding" Value="10,9" />
    <Setter Property="Margin" Value="0,0,0,4" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>

  <Style Selector="ListBox.task-history ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
  </Style>

  <Style Selector="ListBox.task-history ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
  </Style>

  <Style Selector="ListBox.task-history ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
  </Style>


  <!-- 左侧导航：计数 / 进度徽章与依赖状态点 -->
  <Style Selector="Border.nav-badge">
    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="6,2" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="Border.nav-badge TextBlock">
    <Setter Property="FontSize" Value="10" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="Border.status-dot">
    <Setter Property="Width" Value="6" />
    <Setter Property="Height" Value="6" />
    <Setter Property="CornerRadius" Value="3" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="Border.status-dot.large">
    <Setter Property="Width" Value="9" />
    <Setter Property="Height" Value="9" />
    <Setter Property="CornerRadius" Value="4.5" />
  </Style>

  <Style Selector="Border.status-dot.ok">
    <Setter Property="Background" Value="{DynamicResource SuccessBrush}" />
  </Style>

  <Style Selector="Border.status-dot.warn">
    <Setter Property="Background" Value="{DynamicResource WarningBrush}" />
  </Style>

  <Style Selector="Border.status-dot.bad">
    <Setter Property="Background" Value="{DynamicResource DangerBrush}" />
  </Style>

  <!-- 图库检查器 -->
  <Style Selector="Border.inspector">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
    <Setter Property="BorderThickness" Value="1,0,0,0" />
  </Style>

  <Style Selector="TextBlock.inspector-title">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
  </Style>

  <Style Selector="TextBlock.inspector-section-title">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
    <Setter Property="Margin" Value="0,4,0,0" />
  </Style>

  <Style Selector="Border.inspector-card">
    <Setter Property="Background" Value="{DynamicResource CanvasBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="12,10" />
  </Style>

  <Style Selector="Border.inspector-card.accent">
    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBorderBrush}" />
  </Style>

  <Style Selector="Border.inspector-card.danger">
    <Setter Property="Background" Value="{DynamicResource DangerSoftBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource DangerBorderBrush}" />
  </Style>

  <!-- 动作选择：两行两列的图标磁贴 -->
  <Style Selector="Button.action-tile">
    <Setter Property="Height" Value="40" />
    <Setter Property="Padding" Value="8,0" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Background" Value="{DynamicResource CanvasBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>

  <Style Selector="Button.action-tile:pointerover">
    <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LineStrongBrush}" />
  </Style>

  <Style Selector="Button.action-tile.active">
    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrightBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>

  <Style Selector="Button.action-tile ic|SymbolIcon">
    <Setter Property="FontSize" Value="16" />
    <Setter Property="Foreground" Value="{Binding $parent[Button].Foreground}" />
  </Style>

  <!-- 选项行：文字列占满剩余宽度并换行，开关列按内容取宽，任何语言下都不会互相遮挡 -->
  <Style Selector="Grid.option-row > StackPanel">
    <Setter Property="Spacing" Value="2" />
    <Setter Property="Margin" Value="0,0,12,0" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="TextBlock.option-title">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style Selector="TextBlock.option-desc">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="LineHeight" Value="16" />
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style Selector="ToggleSwitch.row-switch">
    <Setter Property="OnContent" Value="" />
    <Setter Property="OffContent" Value="" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="0" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- Fluent 滑块上下留有刻度空间，检查器里不显示刻度，收紧以免与说明文字脱节 -->
  <Style Selector="Slider.inspector-slider">
    <Setter Property="Margin" Value="0,-8,0,-10" />
  </Style>

  <!-- 目录路径框：路径 + 更改 + 打开 -->
  <Style Selector="Border.path-box">
    <Setter Property="Height" Value="32" />
    <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="8,0,4,0" />
  </Style>

  <!-- 设置页列表行：图标、文字、控件三列 -->
  <Style Selector="Grid.settings-row">
    <Setter Property="MinHeight" Value="44" />
  </Style>

  <Style Selector="Grid.settings-row > StackPanel">
    <Setter Property="Spacing" Value="2" />
    <Setter Property="Margin" Value="12,0,16,0" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="Border.settings-divider">
    <Setter Property="Height" Value="1" />
    <Setter Property="Background" Value="{DynamicResource LineBrush}" />
    <Setter Property="Margin" Value="0,12" />
  </Style>

</Styles>
